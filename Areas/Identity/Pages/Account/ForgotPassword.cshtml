@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#121014] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8 flex justify-center">
        <div class="w-full max-w-md bg-gray-50 dark:bg-[#1C191F] p-8 md:p-12 border border-gray-100 dark:border-[#2A262C]">
            <h1 class="text-3xl font-grotesk font-bold tracking-tighter mb-4 text-center uppercase">
                Reset via WhatsApp
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 text-center mb-8 leading-relaxed">
                There’s one admin on this site. Message the lab WhatsApp and we’ll set a new password. No email.
            </p>
            <a href="@PurpleBeanContact.WhatsAppResetUrl" class="block w-full bg-black text-white dark:bg-[#D6D0C8] dark:text-black py-4 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8] text-center">
                WhatsApp @PurpleBeanContact.WhatsAppDisplay
            </a>
            <p class="mt-8 text-center">
                <a asp-page="./Login" class="text-xs font-mono-jb uppercase tracking-widest text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">Back to log in</a>
            </p>
        </div>
    </div>
</div>
