@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Set a new password";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#121014] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8 flex justify-center">
        <div class="w-full max-w-md bg-gray-50 dark:bg-[#1C191F] p-8 md:p-12 border border-gray-100 dark:border-[#2A262C]">
            <h1 class="text-3xl font-grotesk font-bold tracking-tighter mb-8 text-center uppercase">
                New password
            </h1>
            <form method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4 text-xs font-mono-jb uppercase tracking-widest" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                <div>
                    <label asp-for="Input.Email" class="block text-xs font-mono-jb uppercase tracking-widest text-gray-500 dark:text-gray-300 mb-2">Email</label>
                    <input asp-for="Input.Email" class="w-full bg-white dark:bg-[#1A2315] border border-gray-200 dark:border-[#2A262C] p-3 text-sm font-light focus:outline-none focus:border-black dark:focus:border-[#D6D0C8] transition-colors" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-red-500 text-xs font-mono-jb mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="block text-xs font-mono-jb uppercase tracking-widest text-gray-500 dark:text-gray-300 mb-2">New password</label>
                    <input asp-for="Input.Password" class="w-full bg-white dark:bg-[#1A2315] border border-gray-200 dark:border-[#2A262C] p-3 text-sm font-light focus:outline-none focus:border-black dark:focus:border-[#D6D0C8] transition-colors" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-red-500 text-xs font-mono-jb mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-xs font-mono-jb uppercase tracking-widest text-gray-500 dark:text-gray-300 mb-2">Confirm</label>
                    <input asp-for="Input.ConfirmPassword" class="w-full bg-white dark:bg-[#1A2315] border border-gray-200 dark:border-[#2A262C] p-3 text-sm font-light focus:outline-none focus:border-black dark:focus:border-[#D6D0C8] transition-colors" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs font-mono-jb mt-1 block"></span>
                </div>
                <button type="submit" class="w-full bg-black text-white dark:bg-[#D6D0C8] dark:text-black py-4 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8]">
                    Save password
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
