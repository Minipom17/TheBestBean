@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password updated";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#121014] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8 flex justify-center">
        <div class="w-full max-w-md bg-gray-50 dark:bg-[#1C191F] p-8 md:p-12 border border-gray-100 dark:border-[#2A262C]">
            <h1 class="text-3xl font-grotesk font-bold tracking-tighter mb-4 text-center uppercase">
                Password saved
            </h1>
            <p class="text-sm text-gray-600 dark:text-gray-300 text-center leading-relaxed mb-8">
                You can log in with the new password.
            </p>
            <a asp-page="./Login" class="block w-full bg-black text-white dark:bg-[#D6D0C8] dark:text-black py-4 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8] text-center">
                Log in
            </a>
        </div>
    </div>
</div>
