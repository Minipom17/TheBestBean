@page
@model TheBestBean.Pages.Admin.Blog.IndexModel
@{
    ViewData["Title"] = "Admin - Blog Posts";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-3xl font-mono-jb uppercase font-bold text-v-black dark:text-[#D6D0C8]">Blog Posts</h1>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">A list of all weekly blog articles including their title, status, and creation date.</p>
        </div>
        <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
            <a asp-page="./Edit" class="inline-flex items-center justify-center rounded-md border border-transparent bg-v-red px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-v-red/90 focus:outline-none sm:w-auto font-mono-jb uppercase tracking-widest">Add post</a>
        </div>
    </div>
    
    <div class="mt-8 flex flex-col">
        <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-600 bg-white dark:bg-[#121014]">
                        <thead class="bg-gray-50 dark:bg-v-black">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-[#D6D0C8] sm:pl-6">Title</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-[#D6D0C8]">Status</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-[#D6D0C8]">Date</th>
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                    <span class="sr-only">Edit</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-600">
                            @foreach (var item in Model.BlogPosts)
                            {
                                <tr>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-[#D6D0C8] sm:pl-6">
                                        @item.Title
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-300">
                                        @if (item.IsPublished)
                                        {
                                            <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Published</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Draft</span>
                                        }
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-300">
                                        @item.CreatedAt.ToShortDateString()
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="text-v-red hover:text-v-red/80 font-mono-jb uppercase">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
