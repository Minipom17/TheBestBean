@page
@model TheBestBean.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#3C4A33] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8">
        <h1 class="text-4xl md:text-6xl font-grotesk font-bold tracking-tighter mb-12 uppercase">
            @ViewData["Title"]
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Coffee Beans -->
            <div class="bg-gray-50 dark:bg-[#2F3A28] border border-gray-100 dark:border-[#4F6044] p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">Coffee Beans</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-8">
                        Manage your coffee catalog. Add new beans, edit existing ones, upload images, and update inventory details.
                    </p>
                </div>
                <a asp-page="/Admin/Coffees/Index" class="inline-block bg-black text-white dark:bg-[#FAF3DD] dark:text-black px-8 py-4 font-mono-jb font-bold text-xs uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#FAF3DD] text-decoration-none">
                    Manage Coffees
                </a>
            </div>

            <!-- Experiences -->
            <div class="bg-gray-50 dark:bg-[#2F3A28] border border-gray-100 dark:border-[#4F6044] p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">Experiences</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-8">
                        Manage the Origin Expeditions and Urban Workshops. Add new experiences, edit pricing, dates, and locations.
                    </p>
                </div>
                <a asp-page="/Admin/Experiences/Index" class="inline-block bg-black text-white dark:bg-[#FAF3DD] dark:text-black px-8 py-4 font-mono-jb font-bold text-xs uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#FAF3DD] text-decoration-none">
                    Manage Experiences
                </a>
            </div>

            <!-- QR Code Generator -->
            <div class="bg-gray-50 dark:bg-[#2F3A28] border border-gray-100 dark:border-[#4F6044] p-8 flex flex-col justify-between md:col-span-2 lg:col-span-1">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">QR Generator</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-6">
                        Generate high-resolution QR codes for packaging stickers. 
                    </p>
                    
                    <div class="flex flex-col gap-4 mb-6">
                        <label class="text-xs font-mono-jb uppercase font-bold text-gray-500">Target URL</label>
                        <input type="text" id="qr-url-input" value="https://purplebean.coffee/GreenBeans" class="w-full px-4 py-3 bg-white dark:bg-[#3C4A33] border border-gray-300 dark:border-[#4F6044] rounded text-sm font-mono-jb text-black dark:text-[#FAF3DD] focus:outline-none focus:border-v-red transition-colors" />
                        
                        <div class="flex gap-2">
                            <button id="qr-generate-btn" class="flex-1 bg-black text-white dark:bg-[#FAF3DD] dark:text-black px-4 py-3 font-mono-jb font-bold text-[10px] uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#FAF3DD] cursor-pointer">
                                Generate
                            </button>
                            <button id="qr-download-btn" class="flex-1 bg-white text-black dark:bg-[#2F3A28] dark:text-[#FAF3DD] px-4 py-3 font-mono-jb font-bold text-[10px] uppercase tracking-widest text-center hover:bg-gray-100 dark:hover:bg-[#4F6044] transition-colors border border-black dark:border-[#FAF3DD] cursor-pointer disabled:opacity-50" disabled>
                                Download PNG
                            </button>
                        </div>
                    </div>
                </div>
                <div class="flex justify-center items-center p-6 bg-white dark:bg-[#3C4A33] border border-dashed border-gray-300 dark:border-[#4F6044] min-h-[250px]" id="qr-container">
                    <span class="text-gray-400 text-xs font-mono-jb uppercase tracking-widest" id="qr-placeholder">QR Code Preview</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const generateBtn = document.getElementById('qr-generate-btn');
            const downloadBtn = document.getElementById('qr-download-btn');
            const urlInput = document.getElementById('qr-url-input');
            const container = document.getElementById('qr-container');
            const placeholder = document.getElementById('qr-placeholder');
            
            let currentCanvas = null;

            generateBtn.addEventListener('click', function() {
                const url = urlInput.value.trim();
                if (!url) return;
                
                // Clear container
                if (placeholder) placeholder.style.display = 'none';
                container.innerHTML = '';
                
                // Generate QR on a hidden high-res canvas (1000px wide for printing)
                const tempCanvas = document.createElement('canvas');
                
                QRCode.toCanvas(tempCanvas, url, {
                    width: 1000,
                    margin: 2,
                    color: {
                        dark: "#000000",
                        light: "#ffffff"
                    }
                }, function (error) {
                    if (error) console.error(error);
                    
                    // Create a visible low-res canvas for preview
                    currentCanvas = document.createElement('canvas');
                    currentCanvas.className = "w-full max-w-[200px] h-auto rounded-lg shadow-sm";
                    
                    QRCode.toCanvas(currentCanvas, url, {
                        width: 250,
                        margin: 1,
                        color: {
                            dark: "#000000",
                            light: "#ffffff"
                        }
                    }, function (err) {
                        if (err) console.error(err);
                        container.appendChild(currentCanvas);
                        
                        // Enable download button and attach high-res data
                        downloadBtn.disabled = false;
                        downloadBtn.dataset.highResUrl = tempCanvas.toDataURL("image/png");
                    });
                });
            });

            downloadBtn.addEventListener('click', function() {
                const dataUrl = this.dataset.highResUrl;
                if (!dataUrl) return;
                
                const link = document.createElement('a');
                link.download = 'purplebean_qr_code.png';
                link.href = dataUrl;
                link.click();
            });
        });
    </script>
}
