@page
@model TheBestBean.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#121014] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8">
        <h1 class="text-4xl md:text-6xl font-grotesk font-bold tracking-tighter mb-12 uppercase">
            @ViewData["Title"]
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Coffee Beans -->
            <div class="bg-gray-50 dark:bg-[#1C191F] border border-gray-100 dark:border-[#2A262C] p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">Coffee Beans</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-8">
                        Manage your coffee catalog. Add new beans, edit existing ones, upload images, and update inventory details.
                    </p>
                </div>
                <a asp-page="/Admin/Coffees/Index" class="inline-block bg-black text-white dark:bg-[#D6D0C8] dark:text-black px-8 py-4 font-mono-jb font-bold text-xs uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8] text-decoration-none">
                    Manage Coffees
                </a>
            </div>

            <!-- Experiences -->
            <div class="bg-gray-50 dark:bg-[#1C191F] border border-gray-100 dark:border-[#2A262C] p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">Experiences</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-8">
                        Manage the Origin Expeditions and Urban Workshops. Add new experiences, edit pricing, dates, and locations.
                    </p>
                </div>
                <a asp-page="/Admin/Experiences/Index" class="inline-block bg-black text-white dark:bg-[#D6D0C8] dark:text-black px-8 py-4 font-mono-jb font-bold text-xs uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8] text-decoration-none">
                    Manage Experiences
                </a>
            </div>

            <!-- QR Code Generator -->
            <div class="bg-gray-50 dark:bg-[#1C191F] border border-gray-100 dark:border-[#2A262C] p-8 flex flex-col justify-between md:col-span-2 lg:col-span-1">
                <div>
                    <h2 class="text-2xl font-grotesk font-bold mb-4">QR Generator</h2>
                    <p class="text-gray-500 dark:text-gray-300 font-light mb-6">
                        Generate high-resolution QR codes for packaging stickers. 
                    </p>
                    
                    <div class="flex flex-col gap-4 mb-6">
                        <label class="text-xs font-mono-jb uppercase font-bold text-gray-500">Target URL</label>
                        <input type="text" id="qr-url-input" value="https://purplebean.coffee/Coffee" class="w-full px-4 py-3 bg-white dark:bg-[#121014] border border-gray-300 dark:border-[#2A262C] rounded text-sm font-mono-jb text-black dark:text-[#D6D0C8] focus:outline-none focus:border-v-red transition-colors" />
                        
                        <div class="flex gap-2">
                            <button id="qr-generate-btn" class="flex-1 bg-black text-white dark:bg-[#D6D0C8] dark:text-black px-4 py-3 font-mono-jb font-bold text-[10px] uppercase tracking-widest text-center hover:bg-v-red transition-colors border border-black dark:border-[#D6D0C8] cursor-pointer">
                                Generate
                            </button>
                            <button id="qr-download-btn" class="flex-1 bg-white text-black dark:bg-[#1C191F] dark:text-[#D6D0C8] px-4 py-3 font-mono-jb font-bold text-[10px] uppercase tracking-widest text-center hover:bg-gray-100 dark:hover:bg-[#2A262C] transition-colors border border-black dark:border-[#D6D0C8] cursor-pointer disabled:opacity-50" disabled>
                                Download PNG
                            </button>
                        </div>
                    </div>
                </div>
                <div class="flex justify-center items-center p-6 bg-white dark:bg-[#121014] border border-dashed border-gray-300 dark:border-[#2A262C] min-h-[250px]" id="qr-container">
                    <span class="text-gray-400 text-xs font-mono-jb uppercase tracking-widest" id="qr-placeholder">QR Code Preview</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const generateBtn = document.getElementById('qr-generate-btn');
            const downloadBtn = document.getElementById('qr-download-btn');
            const urlInput = document.getElementById('qr-url-input');
            const container = document.getElementById('qr-container');
            const placeholder = document.getElementById('qr-placeholder');
            
            let highResQrCode = null;

            generateBtn.addEventListener('click', function() {
                const url = urlInput.value.trim();
                if (!url) return;
                
                // Clear container
                if (placeholder) placeholder.style.display = 'none';
                container.innerHTML = '';
                
                // Configuration for the stylized QR code preview
                const previewQrCode = new QRCodeStyling({
                    width: 250,
                    height: 250,
                    data: url,
                    margin: 10,
                    qrOptions: {
                        typeNumber: 0,
                        mode: "Byte",
                        errorCorrectionLevel: "H"
                    },
                    imageOptions: {
                        hideBackgroundDots: true,
                        imageSize: 0.35,
                        margin: 5
                    },
                    dotsOptions: {
                        type: "classy",
                        color: "#271825"
                    },
                    backgroundOptions: {
                        color: "#B7C952"
                    },
                    image: "/images/center_logo.png",
                    cornersSquareOptions: {
                        type: "square",
                        color: "#271825"
                    },
                    cornersDotOptions: {
                        type: "square",
                        color: "#271825"
                    }
                });
                
                previewQrCode.append(container);
                
                // Keep a high-res version for downloading
                highResQrCode = new QRCodeStyling({
                    width: 1000,
                    height: 1000,
                    data: url,
                    margin: 40,
                    qrOptions: {
                        typeNumber: 0,
                        mode: "Byte",
                        errorCorrectionLevel: "H"
                    },
                    imageOptions: {
                        hideBackgroundDots: true,
                        imageSize: 0.35,
                        margin: 10
                    },
                    dotsOptions: {
                        type: "classy",
                        color: "#271825"
                    },
                    backgroundOptions: {
                        color: "#B7C952"
                    },
                    image: "/images/center_logo.png",
                    cornersSquareOptions: {
                        type: "square",
                        color: "#271825"
                    },
                    cornersDotOptions: {
                        type: "square",
                        color: "#271825"
                    }
                });

                downloadBtn.disabled = false;
            });

            downloadBtn.addEventListener('click', function() {
                if (highResQrCode) {
                    highResQrCode.download({ name: "purplebean_qr_code", extension: "png" });
                }
            });
        });
    </script>
}
