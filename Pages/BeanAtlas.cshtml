@page
@model TheBestBean.Pages.BeanAtlasModel
@{
    ViewData["Title"] = "The Bean Atlas";
}

<style>
    .bean-atlas-container {
        font-family: 'Inter', sans-serif;
        background: #ffffff;
        min-height: 100vh;
        padding-top: 100px;
    }
    
    .dark .bean-atlas-container {
        background: #0a0a0a;
    }
    
    .hero-section {
        height: 85vh;
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), 
                    url('/Media/coffee_atlas_world_bean.webp') center/cover;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
        position: relative;
        margin: 0 -50px;
        width: calc(100% + 100px);
        margin-top: -80px;
        padding-top: 80px;
    }
    
    .hero-section h1 {
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
        color: #fefdfd !important;
        margin-left: 2rem;
    }
    
    .hero-section p {
        font-size: 1.2rem;
        max-width: 600px;
        margin: 0 auto;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
        margin-top: 4rem;
        margin-bottom: 4rem;
    }
    
    .species-comparison {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: none;
    }
    
    .dark .species-comparison {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .species-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0;
        padding: 30px;
        margin: 20px 0;
        box-shadow: none;
    }
    
    .dark .species-card {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .species-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #111111;
        margin-bottom: 15px;
        font-family: 'Space Grotesk', 'Inter', sans-serif;
    }
    
    .dark .species-title {
        color: #ffffff;
    }
    
    .species-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    
    .detail-box {
        background: white;
        padding: 15px;
        border-radius: 0;
        border: 1px solid #e5e7eb;
    }
    
    .dark .detail-box {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .detail-label {
        font-weight: 600;
        color: #6b694a;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .detail-value {
        color: var(--charcoal);
        font-size: 1rem;
        margin-top: 5px;
    }
    
    .region-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: none;
    }
    
    .dark .region-section {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .region-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 30px;
    }
    
    .region-card {
        background: #F9F9F9;
        border: 1px solid #e5e7eb;
        border-radius: 0;
        padding: 25px;
        transition: background-color 0.3s ease, border-color 0.3s ease;
        box-shadow: none;
    }
    
    .dark .region-card {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .region-card:hover {
        background: #ffffff;
        border-color: #d1d5db;
        transform: none;
    }
    
    .dark .region-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
    }
    
    .region-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111111;
        margin-bottom: 10px;
        font-family: 'Space Grotesk', 'Inter', sans-serif;
        transition: color 0.3s ease;
    }
    
    .dark .region-name {
        color: #ffffff;
    }
    
    .region-card:hover .region-name {
        color: #FF3B30;
    }
    
    .region-country {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }
    
    .region-characteristics {
        list-style: none;
        padding: 0;
    }
    
    .region-characteristics li {
        padding: 5px 0;
        border-bottom: 1px solid #e9ecef;
    }
    
    .region-characteristics li:last-child {
        border-bottom: none;
    }
    
    .characteristic-label {
        font-weight: 600;
        color: #6b694a;
    }
    
    .peru-focus {
        background: linear-gradient(135deg, #6b694a, #8a8758);
        color: white;
        border-radius: 12px;
        padding: 40px;
        margin: 40px 0;
        text-align: center;
    }
    
    .peru-focus h2 {
        margin-bottom: 20px;
        font-size: 2.2rem;
    }
    
    .peru-regions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }
    
    .peru-region {
        background: rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }
    
    .peru-region h4 {
        margin-bottom: 10px;
        font-size: 1.3rem;
    }
    
    .altitude-effect {
        background: white;
        border-radius: 12px;
        padding: 40px;
        margin: 40px 0;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }
    
    .altitude-chart {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 25px;
        margin: 50px 0;
        padding: 30px;
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }
    
    .altitude-bar {
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
    }
    
    .altitude-bar:hover {
        transform: translateY(-8px);
    }
    
    .altitude-bar-visual {
        border-radius: 16px 16px 0 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 800;
        font-size: 1.4rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        transition: all 0.3s ease;
    }
    
    .altitude-bar-visual::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.6s ease;
    }
    
    .altitude-bar:hover .altitude-bar-visual::before {
        left: 100%;
    }
    
    .altitude-bar:nth-child(1) .altitude-bar-visual {
        background: linear-gradient(135deg, #2c3e50, #34495e);
    }
    
    .altitude-bar:nth-child(2) .altitude-bar-visual {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
    }
    
    .altitude-bar:nth-child(3) .altitude-bar-visual {
        background: linear-gradient(135deg, #3498db, #5dade2);
    }
    
    .altitude-bar:nth-child(4) .altitude-bar-visual {
        background: linear-gradient(135deg, #9b59b6, #bb8fce);
    }
    
    .altitude-bar:nth-child(5) .altitude-bar-visual {
        background: linear-gradient(135deg, #e74c3c, #f1948a);
    }
    
    .altitude-label {
        padding: 20px 15px;
        background: white;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }
    
    .altitude-bar:hover .altitude-label {
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }
    
    .altitude-label-title {
        font-weight: 700;
        margin-bottom: 8px;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .altitude-bar:nth-child(1) .altitude-label-title {
        color: #2c3e50;
    }
    
    .altitude-bar:nth-child(2) .altitude-label-title {
        color: #27ae60;
    }
    
    .altitude-bar:nth-child(3) .altitude-label-title {
        color: #3498db;
    }
    
    .altitude-bar:nth-child(4) .altitude-label-title {
        color: #9b59b6;
    }
    
    .altitude-bar:nth-child(5) .altitude-label-title {
        color: #e74c3c;
    }
    
    .altitude-label-range {
        font-size: 0.95rem;
        color: #666;
        margin-bottom: 10px;
        font-weight: 600;
    }
    
    .altitude-label-flavor {
        font-size: 0.9rem;
        color: #888;
        line-height: 1.4;
    }
    
    .terroir-explanation {
        background: #fff8e1;
        border: 1px solid #ffcc02;
        border-radius: 8px;
        padding: 25px;
        margin: 30px 0;
    }
    
    .terroir-explanation h4 {
        color: #f57c00;
        margin-bottom: 15px;
    }
    
    @@media (max-width: 768px) {
        .hero-section {
            height: 60vh;
        }
        
        .hero-section h1 {
            font-size: 2.5rem;
        }
        
        .species-details {
            grid-template-columns: 1fr;
        }
        
        .region-grid {
            grid-template-columns: 1fr;
        }
        
        .altitude-chart {
            flex-direction: column;
            height: auto;
            align-items: center;
        }
        
        .altitude-bar {
            width: 100%;
            margin-bottom: 20px;
        }
    }
    
    /* Coffee Varieties Section */
    .coffee-varieties-section {
        background: white;
        padding: 60px 40px;
        margin: 40px 0;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    
    .variety-category {
        margin-bottom: 50px;
    }
    
    .category-title {
        font-size: 1.8rem;
        color: var(--charcoal);
        margin-bottom: 10px;
        font-weight: 600;
        border-bottom: 2px solid #e0e0e0;
        padding-bottom: 10px;
    }
    
    .category-description {
        color: #666;
        margin-bottom: 30px;
        font-style: italic;
    }
    
    .varieties-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }
    
    .variety-card {
        background: #fafafa;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .variety-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        border-color: #8B4513;
    }
    
    .variety-card.specialty-card {
        background: linear-gradient(135deg, #fff8e1 0%, #f3e5ab 100%);
        border-color: #ffb74d;
    }
    
    .variety-card.robusta-card {
        background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
        border-color: #4caf50;
    }
    
    .variety-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e0e0e0;
    }
    
    .variety-name {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--charcoal);
        margin: 0;
    }
    
    .variety-type {
        background: #8B4513;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .variety-type.specialty {
        background: #ff9800;
    }
    
    .variety-type.robusta {
        background: #4caf50;
    }
    
    .variety-specs {
        margin-bottom: 20px;
    }
    
    .spec-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        padding: 5px 0;
    }
    
    .spec-label {
        font-weight: 600;
        color: #666;
        font-size: 0.9rem;
    }
    
    .spec-value {
        color: var(--charcoal);
        font-weight: 500;
        text-align: right;
    }
    
    .variety-description {
        line-height: 1.6;
    }
    
    .variety-description p {
        margin-bottom: 10px;
        color: #555;
    }
    
    .variety-description strong {
        color: var(--charcoal);
        font-weight: 600;
    }
    
    @@media (max-width: 768px) {
        .varieties-grid {
            grid-template-columns: 1fr;
        }
        
        .coffee-varieties-section {
            padding: 40px 20px;
        }
    }
</style>

<div class="bean-atlas-container">
    <div class="hero-section">
        <h1>THE BEAN ATLAS</h1>
        <p>Explore the world of coffee beans — from species and varieties to terroir and the unique characteristics that make each cup extraordinary.</p>
    </div>
    
    <div class="container">
        <!-- Coffee Species Comparison -->
        <div class="species-comparison">
            <h2 style="text-align: center; margin-bottom: 30px; color: var(--charcoal);">Arabica vs. Robusta</h2>
            
            <div class="atlas-image-container">
                <img src="/Media/arabica_robusta.webp" alt="Arabica vs Robusta Comparison" class="atlas-image">
            </div>
            
            <div class="species-card">
                <h3 class="species-title">☕ Coffea Arabica</h3>
                <p>The premium coffee species, representing about 70% of global coffee production. Known for its complex flavors and lower caffeine content.</p>
                <div class="species-details">
                    <div class="detail-box">
                        <div class="detail-label">Caffeine Content</div>
                        <div class="detail-value">0.8-1.4%</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Growing Altitude</div>
                        <div class="detail-value">600-2000m</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Flavor Profile</div>
                        <div class="detail-value">Complex, sweet, acidic</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Market Share</div>
                        <div class="detail-value">70%</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Growing Regions</div>
                        <div class="detail-value">Latin America, Africa, Asia</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Bean Shape</div>
                        <div class="detail-value">Oval, flat</div>
                    </div>
                </div>
            </div>
            
            <div class="species-card">
                <h3 class="species-title">⚡ Coffea Canephora (Robusta)</h3>
                <p>The hardier coffee species, known for its higher caffeine content and resistance to diseases. Often used in espresso blends.</p>
                <div class="species-details">
                    <div class="detail-box">
                        <div class="detail-label">Caffeine Content</div>
                        <div class="detail-value">1.7-4.0%</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Growing Altitude</div>
                        <div class="detail-value">0-800m</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Flavor Profile</div>
                        <div class="detail-value">Bold, earthy, bitter</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Market Share</div>
                        <div class="detail-value">30%</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Growing Regions</div>
                        <div class="detail-value">Vietnam, Others</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label">Bean Shape</div>
                        <div class="detail-value">Round, small</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Peru Focus Section -->
        <div class="peru-focus">
            <h2>🇵🇪 PERU: A COFFEE PARADISE</h2>
            <p>Peru's diverse microclimates and altitudes create some of the world's most unique and flavorful coffees. From the high Andes to the Amazon basin, each region tells a story through its beans.</p>
            
            <div class="atlas-image-container">
                <img src="/Media/peru_map.webp" alt="Peru Coffee Map" class="atlas-image">
            </div>
            
            <div class="peru-regions">
                <div class="peru-region">
                    <h4>Cusco Region</h4>
                    <p><strong>Altitude:</strong> 1200-1800m</p>
                    <p><strong>Flavor:</strong> Bright acidity, floral notes</p>
                    <p><strong>Harvest:</strong> April - September</p>
                </div>
                <div class="peru-region">
                    <h4>La Convención</h4>
                    <p><strong>Altitude:</strong> 1000-1600m</p>
                    <p><strong>Flavor:</strong> Chocolate, caramel</p>
                    <p><strong>Harvest:</strong> May - October</p>
                </div>
                <div class="peru-region">
                    <h4>Cajamarca</h4>
                    <p><strong>Altitude:</strong> 1400-2000m</p>
                    <p><strong>Flavor:</strong> Fruity, wine-like</p>
                    <p><strong>Harvest:</strong> March - August</p>
                </div>
                <div class="peru-region">
                    <h4>Puno</h4>
                    <p><strong>Altitude:</strong> 1600-2200m</p>
                    <p><strong>Flavor:</strong> Clean, bright</p>
                    <p><strong>Harvest:</strong> April - September</p>
                </div>
            </div>
        </div>
        
        <!-- Global Coffee Regions -->
        <div class="region-section">
            <h2 style="text-align: center; margin-bottom: 30px; color: var(--charcoal);">Global Coffee Origins</h2>
            
            <div class="atlas-image-container">
                <img src="/Media/old_world_coffee_map.webp" alt="World Coffee Map" class="atlas-image">
            </div>
            
            <div class="atlas-image-container">
                <img src="/Media/wm.webp" alt="Coffee Belt Map" class="atlas-image">
            </div>
            
            <div class="region-grid">
                <div class="region-card" style="grid-column: span 2;">
                    <h3 class="region-name">Nariño, Colombia (Coming Soon)</h3>
                    <div class="region-country">South America</div>
                    <ul class="region-characteristics">
                        <li><span class="characteristic-label">Altitude:</span> 2000m+</li>
                        <li><span class="characteristic-label">Flavor:</span> Creamy, sugar cane, red apple</li>
                        <li><span class="characteristic-label">Process:</span> Honey & Washed</li>
                    </ul>
                    <div class="mt-4 text-sm text-gray-600">
                        <h4 class="font-bold mb-1">Why Nariño Honey Lots are Unique</h4>
                        <p class="mb-2"><strong class="text-black dark:text-[#D6D0C8]">Volcanic Terroir:</strong> The volcanic soil of the Galeras volcano adds a mineral complexity that prevents the honey process from becoming "cloying" or overly fermented.</p>
                        <p class="mb-2"><strong class="text-black dark:text-[#D6D0C8]">Altitude:</strong> Because farms sit above 2,000m, the cool nights slow down the drying process. This allows the beans to absorb more sugars from the mucilage, resulting in a creamy mouthfeel.</p>
                        <p><strong class="text-black dark:text-[#D6D0C8]">Key Producers:</strong> Look for microlots from the Buesaco Honey Collective or Finca El Trapiche.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Altitude Effect -->
        <div class="altitude-effect">
            <div style="display: flex; align-items: flex-start; justify-content: flex-start; margin-bottom: 30px;">
                <div style="display: flex; flex-direction: row; align-items: center; gap: 15px;">
                    <img src="/Media/altitude-mountain.svg" alt="Mountain altitude illustration" style="height: 60px; opacity: 0.8; flex-shrink: 0;">
                    <h2 style="margin: 0; color: var(--charcoal); text-align: left;">The Altitude Effect</h2>
                </div>
            </div>
            <p style="text-align: left; margin-bottom: 30px;">Altitude dramatically influences coffee flavor. Higher elevations produce denser beans with more complex flavors.</p>
            
            <div class="altitude-chart">
                <div class="altitude-bar">
                    <div class="altitude-bar-visual" style="height: 80px;">40%</div>
                    <div class="altitude-label">
                        <div class="altitude-label-title">Low</div>
                        <div class="altitude-label-range">0-800m</div>
                        <div class="altitude-label-flavor">Earthy, Full Body</div>
                    </div>
                </div>
                
                <div class="altitude-bar">
                    <div class="altitude-bar-visual" style="height: 120px;">60%</div>
                    <div class="altitude-label">
                        <div class="altitude-label-title">Medium</div>
                        <div class="altitude-label-range">800-1200m</div>
                        <div class="altitude-label-flavor">Balanced, Mild</div>
                    </div>
                </div>
                
                <div class="altitude-bar">
                    <div class="altitude-bar-visual" style="height: 160px;">80%</div>
                    <div class="altitude-label">
                        <div class="altitude-label-title">High</div>
                        <div class="altitude-label-range">1200-1600m</div>
                        <div class="altitude-label-flavor">Bright, Complex</div>
                    </div>
                </div>
                
                <div class="altitude-bar">
                    <div class="altitude-bar-visual" style="height: 200px;">95%</div>
                    <div class="altitude-label">
                        <div class="altitude-label-title">Very High</div>
                        <div class="altitude-label-range">1600-2000m</div>
                        <div class="altitude-label-flavor">Floral, Elegant</div>
                    </div>
                </div>
                
                <div class="altitude-bar">
                    <div class="altitude-bar-visual" style="height: 220px;">100%</div>
                    <div class="altitude-label">
                        <div class="altitude-label-title">Extreme</div>
                        <div class="altitude-label-range">2000m+</div>
                        <div class="altitude-label-flavor">Rare, Prized</div>
                    </div>
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
                <div class="detail-box">
                    <div class="detail-label">Low Altitude</div>
                    <div class="detail-value">Simple, earthy, full body</div>
                </div>
                <div class="detail-box">
                    <div class="detail-label">Medium Altitude</div>
                    <div class="detail-value">Balanced, mild acidity</div>
                </div>
                <div class="detail-box">
