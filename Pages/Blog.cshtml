@page
@model TheBestBean.Pages.BlogModel
@{
    ViewData["Title"] = "Blog";
    ViewData["MetaDescription"] = "Purple Bean Coffee blog — stories from Cusco's coffee farms, brew guides, origin reports, and specialty coffee education from Peru's Andean highlands.";
    Layout = "_Layout";
}

<style>
    .blog-page { --emerald:#004E45; --canopy:#DEFFAF; --dune:#801620; --plasma:#FFC6FF; }
    .blog-hero {
        background: #004E45 !important;
        color: #DEFFAF !important;
        padding: 3.5rem 0 2.75rem;
    }
    .blog-hero h1, html.dark .blog-hero h1 { color: #DEFFAF !important; }
    .blog-hero__kicker {
        color: #FFC6FF !important;
        letter-spacing: 0.22em;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
    }
    .blog-hero__lede { color: #DEFFAF !important; }
    .blog-feed {
        background: #ffffff !important;
        color: #004E45 !important;
        padding: 3.5rem 0 6rem;
    }
    html.dark .blog-feed { background: #ffffff !important; }
    .blog-feed h3,
    .blog-feed h3 a,
    html.dark .blog-feed h3,
    html.dark .blog-feed h3 a { color: #004E45 !important; }
    .blog-card p { color: #004E45 !important; }
    .blog-card__meta,
    .blog-card__author,
    .blog-feed__empty-title { color: #801620 !important; }
    .blog-feed__empty-copy { color: #004E45 !important; }
    .blog-card__meta { border-color: rgba(128, 22, 32, 0.28) !important; }
    .blog-card__placeholder {
        background: #DEFFAF;
        border: 1px solid #004E45;
        color: #004E45;
    }
</style>

<div class="blog-page">
    <div class="blog-hero">
        <div class="relative max-w-[1600px] mx-auto px-6 md:px-12 text-left">
            <p class="blog-hero__kicker font-mono-jb">Field notes · Cusco</p>
            <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter uppercase mb-6">
                The Bean Chronicles
            </h1>
            <p class="blog-hero__lede font-mono-jb max-w-2xl leading-relaxed">
                Weekly dispatches on origin trips, roasting science, and the relentless pursuit of the perfect cup.
            </p>
        </div>
    </div>

    <div class="blog-feed">
        <div class="max-w-[1600px] mx-auto px-6 md:px-12">
            @if (!Model.BlogPosts.Any())
            {
                <div class="text-left py-12">
                    <p class="blog-feed__empty-title font-mono-jb uppercase font-bold tracking-widest">NO TRANSMISSIONS YET</p>
                    <p class="blog-feed__empty-copy font-mono-jb mt-2">Awaiting laboratory declassification.</p>
                </div>
            }
            else
            {
                <div class="mx-auto grid grid-cols-1 gap-x-12 gap-y-24 lg:mx-0 lg:max-w-none lg:grid-cols-3">
                    @foreach (var post in Model.BlogPosts)
                    {
                        <article class="blog-card flex flex-col items-start justify-between group">
                            <div class="relative w-full overflow-hidden mb-6">
                                @if (!string.IsNullOrEmpty(post.ImageUrl))
                                {
                                    <img src="@post.ImageUrl" alt="@post.Title" class="aspect-[4/3] w-full object-cover img-stark group-hover:scale-105 transition-transform duration-700">
                                }
                                else
                                {
                                    <div class="blog-card__placeholder aspect-[4/3] w-full flex items-center justify-center">
                                        <span class="uppercase tracking-widest text-[10px] font-bold font-mono-jb">NO IMAGE</span>
                                    </div>
                                }
                            </div>
                            <div class="w-full">
                                <div class="flex items-center gap-x-4 text-[10px] font-bold uppercase tracking-widest mb-4 border-b pb-4 blog-card__meta">
                                    <time datetime="@post.PublishedAt?.ToString("yyyy-MM-dd")">@post.PublishedAt?.ToString("MMM dd, yyyy")</time>
                                </div>
                                <div class="group relative">
                                    <h3 class="mt-4 text-2xl font-bold tracking-tight leading-tight uppercase">
                                        <a asp-page="/Post" asp-route-slug="@post.Slug" class="text-decoration-none text-inherit">
                                            <span class="absolute inset-0"></span>
                                            @post.Title
                                        </a>
                                    </h3>
                                    @{
                                        var plainText = System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", String.Empty);
                                        var excerptText = plainText.Length > 150 ? plainText.Substring(0, 150) + "..." : plainText;
                                    }
                                    <p class="mt-4 line-clamp-3 text-sm leading-relaxed font-normal">
                                        @excerptText
                                    </p>
                                </div>
                                <div class="relative mt-8 flex items-center gap-x-4">
                                    <p class="blog-card__author font-semibold font-mono-jb text-[10px] uppercase tracking-widest">
                                        @post.Author
                                    </p>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</div>
