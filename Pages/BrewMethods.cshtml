@page
@model BrewMethodsModel
@{
    ViewData["Title"] = "Brew Guides";
    ViewData["MetaDescription"] = "Learn how to brew specialty coffee at home. Pour-over, French press, AeroPress, espresso guides with grind size charts and brew ratios from Purple Bean Coffee in Cusco, Peru.";
}

<div class="brew-guides font-sans text-v-black dark:text-[#D6D0C8] pb-40 md:pb-24">

    <section class="max-w-[1600px] mx-auto w-full px-6 md:px-12 pt-10 md:pt-16 pb-10 md:pb-14">
        <p class="font-mono-jb text-[10px] font-bold uppercase tracking-[0.22em] text-v-gray mb-5">Lab notes · Cusco</p>
        <h1 class="text-[clamp(3.2rem,12vw,8.5rem)] font-bold tracking-tighter leading-[0.82] uppercase m-0">
            Brew<br>Guides
        </h1>
        <p class="mt-8 max-w-xl text-base md:text-lg text-v-gray leading-relaxed">
            Four levers. One cup. The same recipes we run in the Cusco Coffee Lab — ratio, heat, water, grind — then the methods to take home.
        </p>

        <nav class="brew-index" aria-label="Guide index">
            <a href="#variables" class="brew-index__link" style="--brew-idx:#FF3B1F">
                <span class="brew-index__num">01</span>
                <span class="brew-index__label">Variables</span>
            </a>
            <a href="#methods" class="brew-index__link" style="--brew-idx:#0055FF">
                <span class="brew-index__num">02</span>
                <span class="brew-index__label">Physics</span>
            </a>
            <a href="#methods" class="brew-index__link" style="--brew-idx:#16A34A">
                <span class="brew-index__num">03</span>
                <span class="brew-index__label">Chemistry</span>
            </a>
            <a href="#methods" class="brew-index__link" style="--brew-idx:#FFB800">
                <span class="brew-index__num">04</span>
                <span class="brew-index__label">Technique</span>
            </a>
        </nav>
    </section>

    <section id="variables" class="brew-variables-band">
        <div class="max-w-[1600px] mx-auto w-full px-6 md:px-12 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
            <div class="lg:col-span-4 flex flex-col items-start lg:sticky lg:top-28 h-max">
                <span class="font-mono-jb text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 mb-4">01 // Extraction physics</span>
                <h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-[0.9] uppercase text-black m-0">
                    The<br>Variables
                </h2>
                <p class="text-black/70 text-sm md:text-base mt-8 max-w-xs leading-relaxed">
                    Calibration is isolating one lever at a time. Change grind or ratio — not both — then taste.
                </p>
            </div>

            <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
                <article class="brew-var-card">
                    <div class="flex justify-between items-start mb-6">
                        <h3 class="font-mono-jb text-xl font-bold uppercase tracking-tight m-0">Ratio</h3>
                        <span class="font-mono-jb text-2xl font-bold text-[#FF3B1F]">01</span>
                    </div>
                    <p class="text-sm leading-relaxed text-black/70 mb-8">
                        Baseline is <strong>1:16</strong> — 1 g coffee to 16 g water. Weigh both. Volume guesses are how cups drift.
                    </p>
                    <div class="brew-var-spec" style="--brew-accent:#FF3B1F">1 g : 16 g</div>
                </article>

                <article class="brew-var-card">
                    <div class="flex justify-between items-start mb-6">
                        <h3 class="font-mono-jb text-xl font-bold uppercase tracking-tight m-0">Heat</h3>
                        <span class="font-mono-jb text-2xl font-bold text-[#0055FF]">02</span>
                    </div>
                    <p class="text-sm leading-relaxed text-black/70 mb-8">
                        Light, dense roasts want ~<strong>96°C</strong>. Darker, more soluble coffees sit closer to <strong>90°C</strong>. Off-boil is not a temperature.
                    </p>
                    <div class="brew-var-spec" style="--brew-accent:#0055FF">90–96 °C</div>
                </article>

                <article class="brew-var-card">
                    <div class="flex justify-between items-start mb-6">
                        <h3 class="font-mono-jb text-xl font-bold uppercase tracking-tight m-0">Solvent</h3>
                        <span class="font-mono-jb text-2xl font-bold text-[#16A34A]">03</span>
                    </div>
                    <p class="text-sm leading-relaxed text-black/70 mb-8">
                        Water is 98% of the cup. Filtered, with some mineral — <strong>100–150 ppm TDS</strong>. Distilled tastes hollow; hard water tastes chalky.
                    </p>
                    <div class="brew-var-spec" style="--brew-accent:#16A34A">100–150 ppm</div>
                </article>

                <article class="brew-var-card">
                    <div class="flex justify-between items-start mb-6">
                        <h3 class="font-mono-jb text-xl font-bold uppercase tracking-tight m-0">Grind</h3>
                        <span class="font-mono-jb text-2xl font-bold text-[#FFB800]">04</span>
                    </div>
                    <p class="text-sm leading-relaxed text-black/70 mb-8">
                        Surface area is contact time. Sour and thin → finer. Bitter and heavy → coarser. Change this first, then ratio.
                    </p>
                    <div class="brew-var-spec" style="--brew-accent:#C99200">Fine ↔ Coarse</div>
                </article>
            </div>
        </div>
    </section>

    <section id="methods" class="max-w-[1600px] mx-auto w-full px-6 md:px-12 pt-20 md:pt-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
            <div class="lg:col-span-4 flex flex-col items-start lg:sticky lg:top-28 h-max">
                <span class="font-mono-jb text-[10px] font-bold uppercase tracking-[0.2em] text-v-gray mb-4">02 // Standard recipes</span>
                <h2 class="text-4xl md:text-5xl font-bold tracking-tight leading-[0.9] uppercase m-0">
                    The<br>Methods
                </h2>
                <p class="text-v-gray text-sm mt-8 max-w-xs leading-relaxed">
                    Same coffees as the lab. Same numbers. Print the guest cards from the Cusco Coffee Lab tour if you want paper.
                </p>
            </div>

            <div class="lg:col-span-8 flex flex-col gap-8">

                <article class="brew-method-card">
                    <header class="brew-method-card__head">
                        <div>
                            <span class="brew-method-card__tag">Percolation</span>
                            <h3>V60 / Hario</h3>
                        </div>
                        <dl class="brew-method-card__stats">
                            <div><dt>Dose</dt><dd>15 g</dd></div>
                            <div><dt>Yield</dt><dd>250 g</dd></div>
                            <div><dt>Time</dt><dd>2:45</dd></div>
                        </dl>
                    </header>
                    <ol class="brew-method-card__steps">
                        <li>Rinse the paper. Warm the carafe. Dump the rinse water.</li>
                        <li>Bloom with 45 g water for 45 seconds.</li>
                        <li>Pour slow concentric circles to 250 g. Let it drain ~2:45.</li>
                    </ol>
                </article>

                <article class="brew-method-card">
                    <header class="brew-method-card__head">
                        <div>
                            <span class="brew-method-card__tag">Pressure</span>
                            <h3>Espresso</h3>
                        </div>
                        <dl class="brew-method-card__stats">
                            <div><dt>Dose</dt><dd>18 g</dd></div>
                            <div><dt>Yield</dt><dd>36 g</dd></div>
                            <div><dt>Time</dt><dd>28–32 s</dd></div>
                        </dl>
                    </header>
                    <ol class="brew-method-card__steps">
                        <li>Dose 18 g, distribute, tamp level.</li>
                        <li>Pull 36 g in 28–32 seconds (1:2).</li>
                        <li>Gush → grind finer. Choke → grind coarser. Change one thing.</li>
                    </ol>
                </article>

                <article class="brew-method-card">
                    <header class="brew-method-card__head">
                        <div>
                            <span class="brew-method-card__tag">Immersion</span>
                            <h3>AeroPress</h3>
                        </div>
                        <dl class="brew-method-card__stats">
                            <div><dt>Dose</dt><dd>18 g</dd></div>
                            <div><dt>Yield</dt><dd>200 g</dd></div>
                            <div><dt>Time</dt><dd>2:00</dd></div>
                        </dl>
                    </header>
                    <ol class="brew-method-card__steps">
                        <li>Inverted: 18 g coffee, 200 g water at ~92°C.</li>
                        <li>Stir hard 10 seconds. Steep to 1:30.</li>
                        <li>Cap, flip, press 30 seconds. Stop at the hiss.</li>
                    </ol>
                </article>

                <article class="brew-method-card">
                    <header class="brew-method-card__head">
                        <div>
                            <span class="brew-method-card__tag">Full immersion</span>
                            <h3>French Press</h3>
                        </div>
                        <dl class="brew-method-card__stats">
                            <div><dt>Dose</dt><dd>30 g</dd></div>
                            <div><dt>Yield</dt><dd>500 g</dd></div>
                            <div><dt>Time</dt><dd>4:00</dd></div>
                        </dl>
                    </header>
                    <ol class="brew-method-card__steps">
                        <li>Coarse grind. Add all 500 g water at once.</li>
                        <li>Break the crust at 4:00. Skim foam and floaters.</li>
                        <li>Rest 5 minutes more. Plunge just to the surface — don’t mash the bed.</li>
                    </ol>
                </article>

            </div>
        </div>
    </section>
</div>
