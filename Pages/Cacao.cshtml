@page
@model TheBestBean.Pages.CacaoModel
@using System.Net
@{
    ViewData["Title"] = "Cacao";
}

<section id="page-cacao" class="page-section">
    <!-- Our Story -->
    <div class="flex flex-col md:flex-row gap-12 mb-20 border-b border-gray-200 dark:border-dark-border pb-12" style="display: flex; flex-direction: row; gap: 3rem; margin-bottom: 5rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 3rem;">
        <div class="md:w-1/2" style="width: 50%;">
            <span class="inline-block px-3 py-1 bg-black dark:bg-white text-white dark:text-black text-xs font-bold font-mono mb-6" style="display: inline-block; padding: 0.25rem 0.75rem; background: #111111; color: white; font-size: 0.75rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; margin-bottom: 1.5rem;">FINE CACAO</span>
            <h1 class="font-grotesk text-5xl md:text-7xl tracking-tight leading-none mb-6" style="font-family: 'Space Grotesk', sans-serif; font-size: 3.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1; margin-bottom: 1.5rem;">Our Story</h1>
            <p class="font-sans text-lg text-gray-600 dark:text-gray-300 leading-relaxed" style="font-family: 'Inter', sans-serif; font-size: 1.125rem; color: #4b5563; line-height: 1.75;">
                Working directly with Chuncho chocolate farmers, we bring you the ancient flavors of Cusco. This unique varietal, native to the Amazonian valleys of La Convención, is celebrated for its low bitterness and complex floral profile. We believe in preserving this heritage through direct trade and sustainable practices.
            </p>
        </div>
        <div class="md:w-1/2 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] h-[400px] rounded-lg overflow-hidden relative" style="width: 50%; background: #f3f4f6; height: 400px; border-radius: 8px; overflow: hidden; position: relative;">
            <img src="/Media/Cacao_harvest.webp" class="w-full h-full object-cover transition-transform hover:scale-105 duration-700" alt="Cacao pods on branch with mountains" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s;">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8" style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6), transparent); display: flex; align-items: flex-end; padding: 2rem;">
                <div class="text-white">
                    <h3 class="font-grotesk text-2xl font-bold" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; color: white;">Chuncho Cacao</h3>
                    <p class="font-mono text-xs opacity-80" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; opacity: 0.8; color: white;">NATIVE TO CUSCO</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Cacao Varieties Grid -->
    <h2 class="font-grotesk text-3xl font-bold mb-8" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.875rem; font-weight: 700; margin-bottom: 2rem;">Varietals of Peru</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border-l border-t border-gray-200 dark:border-dark-border" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-left: 1px solid #e5e7eb; border-top: 1px solid #e5e7eb;">
        
        <!-- Chuncho -->
        <div onclick="window.location.href='@Url.Page("/Product", new { id = "Chuncho-Cacao" })'" class="border-r border-b border-gray-200 dark:border-dark-border p-8 hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; padding: 2rem; transition: background-color 0.3s; cursor: pointer;">
            <div class="mb-4 h-48 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] rounded overflow-hidden" style="margin-bottom: 1rem; height: 12rem; background: #f3f4f6; border-radius: 4px; overflow: hidden;">
                <img src="/Media/Cacao/cacao_llama.webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Chuncho cacao pods on trunk" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">
            </div>
            <h3 class="font-grotesk text-2xl font-bold mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; transition: color 0.3s;">Chuncho</h3>
            <p class="font-mono text-xs text-swiss-red mb-4 uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; margin-bottom: 1rem; text-transform: uppercase;">Cusco</p>
            <p class="font-sans text-sm text-gray-600 dark:text-gray-400 mb-4" style="font-family: 'Inter', sans-serif; font-size: 0.875rem; color: #4b5563; margin-bottom: 1rem;">Delicate and balanced with notes of woody cognac, cinnamon, sweet wine, and toffee.</p>
            <div class="text-xs font-mono opacity-60" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; opacity: 0.6;">AROMA: VANILLA / GREEN TEA</div>
        </div>

        <!-- Piura White -->
        <div onclick="window.location.href='@Url.Page("/Product", new { id = "Piura-White-Cacao" })'" class="border-r border-b border-gray-200 dark:border-dark-border p-8 hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; padding: 2rem; transition: background-color 0.3s; cursor: pointer;">
            <div class="mb-4 h-48 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] rounded overflow-hidden" style="margin-bottom: 1rem; height: 12rem; background: #f3f4f6; border-radius: 4px; overflow: hidden;">
                <img src="/Media/Piura_White_White_Jewel.webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Piura White cacao pods" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">
            </div>
            <h3 class="font-grotesk text-2xl font-bold mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; transition: color 0.3s;">Piura White</h3>
            <p class="font-mono text-xs text-swiss-red mb-4 uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; margin-bottom: 1rem; text-transform: uppercase;">Piura</p>
            <p class="font-sans text-sm text-gray-600 dark:text-gray-400 mb-4" style="font-family: 'Inter', sans-serif; font-size: 0.875rem; color: #4b5563; margin-bottom: 1rem;">Known as "the white jewel" for its exceptional aroma and low acidity. The beans are pale pink.</p>
            <div class="text-xs font-mono opacity-60" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; opacity: 0.6;">COLOR: PALE PINK</div>
        </div>

        <!-- Criollo -->
        <div onclick="window.location.href='@Url.Page("/Product", new { id = "Criollo-Cacao" })'" class="border-r border-b border-gray-200 dark:border-dark-border p-8 hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; padding: 2rem; transition: background-color 0.3s; cursor: pointer;">
            <div class="mb-4 h-48 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] rounded overflow-hidden" style="margin-bottom: 1rem; height: 12rem; background: #f3f4f6; border-radius: 4px; overflow: hidden;">
                <img src="/Media/Cacao/Llama_Cacao_paper.webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Criollo red and orange cacao pods" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">
            </div>
            <h3 class="font-grotesk text-2xl font-bold mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; transition: color 0.3s;">Criollo</h3>
            <p class="font-mono text-xs text-swiss-red mb-4 uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; margin-bottom: 1rem; text-transform: uppercase;">Amazonian</p>
            <p class="font-sans text-sm text-gray-600 dark:text-gray-400 mb-4" style="font-family: 'Inter', sans-serif; font-size: 0.875rem; color: #4b5563; margin-bottom: 1rem;">The "King of Cacao." Delicate and complex with low bitterness. Subtle notes of red fruits and floral tones.</p>
            <div class="text-xs font-mono opacity-60" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; opacity: 0.6;">USE: GOURMET CHOCOLATE</div>
        </div>

        <!-- Trinitario -->
        <div onclick="window.location.href='@Url.Page("/Product", new { id = "Trinitario-Cacao" })'" class="border-r border-b border-gray-200 dark:border-dark-border p-8 hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; padding: 2rem; transition: background-color 0.3s; cursor: pointer;">
            <div class="mb-4 h-48 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] rounded overflow-hidden" style="margin-bottom: 1rem; height: 12rem; background: #f3f4f6; border-radius: 4px; overflow: hidden;">
                <img src="@("/Media/" + WebUtility.UrlEncode("Trinitario Cacao, the hybrid variety.webp").Replace("+", "%20"))" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Trinitario cacao pods on branch" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">
            </div>
            <h3 class="font-grotesk text-2xl font-bold mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; transition: color 0.3s;">Trinitario</h3>
            <p class="font-mono text-xs text-swiss-red mb-4 uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; margin-bottom: 1rem; text-transform: uppercase;">Various Regions</p>
            <p class="font-sans text-sm text-gray-600 dark:text-gray-400 mb-4" style="font-family: 'Inter', sans-serif; font-size: 0.875rem; color: #4b5563; margin-bottom: 1rem;">A hybrid of Criollo and Forastero. Combines the smoothness of Criollo with the rich flavor of Forastero.</p>
            <div class="text-xs font-mono opacity-60" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; opacity: 0.6;">PROFILE: BALANCED HYBRID</div>
        </div>

        <!-- Forastero -->
        <div onclick="window.location.href='@Url.Page("/Product", new { id = "Forastero-Cacao" })'" class="border-r border-b border-gray-200 dark:border-dark-border p-8 hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border-right: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; padding: 2rem; transition: background-color 0.3s; cursor: pointer;">
            <div class="mb-4 h-48 bg-gray-100 dark:bg-[#1C191F] dark:bg-[#111] rounded overflow-hidden" style="margin-bottom: 1rem; height: 12rem; background: #f3f4f6; border-radius: 4px; overflow: hidden;">
                <img src="@("/Media/" + WebUtility.UrlEncode("Forastero Cacao, the robust Amazonian variety.webp").Replace("+", "%20"))" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Forastero cacao pods" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">
            </div>
            <h3 class="font-grotesk text-2xl font-bold mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; transition: color 0.3s;">Forastero</h3>
            <p class="font-mono text-xs text-swiss-red mb-4 uppercase" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; margin-bottom: 1rem; text-transform: uppercase;">Amazon</p>
            <p class="font-sans text-sm text-gray-600 dark:text-gray-400 mb-4" style="font-family: 'Inter', sans-serif; font-size: 0.875rem; color: #4b5563; margin-bottom: 1rem;">Known for its bold, earthy, and strong cocoa taste. A resilient key ingredient in premium blends.</p>
            <div class="text-xs font-mono opacity-60" style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; opacity: 0.6;">PROFILE: BOLD / EARTHY</div>
        </div>
    </div>
</section>

<style>
    /* Dark mode support */
    .dark .bg-off-white {
        background-color: #111111 !important;
    }


    .dark .border-gray-200 {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }

    .dark .text-gray-500 {
        color: #6b7280 !important;
    }

    .dark .text-gray-400 {
        color: #6b7280 !important;
    }

    .dark .text-gray-300 {
        color: #9ca3af !important;
    }

    .dark .text-gray-600 {
        color: #9ca3af !important;
    }

    .text-swiss-red {
        color: #FF3B30 !important;
    }

    .font-grotesk {
        font-family: 'Space Grotesk', sans-serif !important;
    }

    .font-mono {
        font-family: 'JetBrains Mono', 'Courier New', monospace !important;
    }

    .font-sans {
        font-family: 'Inter', sans-serif !important;
    }

    @@media (max-width: 768px) {
        .grid.grid-cols-1.md\:grid-cols-2.lg\:grid-cols-3 {
            grid-template-columns: 1fr !important;
        }
        
        .flex.flex-col.md\:flex-row {
            flex-direction: column !important;
        }
        
        .md\:w-1\/2 {
            width: 100% !important;
        }
    }
</style>

