@page
@model TheBestBean.Pages.CartModel
@{
    ViewData["Title"] = "Shopping Bag";
}

<div class="checkout-pro">
    <div class="checkout-pro__wrap">
        @if (Model.CartItems.Any())
        {
            <a asp-page="@Model.KeepShoppingPage" class="checkout-pro__back">
                <i class="bi bi-arrow-left"></i> @Model.KeepShoppingLabel
            </a>

            <div class="checkout-pro__grid">
                <div class="checkout-pro__main">
                    <header class="checkout-pro__head">
                        <p class="checkout-pro__kicker">Purple Bean Coffee · Cusco</p>
                        <h1>Your bag</h1>
                        <p class="checkout-pro__lede">@(Model.IsWorkshopOnlyCart
                            ? $"Up to {CartService.MaxExperienceGuests} guests per session. Card fees show up when you choose how to pay."
                            : "Listed price is Yape in soles. Visa and PayPal totals, with card fees, appear at checkout.")</p>
                    </header>

                    <div class="bag-pro__list">
                        @foreach (var item in Model.CartItems)
                        {
                            var isGuests = CartService.IsExperienceBooking(item.ProductType);
                            var atMax = isGuests && item.Quantity >= CartService.MaxExperienceGuests;
                            <article class="checkout-pro__card bag-pro__item">
                                <div class="bag-pro__photo">
                                    <img src="@item.ImageUrl" alt="" onerror="this.src='https://picsum.photos/400/500?random=@item.ProductId'">
                                </div>
                                <div>
                                    <div class="bag-pro__top">
                                        <div>
                                            <h3 class="bag-pro__name">@item.ProductName</h3>
                                            <p class="bag-pro__meta">
                                                @item.ProductType
                                                @if (!string.IsNullOrEmpty(item.Weight))
                                                {
                                                    <text> · @item.Weight</text>
                                                }
                                                @if (!string.IsNullOrEmpty(item.RoastLevel))
                                                {
                                                    <text> · @RoastProfiles.CartLine(item.RoastLevel)</text>
                                                }
                                                @if (isGuests)
                                                {
                                                    <text> · @item.Quantity @(item.Quantity == 1 ? "guest" : "guests")</text>
                                                }
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <p class="bag-pro__desc">@item.Description</p>
                                            }
                                        </div>
                                        <div class="bag-pro__price">
                                            <strong>S/@LocalPricing.YapeSoles(item.Subtotal).ToString("0")</strong>
                                            <span>$@item.Subtotal.ToString("0.00")</span>
                                        </div>
                                    </div>
                                    <div class="bag-pro__row">
                                        <div class="bag-pro__qty" role="group" aria-label="@(isGuests ? "Guests" : "Quantity")">
                                            <form method="post" asp-page-handler="UpdateQuantity">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="productType" value="@item.ProductType" />
                                                <input type="hidden" name="weight" value="@item.Weight" />
                                                <input type="hidden" name="roastLevel" value="@item.RoastLevel" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                <button type="submit" aria-label="@(isGuests ? "Fewer guests" : "Decrease quantity")">−</button>
                                            </form>
                                            <span>@item.Quantity</span>
                                            <form method="post" asp-page-handler="UpdateQuantity">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="productType" value="@item.ProductType" />
                                                <input type="hidden" name="weight" value="@item.Weight" />
                                                <input type="hidden" name="roastLevel" value="@item.RoastLevel" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                <button type="submit" @(atMax ? "disabled" : null) aria-label="@(isGuests ? "More guests" : "Increase quantity")">+</button>
                                            </form>
                                        </div>
                                        <form method="post" asp-page-handler="RemoveItem">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="productType" value="@item.ProductType" />
                                            <input type="hidden" name="weight" value="@item.Weight" />
                                            <input type="hidden" name="roastLevel" value="@item.RoastLevel" />
                                            <button type="submit" class="bag-pro__remove">Remove</button>
                                        </form>
                                    </div>
                                    @if (isGuests)
                                    {
                                        <p class="bag-pro__hint">Maximum @CartService.MaxExperienceGuests guests.</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>

                    <div class="bag-pro__foot">
                        <form method="post" asp-page-handler="ClearCart">
                            <button type="submit" class="bag-pro__clear">Empty bag</button>
                        </form>
                    </div>

                    @if (Model.HasCoffeeItems)
                    {
                        <p class="checkout-pro__help">We roast after payment, ship the next day, and the bag rests on the way.</p>
                    }
                </div>

                <aside class="checkout-pro__aside">
                    <div class="checkout-pro__receipt">
                        <h2>Order summary</h2>
                        <div class="checkout-pro__totals">
                            <div><span>Items</span><span>@Model.ItemCount</span></div>
                            <div><span>Subtotal</span><span>$@Model.CartTotal.ToString("0.00")</span></div>
                            @if (!CartService.SkipsShipping(Model.CartItems))
                            {
                                <div><span>Shipping</span><span>Free</span></div>
                            }
                            <div class="bag-pro__due"><span>Yape / listed</span><span>S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")</span></div>
                        </div>
                        <p class="checkout-pro__receipt-note">Visa, Culqi, and PayPal amounts — including card fees — show when you pick a payment method.</p>
                    </div>
                    <a asp-page="/Checkout" class="checkout-pro__submit bag-pro__cta">Continue to checkout</a>
                    <p class="checkout-pro__trust">No charge on this page · Pay on the next step</p>
                </aside>
            </div>
        }
        else
        {
            <a asp-page="/GreenBeans" class="checkout-pro__back">
                <i class="bi bi-arrow-left"></i> Back to coffee
            </a>
            <div class="bag-pro__empty">
                <p class="checkout-pro__kicker">Your bag</p>
                <h2>Nothing in here yet</h2>
                <p>Add a coffee or an experience, then come back to check out.</p>
                <div class="bag-pro__empty-actions">
                    <a asp-page="/GreenBeans" class="checkout-pro__submit" style="width:auto;padding-left:1.5rem;padding-right:1.5rem">Shop coffee</a>
                    <a asp-page="/Experiences" class="bag-pro__ghost">Experiences</a>
                </div>
            </div>
        }
    </div>
</div>
