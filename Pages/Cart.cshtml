@page
@model TheBestBean.Pages.CartModel
@{
    ViewData["Title"] = "Shopping Bag";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#3C4A33] min-h-[70vh]">
    <div class="container mx-auto px-4 md:px-8">
        <h1 class="text-4xl md:text-6xl font-grotesk font-bold tracking-tighter mb-12 uppercase">
            Your Bag
        </h1>

        @if (Model.CartItems.Any())
        {
            <div class="flex flex-col lg:flex-row gap-16">
                <!-- Left: Items -->
                <div class="flex-1 space-y-8">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="flex gap-6 pb-8 border-b border-gray-100 group">
                            <div class="w-32 h-40 bg-gray-50 border border-gray-100 overflow-hidden shrink-0 group-hover:border-black transition-colors">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='https://picsum.photos/400/500?random=@item.ProductId'">
                            </div>
                            <div class="flex-1 flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between items-start">
                                        <h3 class="text-xl font-grotesk font-bold">@item.ProductName</h3>
                                        <div class="font-mono-jb font-bold price-display" data-price-usd="@item.Price" data-price-pen="@(item.Price * 3.75m)">$@item.Price.ToString("F2")</div>
                                    </div>
                                    <p class="text-xs text-gray-500 font-mono-jb uppercase tracking-widest mt-1">@item.ProductType @(string.IsNullOrEmpty(item.Weight) ? "" : $"| {item.Weight}")</p>
                                    <p class="text-sm text-gray-600 mt-2 font-light line-clamp-2">@item.Description</p>
                                </div>
                                <div class="flex justify-between items-end mt-4">
                                    <div class="flex items-center gap-4">
                                        <div class="flex items-center border border-gray-200">
                                            <form method="post" asp-page-handler="UpdateQuantity">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="productType" value="@item.ProductType" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                <button type="submit" class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 dark:bg-[#2F3A28] transition-colors border-0 bg-transparent">−</button>
                                            </form>
                                            <span class="w-10 text-center font-mono-jb text-sm font-bold">@item.Quantity</span>
                                            <form method="post" asp-page-handler="UpdateQuantity">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="productType" value="@item.ProductType" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                <button type="submit" class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 dark:bg-[#2F3A28] transition-colors border-0 bg-transparent">+</button>
                                            </form>
                                        </div>
                                    </div>
                                    <form method="post" asp-page-handler="RemoveItem">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="productType" value="@item.ProductType" />
                                        <button type="submit" class="text-[10px] font-mono-jb font-bold uppercase tracking-widest text-gray-400 hover:text-black dark:text-[#FAF3DD] transition-colors border-0 bg-transparent">
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="flex gap-4 pt-8">
                        <a asp-page="/GreenBeans" class="text-xs font-mono-jb font-bold uppercase tracking-widest text-gray-400 hover:text-black dark:text-[#FAF3DD] transition-colors text-decoration-none border-b border-transparent hover:border-black">
                            <i class="bi bi-arrow-left"></i> Keep Shopping
                        </a>
                        <form method="post" asp-page-handler="ClearCart">
                            <button type="submit" class="text-xs font-mono-jb font-bold uppercase tracking-widest text-red-400 hover:text-red-600 transition-colors border-0 bg-transparent">
                                Clear Bag
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Right: Summary -->
                <div class="w-full lg:w-[400px]">
                    <div class="bg-gray-50 dark:bg-[#2F3A28] p-8 border border-gray-100 dark:border-[#4F6044] sticky top-32">
                        <h2 class="text-lg font-mono-jb font-bold uppercase tracking-widest mb-6 border-b border-black pb-2">Order Summary</h2>
                        <div class="space-y-4 mb-8">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500 font-light">Subtotal (@Model.ItemCount items)</span>
                                <span class="font-mono-jb font-bold price-display" data-price-usd="@Model.CartTotal" data-price-pen="@(Model.CartTotal * 3.75m)">$@Model.CartTotal.ToString("F2")</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500 font-light">Shipping</span>
                                <span class="text-green-600 font-mono-jb font-bold">FREE</span>
                            </div>
                            <div class="pt-4 border-t border-gray-200">
                                <div class="flex justify-between items-baseline">
                                    <span class="text-xl font-grotesk font-bold">Total</span>
                                    <span class="text-2xl font-grotesk font-bold price-display" data-price-usd="@Model.CartTotal" data-price-pen="@(Model.CartTotal * 3.75m)">$@Model.CartTotal.ToString("F2")</span>
                                </div>
                                <p class="text-[10px] text-gray-400 font-mono-jb mt-1 uppercase tracking-widest">Taxes included</p>
                            </div>
                        </div>

                        <a asp-page="/Checkout" class="block w-full bg-black text-white text-center py-4 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-v-red transition-colors border border-black text-decoration-none">
                            Go to Checkout
                        </a>
                        
                        <div class="mt-6 flex items-center justify-center gap-4 text-gray-300">
                            <i class="bi bi-credit-card fs-4"></i>
                            <i class="bi bi-paypal fs-4"></i>
                            <i class="bi bi-google fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center text-center py-20 border-2 border-dashed border-gray-100">
                <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mb-6">
                    <i class="bi bi-bag text-gray-300 fs-2"></i>
                </div>
                <h2 class="text-2xl font-grotesk font-bold mb-4">Your bag is empty</h2>
                <p class="text-gray-500 font-light mb-8 max-w-xs">Looks like you haven't added any coffees to your collection yet.</p>
                <a asp-page="/GreenBeans" class="bg-black text-white px-8 py-4 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-gray-800 transition-all text-decoration-none border-0">
                    Discover Coffee
                </a>
            </div>
        }
    </div>
</div>
