@page
@model TheBestBean.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="pt-32 pb-20 bg-white dark:bg-[#3C4A33] min-h-screen">
    <div class="container mx-auto px-4 md:px-8">
        <!-- Back Link -->
        <a asp-page="/Cart" class="flex items-center gap-2 font-mono-jb text-[10px] uppercase tracking-widest text-gray-400 hover:text-black dark:text-[#FAF3DD] mb-12 transition-colors text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Bag
        </a>

        <div class="flex flex-col lg:flex-row gap-20">
            <!-- Left: Checkout Forms -->
            <div class="flex-1">
                <h1 class="text-4xl font-grotesk font-bold tracking-tighter mb-12 uppercase">
                    Checkout
                </h1>

                <form method="post" class="space-y-12">
                    <!-- Contact -->
                    <section>
                        <h2 class="text-lg font-mono-jb font-bold uppercase tracking-widest mb-6 border-b border-black pb-2">01. Contact</h2>
                        <div class="space-y-4">
                            <div>
                                <label asp-for="Email" class="block text-[10px] font-bold uppercase tracking-widest mb-2">Email Address</label>
                                <input asp-for="Email" type="email" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" placeholder="jane@example.com" required />
                                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1"></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="checkbox" id="newsletter" checked class="w-4 h-4 border-2 border-gray-200" />
                                <label for="newsletter" class="text-xs text-gray-500 font-light">Email me with news and special offers</label>
                            </div>
                        </div>
                    </section>

                    <!-- Shipping -->
                    <section>
                        <h2 class="text-lg font-mono-jb font-bold uppercase tracking-widest mb-6 border-b border-black pb-2">02. Shipping</h2>
                        <div class="space-y-6">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="FirstName" class="block text-[10px] font-bold uppercase tracking-widest mb-2">First Name</label>
                                    <input asp-for="FirstName" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" required />
                                </div>
                                <div>
                                    <label asp-for="LastName" class="block text-[10px] font-bold uppercase tracking-widest mb-2">Last Name</label>
                                    <input asp-for="LastName" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" required />
                                </div>
                            </div>
                            <input type="hidden" asp-for="FullName" id="FullName" />

                            <div>
                                <label asp-for="Address" class="block text-[10px] font-bold uppercase tracking-widest mb-2">Street Address</label>
                                <input asp-for="Address" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" placeholder="123 Coffee Lane" required />
                                <span asp-validation-for="Address" class="text-xs text-red-500 mt-1"></span>
                            </div>

                            <div class="grid grid-cols-3 gap-4">
                                <div class="col-span-1">
                                    <label asp-for="ZipCode" class="block text-[10px] font-bold uppercase tracking-widest mb-2">Postal Code</label>
                                    <input asp-for="ZipCode" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" required />
                                </div>
                                <div class="col-span-2">
                                    <label asp-for="City" class="block text-[10px] font-bold uppercase tracking-widest mb-2">City</label>
                                    <input asp-for="City" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" required />
                                </div>
                            </div>

                             <div>
                                <label asp-for="Phone" class="block text-[10px] font-bold uppercase tracking-widest mb-2">Phone</label>
                                <input asp-for="Phone" type="tel" class="w-full bg-white dark:bg-[#3C4A33] border-2 border-gray-100 p-3 focus:outline-none focus:border-black transition-colors font-light" required />
                            </div>
                        </div>
                    </section>

                    <!-- Payment -->
                    <section>
                        <h2 class="text-lg font-mono-jb font-bold uppercase tracking-widest mb-6 border-b border-black pb-2">03. Payment</h2>
                        <div class="p-8 border-2 border-dashed border-gray-100 bg-gray-50 flex flex-col items-center justify-center text-center">
                            <i class="bi bi-lock text-gray-300 fs-2 mb-4"></i>
                            <p class="text-xs font-mono-jb uppercase tracking-widest text-gray-500 mb-2">Secure checkout with</p>
                            <div class="flex gap-4 text-gray-400 fs-3">
                                <i class="bi bi-credit-card"></i>
                                <i class="bi bi-paypal"></i>
                                <i class="bi bi-google"></i>
                            </div>
                            <p class="text-[10px] text-gray-400 mt-6 font-light">Payment processing will be handled on the next step.</p>
                        </div>
                    </section>

                    <button type="submit" class="w-full bg-black text-white py-5 font-mono-jb font-bold text-xs uppercase tracking-widest hover:bg-v-red transition-colors border border-black">
                        Complete Order — S/ @((Model.CartTotal * 3.8m).ToString("F2"))
                    </button>
                </form>
            </div>

            <!-- Right: Order Summary -->
            <div class="w-full lg:w-[450px]">
                <div class="bg-gray-50 p-8 md:p-12 border border-gray-100 sticky top-32">
                    <h2 class="text-xs font-mono-jb font-bold uppercase tracking-widest mb-8 pb-4 border-b border-gray-200">Order Summary</h2>
                    
                    <div class="space-y-6 mb-10 max-h-[40vh] overflow-y-auto pr-4 custom-scrollbar">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="flex gap-4 items-center">
                                <div class="w-16 h-20 bg-white dark:bg-[#3C4A33] border border-gray-200 relative shrink-0">
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="w-full h-full object-cover" onerror="this.src='https://picsum.photos/200/300?random=@item.ProductId'">
                                    <span class="absolute -top-2 -right-2 bg-black text-white w-5 h-5 flex items-center justify-center rounded-full text-[10px] font-bold font-mono-jb">
                                        @item.Quantity
                                    </span>
                                </div>
                                <div class="flex-1">
                                    <h4 class="font-grotesk font-bold text-sm">@item.ProductName</h4>
                                    <p class="text-[10px] text-gray-400 font-mono-jb uppercase tracking-widest">@item.ProductType</p>
                                </div>
                                <div class="font-mono-jb text-sm font-bold">
                                    S/ @((item.Subtotal * 3.8m).ToString("F2"))
                                </div>
                            </div>
                        }
                    </div>

                    <div class="space-y-4 border-t border-gray-200 pt-8 text-sm">
                        <div class="flex justify-between">
                            <span class="font-light text-gray-500">Subtotal</span>
                            <span class="font-mono-jb font-bold">S/ @((Model.CartTotal * 3.8m).ToString("F2"))</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-light text-gray-500">Shipping</span>
                            <span class="text-green-600 font-mono-jb font-bold">FREE</span>
                        </div>
                        <div class="flex justify-between border-t border-black pt-4 mt-6">
                            <span class="text-xl font-grotesk font-bold">Total</span>
                            <span class="text-2xl font-grotesk font-bold">S/ @((Model.CartTotal * 3.8m).ToString("F2"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 2px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ddd;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #bbb;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const firstName = document.getElementById('FirstName');
            const lastName = document.getElementById('LastName');
            const fullName = document.getElementById('FullName');

            function updateFullName() {
                fullName.value = (firstName.value + ' ' + lastName.value).trim();
            }

            firstName?.addEventListener('input', updateFullName);
            lastName?.addEventListener('input', updateFullName);
        });
    </script>
}
