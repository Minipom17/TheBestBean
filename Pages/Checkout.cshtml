@page
@model TheBestBean.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    var isExperience = Model.IsWorkshopOnlyCart;
    var skipShip = CartService.SkipsShipping(Model.CartItems);
    var stepPay = Model.HasExperienceItems ? "04" : "03";
}

<div class="checkout-pro">
    <div class="checkout-pro__wrap">
        <a asp-page="/Cart" class="checkout-pro__back">
            <i class="bi bi-arrow-left"></i> Back to bag
        </a>

        <div class="checkout-pro__grid">
            <div class="checkout-pro__main">
                <header class="checkout-pro__head">
                    <p class="checkout-pro__kicker">Purple Bean Coffee · Cusco</p>
                    <h1>Checkout</h1>
                    <p class="checkout-pro__lede">@(Model.IsPayPalTestCart
                        ? "Live PayPal $1 test. USD charges about $1.02 with the 2.4% card fee. This is a real charge on the business account."
                        : isExperience ? "Confirm who is coming, add a snack if you like, then pay. Times are America/Lima." : "We roast after payment (our profile unless you picked another), ship the next day, and the bag rests on the way.")</p>
                    <ol class="checkout-pro__steps" aria-label="Checkout steps">
                        <li>Contact</li>
                        <li>@(skipShip ? (isExperience ? "Guests" : "Details") : "Shipping")</li>
                        @if (Model.HasExperienceItems)
                        {
                            <li>Extras</li>
                        }
                        <li>Pay</li>
                    </ol>
                </header>

                <form id="extras-form" method="post" asp-page-handler="AddExtra" class="hidden">
                    @Html.AntiForgeryToken()
                </form>

                <form method="post" id="checkout-form" class="checkout-pro__form">
                    <input type="hidden" asp-for="CulqiToken" id="CulqiToken" />
                    <input type="hidden" asp-for="DeliveryMethod" value="ship" />

                    <section class="checkout-pro__card">
                        <h2>01 · Contact</h2>
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" placeholder="you@email.com" autocomplete="email" required />
                        <span asp-validation-for="Email" class="checkout-pro__error"></span>
                        <p class="checkout-pro__help">Receipt and booking notes. We don’t add you to a list.</p>
                    </section>

                    <section class="checkout-pro__card">
                        <h2>@(skipShip ? (isExperience ? "02 · Guest details" : "02 · Details") : "02 · Shipping")</h2>
                        <div class="checkout-pro__row">
                            <div>
                                <label asp-for="FirstName">First name</label>
                                <input asp-for="FirstName" autocomplete="given-name" required />
                            </div>
                            <div>
                                <label asp-for="LastName">Last name</label>
                                <input asp-for="LastName" autocomplete="family-name" required />
                            </div>
                        </div>
                        <input type="hidden" asp-for="FullName" id="FullName" />
                        <div class="mt-3">
                            <label asp-for="Phone">WhatsApp / phone</label>
                            <input asp-for="Phone" type="tel" required placeholder="+51 913…" autocomplete="tel" />
                        </div>
                        @if (skipShip)
                        {
                            @if (isExperience)
                            {
                                <div class="mt-3">
                                    <label asp-for="Address">Hotel or stay in Cusco <span>(optional)</span></label>
                                    <input asp-for="Address" placeholder="We’ll use this if we need to find you" autocomplete="street-address" />
                                </div>
                                <p class="checkout-pro__help">Up to @CartService.MaxExperienceGuests guests per session. Change the count in your bag before you pay.</p>
                            }
                            else
                            {
                                <p class="checkout-pro__help">No shipping — this is a live PayPal charge on the business account. Refund it in PayPal after if you want the dollar back.</p>
                            }
                            <input type="hidden" asp-for="City" value="Cusco" />
                            <input type="hidden" asp-for="ZipCode" value="08000" />
                        }
                        else
                        {
                            <div class="mt-3">
                                <label asp-for="Address">Street address</label>
                                <input asp-for="Address" required autocomplete="street-address" />
                            </div>
                            <div class="checkout-pro__row checkout-pro__row--3 mt-3">
                                <div>
                                    <label asp-for="ZipCode">Postal</label>
                                    <input asp-for="ZipCode" required autocomplete="postal-code" />
                                </div>
                                <div class="checkout-pro__span2">
                                    <label asp-for="City">City</label>
                                    <input asp-for="City" required autocomplete="address-level2" />
                                </div>
                            </div>
                        }
                    </section>

                    @if (Model.HasExperienceItems)
                    {
                        <section class="checkout-pro__card">
                            <h2>03 · During the session</h2>
                            <p class="checkout-pro__help" style="margin-top:0">Sparkling water, a snack, or toast — we’ll have it at the table.</p>
                            <div class="checkout-pro__addons">
                                @foreach (var extra in ExperienceAddOns.All)
                                {
                                    <button type="submit" form="extras-form" name="sku" value="@extra.Sku" class="checkout-pro__addon">
                                        <span>@extra.Name</span>
                                        <strong>S/@LocalPricing.YapeSoles(extra.Usd).ToString("0")</strong>
                                    </button>
                                }
                            </div>
                            @{
                                var extrasInCart = Model.CartItems.Where(i => string.Equals(i.ProductType, ExperienceAddOns.ProductType, StringComparison.OrdinalIgnoreCase)).ToList();
                            }
                            @if (extrasInCart.Count > 0)
                            {
                                <ul class="checkout-pro__extra-list">
                                    @foreach (var extra in extrasInCart)
                                    {
                                        <li>
                                            <div>
                                                <div>@extra.ProductName</div>
                                                <small>× @extra.Quantity · S/@LocalPricing.YapeSoles(extra.Subtotal).ToString("0")</small>
                                            </div>
                                            <button type="submit" form="extras-form" formaction="@Url.Page("/Checkout", "RemoveExtra", new { productId = extra.ProductId })">Remove</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    <section class="checkout-pro__card">
                        <h2>@stepPay · Pay</h2>
                        <p class="checkout-pro__help" style="margin-top:0">The amount next to the method you pick is what you pay. Yape is the listed soles price — no card fee. Culqi includes Perú 5%. PayPal USD and CAD are on the Canadian account — Visa cap 2.4%.</p>
                        <div asp-validation-summary="All" class="checkout-pro__error"></div>
                        <div class="checkout-pro__pay">
                            <label>
                                <input type="radio" name="PaymentMethod" value="Yape" checked class="sr-only peer" />
                                <div class="checkout-pro__pay-card">
                                    <div>
                                        <img src="/brand/yape-logo.webp" alt="Yape" width="72" height="22" />
                                        <div class="checkout-pro__pay-title">Yape / Plin · Perú</div>
                                        <p>Soles after you place the order. QR on WhatsApp. No Visa fee.</p>
                                    </div>
                                    <div class="checkout-pro__pay-amt">
                                        <strong>S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")</strong>
                                        <span>Best in Perú</span>
                                    </div>
                                </div>
                            </label>
                            <label>
                                <input type="radio" name="PaymentMethod" value="Culqi" class="sr-only peer" />
                                <div class="checkout-pro__pay-card">
                                    <div>
                                        <div class="checkout-pro__pay-title">Culqi · Visa / Mastercard</div>
                                        <p>Local cards in soles. Perú card surcharge 5%.</p>
                                        @if (!Model.CulqiReady)
                                        {
                                            <p class="checkout-pro__warn">Culqi keys not on this server yet — use Yape until secrets/culqi.json is filled in.</p>
                                        }
                                    </div>
                                    <div class="checkout-pro__pay-amt">
                                        <strong>S/@Model.CulqiTotalSoles.ToString("0")</strong>
                                        <span>incl. 5%</span>
                                    </div>
                                </div>
                            </label>
                            <label>
                                <input type="radio" name="PaymentMethod" value="PayPalUsd" class="sr-only peer" />
                                <div class="checkout-pro__pay-card">
                                    <div>
                                        <img src="/brand/paypal-logo.svg" alt="PayPal" width="90" height="22" />
                                        <div class="checkout-pro__pay-title">PayPal · USD</div>
                                        <p>US / rest of world. Canadian PayPal — Visa surcharge capped at 2.4%.</p>
                                    </div>
                                    <div class="checkout-pro__pay-amt">
                                        <strong>$@Model.PayPalUsdTotal.ToString("0.00")</strong>
                                        <span>incl. 2.4%</span>
                                    </div>
                                </div>
                            </label>
                            <label>
                                <input type="radio" name="PaymentMethod" value="PayPalCad" class="sr-only peer" />
                                <div class="checkout-pro__pay-card">
                                    <div>
                                        <img src="/brand/paypal-logo.svg" alt="PayPal" width="90" height="22" />
                                        <div class="checkout-pro__pay-title">PayPal · CAD</div>
                                        <p>Canada. Visa/PayPal surcharge capped at 2.4%.</p>
                                    </div>
                                    <div class="checkout-pro__pay-amt">
                                        <strong>C$@Model.PayPalCadTotal.ToString("0.00")</strong>
                                        <span>incl. 2.4%</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </section>

                    <button type="submit" id="checkout-submit" class="checkout-pro__submit">
                        Pay with Yape — S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")
                    </button>
                    <p class="checkout-pro__trust">Encrypted payment · WhatsApp confirmation · 12-hour booking cutoff</p>
                </form>
            </div>

            <aside class="checkout-pro__aside">
                <div class="checkout-pro__receipt">
                    <h2>Order summary</h2>
                    <div class="checkout-pro__lines">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="checkout-pro__line">
                                <div class="checkout-pro__thumb">
                                    <img src="@item.ImageUrl" alt="" onerror="this.style.display='none'">
                                </div>
                                <div class="checkout-pro__line-copy">
                                    <div>@item.ProductName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small>@item.Description</small>
                                    }
                                    else
                                    {
                                        <small>× @item.Quantity</small>
                                    }
                                </div>
                                <div class="checkout-pro__line-price">$@item.Subtotal.ToString("0.00")</div>
                            </div>
                        }
                    </div>
                    <div class="checkout-pro__totals">
                        <div><span>Subtotal</span>
                            <span class="money-pair">
                                <strong>$@Model.CartTotal.ToString("0.00")</strong>
                                <span>S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")</span>
                            </span>
                        </div>
                        <div class="checkout-pro__paypair">
                            <div>
                                <span>Cash price</span>
                                <strong>S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")</strong>
                            </div>
                            <div>
                                <span>Card · Perú</span>
                                <strong>S/@LocalPricing.CulqiSoles(Model.CartTotal).ToString("0")</strong>
                            </div>
                        </div>
                    </div>
                    <p class="checkout-pro__receipt-note">Cash / Yape / Plin is the local price. Perú cards use the card price. PayPal is listed USD or CAD.</p>
                    @if (Model.HasCoffeeItems)
                    {
                        <div class="mt-6">
                            <partial name="_CoffeeLabBoard" model="Model.LabBoard" />
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CulqiReady)
    {
        <script src="https://checkout.culqi.com/js/v4"></script>
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const firstName = document.getElementById('FirstName');
            const lastName = document.getElementById('LastName');
            const fullName = document.getElementById('FullName');

            function updateFullName() {
                if (!fullName) return;
                fullName.value = ((firstName?.value || '') + ' ' + (lastName?.value || '')).trim();
            }

            firstName?.addEventListener('input', updateFullName);
            lastName?.addEventListener('input', updateFullName);

            const submit = document.getElementById('checkout-submit');
            const form = document.getElementById('checkout-form');
            const tokenInput = document.getElementById('CulqiToken');
            const yapeTotal = 'S/@LocalPricing.YapeSoles(Model.CartTotal).ToString("0")';
            const culqiTotal = 'S/@Model.CulqiTotalSoles.ToString("0")';
            const paypalUsdTotal = '$@Model.PayPalUsdTotal.ToString("0.00")';
            const paypalCadTotal = 'C$@Model.PayPalCadTotal.ToString("0.00")';
            const culqiReady = @(Model.CulqiReady ? "true" : "false");

            function selectedMethod() {
                return document.querySelector('input[name="PaymentMethod"]:checked')?.value;
            }

            function syncSubmitLabel() {
                if (!submit) return;
                const method = selectedMethod();
                if (method === 'Yape') submit.textContent = 'Pay with Yape — ' + yapeTotal;
                else if (method === 'Culqi') submit.textContent = 'Pay with Culqi — ' + culqiTotal;
                else if (method === 'PayPalUsd') submit.textContent = 'Pay with PayPal — ' + paypalUsdTotal;
                else if (method === 'PayPalCad' || method === 'PayPal') submit.textContent = 'Pay with PayPal — ' + paypalCadTotal;
            }

            document.querySelectorAll('input[name="PaymentMethod"]').forEach(function (input) {
                input.addEventListener('change', syncSubmitLabel);
            });
            syncSubmitLabel();

            function configureCulqi() {
                if (typeof Culqi === 'undefined') return false;
                Culqi.publicKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CulqiPublicKey ?? ""));
                const settings = {
                    title: 'Purple Bean Coffee',
                    currency: 'PEN',
                    amount: @Model.CulqiAmountCentimos
                };
                @if (!string.IsNullOrWhiteSpace(Model.CulqiRsaId) && !string.IsNullOrWhiteSpace(Model.CulqiRsaPublicKey))
                {
                    <text>
                    settings.xculqirsaid = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CulqiRsaId));
                    settings.rsapublickey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CulqiRsaPublicKey));
                    </text>
                }
                Culqi.settings(settings);
                Culqi.options({
                    lang: 'auto',
                    installments: false,
                    paymentMethods: {
                        tarjeta: true,
                        yape: false,
                        bancaMovil: false,
                        agente: false,
                        billetera: false,
                        cuotealo: false
                    }
                });
                return true;
            }

            window.culqi = function () {
                if (typeof Culqi === 'undefined') return;
                if (Culqi.token && Culqi.token.id) {
                    tokenInput.value = Culqi.token.id;
                    try { Culqi.close(); } catch (e) {}
                    form.submit();
                } else if (Culqi.error) {
                    const msg = Culqi.error.user_message || Culqi.error.merchant_message || 'Culqi could not tokenize the card.';
                    alert(msg);
                }
            };

            form?.addEventListener('submit', function (e) {
                updateFullName();
                if (selectedMethod() !== 'Culqi') return;
                if (tokenInput.value) return;
                e.preventDefault();
                if (!culqiReady || !configureCulqi()) {
                    alert('Culqi is not connected yet. Use Yape for now.');
                    return;
                }
                Culqi.open();
            });
        });
    </script>
}
