<div class="row mb-4">
    <div class="col-12">
        <form class="p-4 border rounded bg-light" method="get">
            <div class="row g-3 align-items-end">
                
                <!-- Search Field -->
                <div class="col-md-3">
                    <label for="searchString" class="form-label fw-bold">Search (Name/Farm/Flavor)</label>
                    <input type="text" class="form-control" id="searchString" name="SearchString" placeholder="Enter name, farm, or flavor profile" asp-for="SearchString">
                </div>
                
                <!-- Origin Country Filter -->
                <div class="col-md-3">
                    <label for="filterOrigin" class="form-label fw-bold">Origin</label>
                    <select class="form-select" id="filterOrigin" name="OriginCountry">
                        <option selected value="">All Countries</option>
                        <option value="Peru">Peru</option>
                        <option value="Colombia">Colombia (Coming Soon)</option>
                    </select>
                </div>
                
                <!-- Region Filter -->
                <div class="col-md-3">
                    <label for="filterRegion" class="form-label fw-bold">Region</label>
                    <select class="form-select" id="filterRegion" name="CoffeeRegion">
                        <option selected value="">All Regions</option>
                        <!-- Peru Regions -->
                        <optgroup label="Peru">
                            <option value="La Convención, Cusco">La Convención, Cusco</option>
                            <option value="Junín">Junín</option>
                            <option value="San Martín">San Martín</option>
                            <option value="Cajamarca">Cajamarca</option>
                            <option value="Pasco (Villa Rica)">Pasco (Villa Rica)</option>
                            <option value="Amazonas (Rodriguez de Mendoza)">Amazonas (Rodriguez de Mendoza)</option>
                            <option value="Huanuco">Huauco</option>
                        </optgroup>
                        <!-- Colombia Regions -->
                        <optgroup label="Colombia (Coming Soon)">
                            <option value="Huila [Pitalito]">Huila [Pitalito]</option>
                            <option value="Nariño">Nariño</option>
                        </optgroup>
                    </select>
                </div>
                
                <!-- Create Button -->
                <div class="col-md-2 d-grid">
                    <a href="/CoffeeBeans/Create" class="btn btn-success btn-sm fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> New Bean
                    </a>
                </div>
                
                <!-- Filter Button -->
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Filter</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Coffee Regions Map (HTML Image Map) -->
<div class="row mb-4">
    <div class="col-12">
        <div class="border rounded" style="overflow:hidden; background:#f8f9fa;">
            <div style="text-align: center; padding: 15px 0 10px 0;">
                <h3 class="h5 mb-2">Click on a region to explore coffee beans</h3>
                <p class="small text-muted mb-0">Hover over regions to see their names</p>
            </div>
            <div style="position: relative; display: flex; justify-content: center; align-items: center; padding: 20px;">
                <div style="position: relative; display: inline-block;">
                    <img src="/Media/peru_map.webp" 
                         alt="Peru Coffee Regions Map" 
                         usemap="#peru-coffee-map"
                         style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; display: block;"
                         id="peru-map-image">
                    
                    <!-- Note: Coordinates need to be updated to match actual regions on the image -->
                    <!-- Use an image map tool like https://www.image-map.net/ to get accurate coordinates -->
                    <map name="peru-coffee-map" id="peru-coffee-map">
                        <!-- Cusco Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="200,300,250,280,280,300,270,350,240,360,200,340" 
                              href="#"
                              alt="Cusco Region"
                              data-region="La Convención, Cusco"
                              title="Cusco Region - Click to filter">
                        
                        <!-- Junín Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="300,200,350,190,380,220,370,280,330,290,300,250" 
                              href="#"
                              alt="Junín Region"
                              data-region="Junín"
                              title="Junín Region - Click to filter">
                        
                        <!-- San Martín Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="250,100,320,90,350,130,340,180,300,190,250,150" 
                              href="#"
                              alt="San Martín Region"
                              data-region="San Martín"
                              title="San Martín Region - Click to filter">
                        
                        <!-- Cajamarca Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="150,80,220,70,250,110,240,160,200,170,150,130" 
                              href="#"
                              alt="Cajamarca Region"
                              data-region="Cajamarca"
                              title="Cajamarca Region - Click to filter">
                        
                        <!-- Pasco Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="280,250,330,240,360,270,350,320,310,330,280,300" 
                              href="#"
                              alt="Pasco Region"
                              data-region="Pasco (Villa Rica)"
                              title="Pasco Region - Click to filter">
                        
                        <!-- Amazonas Region - UPDATE COORDINATES -->
                        <area shape="poly" 
                              coords="200,50,280,40,310,80,300,130,260,140,200,100" 
                              href="#"
                              alt="Amazonas Region"
                              data-region="Amazonas (Rodriguez de Mendoza)"
                              title="Amazonas Region - Click to filter">
                    </map>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-center gap-3 mt-2 mb-3 small flex-wrap" style="padding: 0 15px;">
                <div class="d-flex align-items-center"><span style="display:inline-block;width:14px;height:14px;background:#2e7d32;border:1px solid #556;margin-right:6px;"></span> Arabica</div>
                <div class="d-flex align-items-center"><span style="display:inline-block;width:14px;height:14px;background:#1565c0;border:1px solid #556;margin-right:6px;"></span> Robusta</div>
                <div class="d-flex align-items-center"><span style="display:inline-block;width:14px;height:14px;background:#8e24aa;border:1px solid #556;margin-right:6px;"></span> Both</div>
                <div class="d-flex align-items-center"><span style="display:inline-block;width:14px;height:14px;background:#cfd8dc;border:1px solid #556;margin-right:6px;"></span> Not a producer</div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Map area hover effects */
    map area {
        cursor: pointer;
    }
    
    /* Visual feedback for map regions */
    #peru-map-image {
        transition: opacity 0.3s ease;
    }
    
    map area:hover ~ #peru-map-image,
    #peru-map-image:hover {
        opacity: 0.9;
    }
</style>

<script>
    // Handle image map clicks to filter coffee beans
    document.addEventListener('DOMContentLoaded', function() {
        const mapAreas = document.querySelectorAll('map[name="peru-coffee-map"] area');
        const mapImage = document.getElementById('peru-map-image');
        
        // Get image dimensions for coordinate scaling
        let imageWidth = 0;
        let imageHeight = 0;
        
        if (mapImage) {
            mapImage.addEventListener('load', function() {
                imageWidth = this.naturalWidth || this.offsetWidth;
                imageHeight = this.naturalHeight || this.offsetHeight;
            });
        }
        
        mapAreas.forEach(area => {
            // Enhanced hover effect
            area.addEventListener('mouseenter', function() {
                this.style.cursor = 'pointer';
                if (mapImage) {
                    mapImage.style.filter = 'brightness(1.05)';
                }
            });
            
            area.addEventListener('mouseleave', function() {
                if (mapImage) {
                    mapImage.style.filter = 'brightness(1)';
                }
            });
            
            // Click handler
            area.addEventListener('click', function(e) {
                e.preventDefault();
                const region = this.getAttribute('data-region');
                
                if (region) {
                    // Set the region filter dropdown
                    const regionSelect = document.getElementById('filterRegion');
                    if (regionSelect) {
                        // Find and select the matching option
                        for (let option of regionSelect.options) {
                            if (option.value === region || option.text.includes(region.split(',')[0])) {
                                regionSelect.value = option.value;
                                break;
                            }
                        }
                        
                        // Submit the form to filter results
                        const form = regionSelect.closest('form');
                        if (form) {
                            form.submit();
                        }
                    }
                }
            });
        });
        
        // Add click coordinate logger for debugging (remove in production)
        if (mapImage) {
            mapImage.addEventListener('click', function(e) {
                const rect = this.getBoundingClientRect();
                const x = Math.round(e.clientX - rect.left);
                const y = Math.round(e.clientY - rect.top);
                console.log(`Map click coordinates: ${x}, ${y}`);
            });
        }
    });
</script>

<!-- Peru + Global Narrative -->
<div class="row mb-5">
    <div class="col-12">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-body p-5">
                <div class="row align-items-center g-4">
                    <div class="col-lg-6">
                        <h2 class="display-6 text-dark d-flex align-items-center gap-2 mb-3">
                            🌱 Know Your Bean
                        </h2>
                        <p class="lead text-secondary mb-3">
                            Discover the flavors, regions, and stories behind Peru’s finest coffees.
                        </p>
                        <p class="text-muted">
                            Every coffee bean tells a story — from the altitude of its birthplace to the way it’s processed
                            and roasted. Peru’s rugged geography gives birth to beans with striking diversity: delicate
                            florals from Cusco’s misty valleys, chocolatey depth from Chanchamayo, and bright fruit from
                            Cajamarca’s highlands. This guide walks you through the most common bean varieties grown
                            throughout Peru and what makes each one taste the way it does.
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-light border rounded-4 p-4 h-100 d-flex flex-column justify-content-center text-center">
                            <h3 class="h5 text-uppercase text-primary mb-3">Peru vs Global Profile</h3>
                            <p class="text-muted mb-3">
                                Peru balances the vibrancy of Latin America with altitude-driven elegance. Compare it to
                                the best coffees of the world — and you’ll see why Peru sits at the crossroads of the world’s favorite cup
                                profiles.
                            </p>
                            <div class="d-flex justify-content-center gap-3 flex-wrap">
                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">Altitude 1,200–2,000 m</span>
                                <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2">Arabica Heritage</span>
                                <span class="badge rounded-pill bg-info-subtle text-info px-3 py-2">Shade Grown</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-5">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white dark:bg-[#121014] border-0 pb-0">
                <h3 class="h4 text-dark mb-2">🫘 Peru’s Key Coffee Varieties</h3>
                <p class="text-muted mb-0">From heirloom Arabicas to hardy hybrids, each variety contributes a distinct sensory profile.</p>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Variety</th>
                                <th>Character</th>
                                <th>Typical Flavors</th>
                                <th>Ideal Roast</th>
                                <th>Best Brew</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Typica</strong></td>
                                <td>The classic Arabica — elegant and balanced.</td>
                                <td>Clean sweetness, mild acidity, cocoa, citrus, floral hints.</td>
                                <td>Medium</td>
                                <td>Pour-over, Chemex</td>
                            </tr>
                            <tr>
                                <td><strong>Bourbon</strong></td>
                                <td>Rich and expressive; genetic cousin to Typica.</td>
                                <td>Caramel, red fruit, soft florals, medium body.</td>
                                <td>Medium-light</td>
                                <td>French Press, Drip</td>
                            </tr>
                            <tr>
                                <td><strong>Caturra</strong></td>
                                <td>Compact and bright; vivid acidity and clarity.</td>
                                <td>Lemon zest, berry, light chocolate, floral.</td>
                                <td>Light</td>
                                <td>V60, Aeropress</td>
                            </tr>
                            <tr>
                                <td><strong>Pache</strong></td>
                                <td>A rare Peruvian mutation with subtle charm.</td>
                                <td>Sweet, mild, floral, soft nutty tones.</td>
                                <td>Light-medium</td>
                                <td>Pour-over, Moka pot</td>
                            </tr>
                            <tr>
                                <td><strong>Catimor</strong></td>
                                <td>Hardy hybrid, earthy and bold.</td>
                                <td>Cocoa, nut, mild fruit; heavier body.</td>
                                <td>Medium-dark</td>
                                <td>Espresso, Moka</td>
                            </tr>
                            <tr>
                                <td><strong>Mundo Novo</strong></td>
                                <td>Balanced and round — Bourbon × Typica cross.</td>
                                <td>Chocolate, hazelnut, dried fruit.</td>
                                <td>Medium</td>
                                <td>Espresso, Drip</td>
                            </tr>
                            <tr>
                                <td><strong>Geisha</strong></td>
                                <td>The jewel of specialty coffee.</td>
                                <td>Jasmine, bergamot, tropical fruit, honey.</td>
                                <td>Light</td>
                                <td>Pour-over, Syphon</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-5 g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white dark:bg-[#121014] border-0 pb-0">
                <h3 class="h4 text-dark mb-2">🌄 Regions of Peru & Their Flavor Signatures</h3>
                <p class="text-muted mb-0">Altitude, microclimate, and soil chemistry shape the cup — each region has a distinctive voice.</p>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Region</th>
                                <th>Altitude</th>
                                <th>Signature Notes</th>
                                <th>Highlights</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Cusco (La Convención, Yanatile, Santa Teresa)</strong></td>
                                <td>1,200–1,900 m</td>
                                <td>Floral, red fruit, caramel, chocolate</td>
                                <td>Crisp acidity, clean sweetness, vibrant and complex cups.</td>
                            </tr>
                            <tr>
                                <td><strong>Cajamarca (Jaén, San Ignacio)</strong></td>
                                <td>1,600–2,000 m</td>
                                <td>Bright citrus, stone fruit, floral</td>
                                <td>Among Peru’s most awarded coffees; high cup clarity.</td>
                            </tr>
                            <tr>
                                <td><strong>Junín / Chanchamayo</strong></td>
                                <td>1,200–1,800 m</td>
                                <td>Nutty, chocolate, citrus</td>
                                <td>Smooth, balanced, classic “Peruvian cup.”</td>
                            </tr>
                            <tr>
                                <td><strong>San Martín / Amazonas</strong></td>
                                <td>1,200–1,700 m</td>
                                <td>Red berries, cocoa, molasses</td>
                                <td>Sweeter, heavier body; rustic fruit-forward profiles.</td>
                            </tr>
                            <tr>
                                <td><strong>Puno (Sandia Valley, near Lake Titicaca)</strong></td>
                                <td>1,500–2,000 m</td>
                                <td>Tea-like florals, citrus, honey, caramel</td>
                                <td>Elegant, delicate, exceptional altitude-driven flavor.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-5 g-4">
    <div class="col-12 col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white dark:bg-[#121014] border-0 pb-0">
                <h3 class="h4 text-dark mb-2">⚗️ Processing & Its Impact</h3>
