@page
@model TheBestBean.Pages.CoffeeBeans.IndexModel

@{
    ViewData["Title"] = "Coffee Bean Explorer";
}

@await Html.PartialAsync("_PageHeader")

<!-- Search and Filter Section -->
<style>
