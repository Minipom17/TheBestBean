<!-- Table for Coffee Listings -->
<h2 class="h4 text-dark mb-3 mt-4">Available Coffee Beans</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle border">
                <thead class="bg-primary text-white">
                    <tr>
                        <th scope="col">Coffee Name / Variety</th>
                        <th scope="col">Farm / Finca</th>
                        <th scope="col">Flavor Profile</th>
                        <th scope="col" style="white-space: nowrap;">Rating (1-5)</th>
                        <th scope="col">Origin</th>
                        <th scope="col">Region</th>
                        <th scope="col" style="white-space: nowrap;">Actions</th>
                    </tr>
                </thead>
        <tbody>
            @if (Model.CoffeeBean != null)
            {
                @foreach (var item in Model.CoffeeBean)
                {
                    <tr>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.CoffeeFarm.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.FlavorProfile)</td>
                        <td>@Html.DisplayFor(modelItem => item.Rating) <i class="bi bi-star-fill text-warning"></i></td>
                        <td>@Html.DisplayFor(modelItem => item.OriginCountry.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.CoffeeRegion.Name)</td>
                        @await Html.PartialAsync("_ActionButtons", item)
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        <i class="bi bi-cup-straw me-2"></i>
                        No coffee beans found. <a href="/CoffeeBeans/Create">Add your first coffee bean</a> to get started!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
