                                <th>Result</th>
                                <th>Best Highlights</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Washed (Wet)</strong></td>
                                <td>Clean, bright, crisp acidity</td>
