@page
@model TheBestBean.Pages.ExperiencesModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Coffee Experiences in Cusco";
    ViewData["MetaDescription"] = "Book coffee experiences in Peru: Cusco workshops, a Santa Teresa cloud-forest farm on the Machu Picchu corridor, and a Cup of Excellence farm visit in Jaén, Cajamarca.";
    ViewData["MetaImage"] = "https://purplebean.coffee/brand/og-share.jpg?v=2";
}
@Html.AntiForgeryToken()

@functions {
    public static string GetTimeCategory(string duration) {
        if (string.IsNullOrEmpty(duration)) return "all";
        var d = duration.ToLower();
        if (d.Contains("1 hour")) return "1-hour";
        if (d.Contains("2.5") || d.Contains("2") || d.Contains("3") || d.Contains("4")) return "2-5-hours";
        if (d.Contains("day") && !d.Contains("days") && !d.Contains("multi")) return "day";
        if (d.Contains("days") || d.Contains("multi")) return "multi-day";
        return "all";
    }

    public static string ShortDuration(string duration)
    {
        if (string.IsNullOrEmpty(duration)) return "";
        return duration.Replace("HOURS", "HRS", StringComparison.OrdinalIgnoreCase)
            .Replace("HOUR", "HR", StringComparison.OrdinalIgnoreCase);
    }
}

<!-- MAIN CONTENT CONTAINER (Swiss Master Architecture) -->
<div class="experiences-page flex-grow max-w-[1600px] mx-auto w-full px-6 md:px-12 relative pb-24 font-sans text-v-black dark:text-[#D6D0C8] overflow-x-clip">

    <!-- MAIN CONTENT GRID -->
    <main class="flex flex-col gap-32 md:gap-48 pt-8">
        
        <!-- SECTION: URBAN LABS -->
        <section aria-labelledby="workshops-heading" class="exp-section">
            
            <!-- Sticky Left Title & Filters -->
            <div class="exp-section__nav lg:sticky lg:top-32 h-max z-10">
                <div class="w-16 h-4 bg-v-yellow mb-5 md:mb-8"></div>
                <h2 id="workshops-heading" class="text-4xl md:text-5xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] leading-[0.9]" data-entity-id="Experiences_UrbanLabs_Title" data-entity-type="SiteContent" data-editable="Value">
                    @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_UrbanLabs_Title", "WORKSHOPS"))
                </h2>
                <span id="urban-location-subtitle" class="text-[10px] font-bold uppercase tracking-widest text-v-gray mt-3 md:mt-6 font-mono-jb block">All</span>
                
                <div class="mt-3 md:mt-5 exp-filters font-mono-jb lg:w-full" aria-label="Workshop filters">
                    <partial name="_ExpLocationFilters" model='"urban-location-filters"' />

                    <div class="exp-filter-row mt-8">
                        <span class="exp-filter-label exp-filter-label--emoji" title="Time" aria-hidden="true">⏱️</span>
                        <div class="exp-when" id="urban-time-filters" role="group" aria-label="Filter by time">
                            <button type="button" class="exp-when-btn filter-btn active" data-filter="all">All</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="1-hour">1 hour</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="2-5-hours">2.5 hours</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="day">day</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="multi-day">multi-day</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Content Container -->
            <div class="exp-section__main flex flex-col gap-16 min-w-0" id="urban-labs-container">
                @{
                    var hourOrder = new[] { "Peru Tasting Hour", "Brew Your Own", "Introduction to Cupping" };
                    var urbanLabs = Model.ExperiencesList
                        .Where(e => e.Category == "Urban Workshops" && ExperienceGeo.IsWorkshopPlace(e))
                        .ToList();
                    var hourLabs = hourOrder
                        .Select(title => urbanLabs.FirstOrDefault(e => e.Title == title))
                        .Where(e => e != null)
                        .Cast<Experience>()
                        .ToList();
                    var featuredLab = urbanLabs.FirstOrDefault(e => e.Tag == "FEATURED");
                    var regularLabs = urbanLabs.Where(e => e.Tag != "FEATURED" && !hourOrder.Contains(e.Title)).ToList();
                }

                @if (featuredLab != null)
                {
                    var featuredGeo = ExperienceGeo.Locate(featuredLab);
                    <article class="lab-item flex flex-col group w-full" data-region="@featuredGeo.Region" data-place="@featuredGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(featuredLab.Month)" data-time="@GetTimeCategory(featuredLab.Duration)">
                        <!-- Carousel Container -->
                        @{
                            var featuredPhotos = (featuredLab.GalleryImages != null && featuredLab.GalleryImages.Any())
                                ? featuredLab.GalleryImages
                                : (string.IsNullOrWhiteSpace(featuredLab.ImageUrl) ? new List<string>() : new List<string> { featuredLab.ImageUrl });
                        }
                        <div class="exp-carousel w-full aspect-[16/9] md:aspect-[2/1] bg-gray-100 dark:bg-[#1C191F] mb-8 overflow-hidden rounded-3xl relative" data-carousel-id="@featuredLab.Id">
                            <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@featuredLab.Id" data-current="0">
                                @foreach (var img in featuredPhotos)
                                {
                                    <img src="@img" alt="@featuredLab.Title" class="img-stark w-full h-full object-cover flex-shrink-0" draggable="false" loading="lazy" />
                                }
                            </div>
                            <div class="absolute top-3 right-3 bg-v-yellow text-v-black rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm z-10 pointer-events-none">FEATURED</div>
                            
                            @if (featuredPhotos.Count > 1)
                            {
                                <!-- Carousel Controls -->
                                <button type="button" aria-label="Previous Image" onclick="moveCarousel(@featuredLab.Id, -1, event)" class="exp-carousel__btn absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-left text-xl"></i>
                                </button>
                                <button type="button" aria-label="Next Image" onclick="moveCarousel(@featuredLab.Id, 1, event)" class="exp-carousel__btn absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-right text-xl"></i>
                                </button>
                            }
                        </div>

                        <a href="@ExperienceUrls.PublicPath(featuredLab)" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                            <div class="exp-meta-line">
                                <div class="w-3 h-3 bg-v-yellow shrink-0"></div>
                                <span class="text-v-black dark:text-[#D6D0C8] shrink-0">@ShortDuration(featuredLab.Duration)</span>
                                <span class="text-[#722EA8] shrink-0">@(Model.NextSlotLabels.GetValueOrDefault(featuredLab.Id, "Pick a date"))</span>
                                <span class="exp-meta-line__venue"><partial name="_VenueLine" model="featuredLab" /></span>
                            </div>
                            <div class="exp-dossier flex-grow">
                                <div class="flex flex-col min-w-0">
                                    <h3 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4 m-0 break-words">@featuredLab.Title</h3>
                                    <p class="text-v-gray text-base leading-relaxed mb-6 font-normal">
                                        @featuredLab.Description
                                    </p>

                                    @if (featuredLab.ProvidedEquipment != null && featuredLab.ProvidedEquipment.Any())
                                    {
                                        <div class="relative mt-2 mb-8 font-sans">
                                            <div class="absolute -top-3 left-6 bg-[#722EA8] text-white text-[10px] font-semibold px-2 py-0.5 z-10 uppercase tracking-widest">
                                                what you get
                                            </div>
                                            <div class="border border-[#722EA8] relative p-6 pt-8">
                                                <div class="absolute -top-1 -left-1 w-2 h-2 bg-[#722EA8]"></div>
                                                <div class="absolute -top-1 -right-1 w-2 h-2 bg-[#722EA8]"></div>
                                                <div class="absolute -bottom-1 -left-1 w-2 h-2 bg-[#722EA8]"></div>
                                                <div class="absolute -bottom-1 -right-1 w-2 h-2 bg-[#722EA8]"></div>
                                                <ul class="list-none p-0 m-0 space-y-3 font-mono-jb text-[11px] text-v-gray">
                                                    @for (int i = 0; i < featuredLab.ProvidedEquipment.Count; i++)
                                                    {
                                                        <li class="flex items-start gap-2">
                                                            <span class="text-v-black dark:text-[#D6D0C8] font-bold mt-0.5">@(i + 1).</span>
                                                            <span class="leading-relaxed">@featuredLab.ProvidedEquipment[i]</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                    <div class="flex items-center gap-6 mt-auto">
                                        <span class="bg-v-black text-v-white px-8 py-4 font-bold uppercase tracking-widest text-[10px] group-hover:bg-v-yellow group-hover:text-v-black transition-colors font-mono-jb">
                                            VIEW DETAILS
                                        </span>
                                        <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = featuredLab.Price }" />
                                    </div>
                                </div>

                                <div class="flex flex-col font-mono-jb min-w-0 mt-8 md:mt-[4.5rem]">
                                    <h4 class="text-[10px] font-bold uppercase tracking-widest text-v-gray mb-2">SYLLABUS</h4>
                                    <div class="flex flex-col border-t border-v-black dark:border-[#2A262C] font-sans">
                                        @if (featuredLab.Syllabus != null && featuredLab.Syllabus.Any())
                                        {
                                            for (int i = 0; i < featuredLab.Syllabus.Count; i++)
                                            {
                                                var isLast = i == featuredLab.Syllabus.Count - 1;
                                                var paddingClasses = isLast ? "pt-1 pb-0" : "pt-1 pb-3 border-b border-v-light-gray";
                                                var syllabusRow = SyllabusParser.Parse(featuredLab.Syllabus[i], i);
                                                <div class="@paddingClasses">
                                                    <partial name="_SyllabusRow" model="syllabusRow" />
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </article>
                }

                @if (hourLabs.Any())
                {
                    <div class="flex flex-col gap-6">
                        <div class="font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">1-hour workshops · Cusco City</div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
                            @foreach (var exp in hourLabs)
                            {
                                var labGeo = ExperienceGeo.Locate(exp);
                                <article class="hour-lab-card lab-item flex flex-col group" data-region="@labGeo.Region" data-place="@labGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)" data-time="@GetTimeCategory(exp.Duration)">
                                    @{
                                        var hourPhotos = (exp.GalleryImages != null && exp.GalleryImages.Any())
                                            ? exp.GalleryImages
                                            : (string.IsNullOrWhiteSpace(exp.ImageUrl) ? new List<string>() : new List<string> { exp.ImageUrl });
                                    }
                                    <div class="exp-carousel w-full aspect-[15/11] bg-gray-100 dark:bg-[#1C191F] mb-5 overflow-hidden rounded-3xl relative" data-carousel-id="@exp.Id">
                                        @if (hourPhotos.Any())
                                        {
                                            <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@exp.Id" data-current="0">
                                                @foreach (var img in hourPhotos)
                                                {
                                                    <img src="@img" alt="@exp.Title" class="img-stark w-full h-full object-cover flex-shrink-0" draggable="false" loading="lazy" />
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="absolute inset-0 flex items-center justify-center font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">Photos soon</div>
                                        }
                                        <div class="absolute top-3 right-3 bg-v-yellow text-v-black rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest z-10 pointer-events-none">1 HR</div>
                                        @if (hourPhotos.Count > 1)
                                        {
                                            <button type="button" aria-label="Previous Image" onclick="moveCarousel(@exp.Id, -1, event)" class="exp-carousel__btn absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 text-white w-8 h-8 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                                <i class="bi bi-chevron-left text-base"></i>
                                            </button>
                                            <button type="button" aria-label="Next Image" onclick="moveCarousel(@exp.Id, 1, event)" class="exp-carousel__btn absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 text-white w-8 h-8 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                                <i class="bi bi-chevron-right text-base"></i>
                                            </button>
                                        }
                                    </div>
                                    <a href="@ExperienceUrls.PublicPath(exp)" class="hour-lab-card__body text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col group">
                                        <div class="hour-lab-card__meta">
                                            <div class="w-1.5 h-1.5 bg-v-yellow shrink-0"></div>
                                            <span class="text-v-black dark:text-[#D6D0C8]">@ShortDuration(exp.Duration)</span>
                                            <span class="text-gray-300">/</span>
                                            <span class="text-[#722EA8]">@(Model.NextSlotLabels.GetValueOrDefault(exp.Id))</span>
                                        </div>
                                        <h3 class="hour-lab-card__title text-xl md:text-2xl font-semibold tracking-tight text-v-black dark:text-[#D6D0C8] m-0 mb-2">
                                        @{
                                            var titleParts = exp.Title.Split('[');
                                            if (titleParts.Length > 1)
                                            {
                                                <text>@titleParts[0].Trim() <span class="text-[0.55em] text-v-gray font-normal tracking-normal ml-0 md:ml-2 block sm:inline">[@titleParts[1]</span></text>
                                            }
                                            else
                                            {
                                                @exp.Title
                                            }
                                        }
                                    </h3>
                                        <p class="hour-lab-card__venue"><partial name="_VenueLine" model="exp" /></p>
                                        <p class="hour-lab-card__copy text-v-gray text-sm leading-relaxed font-normal">@exp.Description</p>
                                        <div class="hour-lab-card__price flex items-center justify-between font-mono-jb">
                                            <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = exp.Price, Compact = true }" />
                                            <span class="text-sm font-bold">Reserve <span class="ml-1">&rarr;</span></span>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    </div>
                }

                @if (regularLabs.Any())
                {
                    <div class="flex flex-col gap-24 md:gap-32 mt-8" id="urban-labs-grid">
                        @foreach (var exp in regularLabs)
                        {
                            var labGeo = ExperienceGeo.Locate(exp);
                            <article class="lab-item flex flex-col group" data-region="@labGeo.Region" data-place="@labGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)" data-time="@GetTimeCategory(exp.Duration)">
                                @{
                                    var expPhotos = (exp.GalleryImages != null && exp.GalleryImages.Any())
                                        ? exp.GalleryImages
                                        : (string.IsNullOrWhiteSpace(exp.ImageUrl) ? new List<string>() : new List<string> { exp.ImageUrl });
                                }
                                <div class="exp-carousel w-full aspect-[16/9] md:aspect-[2/1] bg-gray-100 dark:bg-[#1C191F] mb-8 overflow-hidden rounded-3xl relative" data-carousel-id="@exp.Id">
                                    <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@exp.Id" data-current="0">
                                        @foreach (var img in expPhotos)
                                        {
                                            <img src="@img" alt="@exp.Title" class="img-stark w-full h-full object-cover flex-shrink-0" draggable="false" loading="lazy" />
                                        }
                                    </div>
                                    @if (exp.Tag != null)
                                    {
                                        <div class="absolute top-3 right-3 bg-red-600 text-white rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm z-10 pointer-events-none" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Tag">@exp.Tag</div>
                                    }
                                    @if (expPhotos.Count > 1)
                                    {
                                        <button type="button" aria-label="Previous Image" onclick="moveCarousel(@exp.Id, -1, event)" class="exp-carousel__btn absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                            <i class="bi bi-chevron-left text-xl"></i>
                                        </button>
                                        <button type="button" aria-label="Next Image" onclick="moveCarousel(@exp.Id, 1, event)" class="exp-carousel__btn absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                            <i class="bi bi-chevron-right text-xl"></i>
                                        </button>
                                    }
                                </div>

                                <a href="@ExperienceUrls.PublicPath(exp)" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                                    <div class="exp-meta-line">
                                        <div class="w-1.5 h-1.5 bg-[#F05A28] shrink-0"></div>
                                        <span class="text-v-black dark:text-[#D6D0C8] shrink-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Duration">@ShortDuration(exp.Duration)</span>
                                        <span class="text-[#722EA8] shrink-0">@(Model.NextSlotLabels.GetValueOrDefault(exp.Id))</span>
                                        <span class="exp-meta-line__venue" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Location"><partial name="_VenueLine" model="exp" /></span>
                                    </div>
                                    <div class="exp-dossier flex-grow">
                                        <div class="flex flex-col min-w-0">
                                            <h3 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4 m-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Title">
                                          @{
                                              var titleParts = exp.Title.Split('[');
                                              if (titleParts.Length > 1)
                                              {
                                                  <text>@titleParts[0].Trim() <span class="text-[0.6em] text-v-gray font-normal tracking-normal ml-0 md:ml-2 block sm:inline">[@titleParts[1]</span></text>
                                              }
                                              else
                                              {
                                                  @exp.Title
                                              }
                                          }
                                      </h3>
                                            <p class="text-v-gray text-base leading-relaxed mb-10 font-normal" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Description">
                                                @exp.Description
                                            </p>
                                            <div class="flex items-center gap-6 mt-auto">
                                                <span class="bg-v-black text-v-white px-8 py-4 font-bold uppercase tracking-widest text-[10px] group-hover:bg-[#F05A28] transition-colors font-mono-jb">
                                                    VIEW DETAILS
                                                </span>
                                                <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = exp.Price }" />
                                            </div>
                                        </div>
                                        <div class="flex flex-col font-mono-jb min-w-0 mt-8 md:mt-[4.5rem]">
                                            <h4 class="text-[10px] font-bold uppercase tracking-widest text-v-gray mb-2">SYLLABUS</h4>
                                            <div class="flex flex-col border-t border-v-black dark:border-[#2A262C] font-sans">
                                                @if (exp.Syllabus != null && exp.Syllabus.Any())
                                                {
                                                    for (int i = 0; i < exp.Syllabus.Count; i++)
                                                    {
                                                        var isLast = i == exp.Syllabus.Count - 1;
                                                        var paddingClasses = isLast ? "pt-1 pb-0" : "pt-1 pb-3 border-b border-v-light-gray";
                                                        var syllabusRow = SyllabusParser.Parse(exp.Syllabus[i], i);
                                                        <div class="@paddingClasses">
                                                            <partial name="_SyllabusRow" model="syllabusRow" />
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-sm font-normal text-v-gray py-4">Syllabus details available upon request.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        }
                    </div>
                }
        </section>

        <!-- SECTION: EXPEDITIONS -->
        <section aria-labelledby="expeditions-heading" class="exp-section">
            
            <!-- Sticky Left Title & Filters -->
            <div class="exp-section__nav lg:sticky lg:top-32 h-max z-10">
                <div class="w-16 h-4 bg-v-red mb-5 md:mb-8"></div>
                <h2 id="expeditions-heading" class="text-5xl md:text-6xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] leading-[0.9]" data-entity-id="Experiences_Expeditions_Title" data-entity-type="SiteContent" data-editable="Value">
                    @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_Expeditions_Title", "ORIGIN <span class='text-lg md:text-2xl text-gray-400 dark:text-gray-500 font-light font-mono-tech tracking-widest uppercase inline-block ml-2'>EXPEDITIONS</span>"))
                </h2>
                <a asp-page="/OriginMap" id="expedition-location-subtitle" class="text-[12px] md:text-[10px] font-bold uppercase tracking-widest text-v-gray hover:text-v-red mt-3 md:mt-6 font-mono-jb text-decoration-none cursor-pointer transition-colors">All</a>

                <div class="mt-3 md:mt-5 exp-filters font-mono-jb w-full" aria-label="Expedition filters">
                    <partial name="_ExpLocationFilters" model='"expedition-location-filters"' />

                    <div class="exp-filter-row mt-8">
                        <span class="exp-filter-label exp-filter-label--emoji" title="Time" aria-hidden="true">⏱️</span>
                        <div class="exp-when" id="expedition-time-filters" role="group" aria-label="Filter by time">
                            <button type="button" class="exp-when-btn filter-btn active" data-filter="all">All</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="1-hour">1 hour</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="2-5-hours">2.5 hours</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="day">day</button>
                            <button type="button" class="exp-when-btn filter-btn" data-filter="multi-day">multi-day</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Content Column (8 Columns stacked) -->
            <div class="exp-section__main flex flex-col gap-24 md:gap-32 min-w-0" id="expeditions-list">
                @foreach (var exp in Model.ExperiencesList.Where(e => e.Category == "Expedition" && ExperienceGeo.IsExpeditionPlace(e)))
                {
                    var expeditionGeo = ExperienceGeo.Locate(exp);
                    <article class="expedition-item flex flex-col group" data-region="@expeditionGeo.Region" data-place="@expeditionGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)" data-time="@GetTimeCategory(exp.Duration)">
                        @{
                            var expeditionPhotos = (exp.GalleryImages != null && exp.GalleryImages.Any())
                                ? exp.GalleryImages
                                : (string.IsNullOrWhiteSpace(exp.ImageUrl) ? new List<string>() : new List<string> { exp.ImageUrl });
                        }
                        <div class="exp-carousel w-full aspect-[16/9] md:aspect-[2/1] bg-gray-100 dark:bg-[#1C191F] mb-8 overflow-hidden rounded-3xl relative" data-carousel-id="@exp.Id">
                            <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@exp.Id" data-current="0">
                                @foreach (var img in expeditionPhotos)
                                {
                                    <img src="@img" alt="@exp.Title" class="img-stark w-full h-full object-cover flex-shrink-0" draggable="false" loading="lazy" />
                                }
                            </div>
                            @if (exp.Tag != null)
                            {
                                <div class="absolute top-3 right-3 bg-red-600 text-white rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm z-10 pointer-events-none" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Tag">@exp.Tag</div>
                            }
                            @if (expeditionPhotos.Count > 1)
                            {
                                <button type="button" aria-label="Previous Image" onclick="moveCarousel(@exp.Id, -1, event)" class="exp-carousel__btn absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-left text-xl"></i>
                                </button>
                                <button type="button" aria-label="Next Image" onclick="moveCarousel(@exp.Id, 1, event)" class="exp-carousel__btn absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-right text-xl"></i>
                                </button>
                            }
                        </div>

                        <a href="@ExperienceUrls.PublicPath(exp)" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                            <div class="exp-meta-line">
                                <div class="w-3 h-3 bg-v-red shrink-0"></div>
                                <span class="text-v-black dark:text-[#D6D0C8] shrink-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Duration">@ShortDuration(exp.Duration)</span>
                                <span class="text-[#722EA8] shrink-0">@(Model.NextSlotLabels.GetValueOrDefault(exp.Id))</span>
                                <span class="exp-meta-line__venue" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Location"><partial name="_VenueLine" model="exp" /></span>
                            </div>
                            <div class="exp-dossier flex-grow">
                                <div class="flex flex-col min-w-0">
                                    <h3 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4 m-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Title">
                                        @{
                                            var titleParts = exp.Title.Split('[');
                                            if (titleParts.Length > 1)
                                            {
                                                <text>@titleParts[0].Trim() <span class="text-[0.55em] text-v-gray font-normal tracking-normal ml-0 md:ml-2 block sm:inline">[@titleParts[1]</span></text>
                                            }
                                            else
                                            {
                                                @exp.Title
                                            }
                                        }
                                    </h3>
                                    <p class="text-v-gray text-base leading-relaxed mb-10 font-normal" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Description">
                                        @exp.Description
                                    </p>
                                    <div class="flex items-center gap-6 mt-auto">
                                        <span class="bg-v-black text-v-white px-8 py-4 font-bold uppercase tracking-widest text-[10px] group-hover:bg-v-red transition-colors font-mono-jb" data-entity-id="Experiences_ViewDossierButton" data-entity-type="SiteContent" data-editable="Value">
                                            @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_ViewDossierButton", "VIEW DOSSIER"))
                                        </span>
                                        <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = exp.Price }" />
                                    </div>
                                </div>
                                <div class="flex flex-col font-mono-jb min-w-0">
                                    <h4 class="text-[10px] font-bold uppercase tracking-widest text-v-gray mb-2">SYLLABUS</h4>
                                    <div class="flex flex-col border-t border-v-black dark:border-[#2A262C] font-sans">
                                        @if (exp.Syllabus != null && exp.Syllabus.Any())
                                        {
                                            for (int i = 0; i < exp.Syllabus.Count; i++)
                                            {
                                                var isLast = i == exp.Syllabus.Count - 1;
                                                var paddingClasses = isLast ? "pt-1 pb-0" : "pt-1 pb-3 border-b border-v-light-gray";
                                                var syllabusRow = SyllabusParser.Parse(exp.Syllabus[i], i);
                                                <div class="@paddingClasses">
                                                    <partial name="_SyllabusRow" model="syllabusRow" />
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-sm font-normal text-v-gray py-4">Syllabus details available upon request.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </article>
                }

            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            function setActiveFilter(buttons, activeBtn) {
                buttons.forEach(b => b.classList.remove('active'));
                activeBtn.classList.add('active');
            }

            function locationLabel(btn) {
                return (btn?.textContent || 'All').replace(/\s+/g, ' ').trim();
            }

            function bindFilterGroup(selector, onChange) {
                const buttons = document.querySelectorAll(selector);
                buttons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        setActiveFilter(buttons, btn);
                        onChange(btn.getAttribute('data-filter'), btn);
                    });
                });
                return buttons;
            }

            function matchesGeo(item, filter) {
                if (!filter || filter === 'all') return true;
                if (filter.startsWith('region:')) {
                    return (item.getAttribute('data-region') || '') === filter.slice(7);
                }
                if (filter.startsWith('place:')) {
                    return (item.getAttribute('data-place') || '') === filter.slice(6);
                }
                return false;
            }

                        const labItems = document.querySelectorAll('.lab-item');
            let currentUrbanLocation = 'all';
            let currentUrbanFrequency = 'all';
            let currentUrbanTime = 'all';

            function filterUrbanLabs() {
                labItems.forEach(item => {
                    const itemFrequency = item.getAttribute('data-frequency') || 'all';
                    const itemTime = item.getAttribute('data-time') || 'all';
                    const matchesLocation = matchesGeo(item, currentUrbanLocation);
                    const matchesFrequency = currentUrbanFrequency === 'all' || itemFrequency === currentUrbanFrequency;
                    const matchesTime = currentUrbanTime === 'all' || itemTime === currentUrbanTime;
                    item.style.display = (matchesLocation && matchesFrequency && matchesTime) ? 'flex' : 'none';
                });
            }

            bindFilterGroup('#urban-location-filters .filter-btn', (value, btn) => {
                currentUrbanLocation = value;
                const subtitle = document.getElementById('urban-location-subtitle');
                if (subtitle) subtitle.textContent = locationLabel(btn);
                filterUrbanLabs();
            });
            bindFilterGroup('#urban-frequency-filters .filter-btn', value => {
                currentUrbanFrequency = value;
                filterUrbanLabs();
            });
            bindFilterGroup('#urban-time-filters .filter-btn', value => {
                currentUrbanTime = value;
                filterUrbanLabs();
            });

            const expeditionItems = document.querySelectorAll('.expedition-item');
            let currentExpeditionLocation = 'all';
            let currentExpeditionFrequency = 'all';
            let currentExpeditionTime = 'all';

            function filterExpeditions() {
                expeditionItems.forEach(item => {
                    const itemFrequency = item.getAttribute('data-frequency') || 'all';
                    const itemTime = item.getAttribute('data-time') || 'all';
                    const matchesLocation = matchesGeo(item, currentExpeditionLocation);
                    const matchesFrequency = currentExpeditionFrequency === 'all' || itemFrequency === currentExpeditionFrequency;
                    const matchesTime = currentExpeditionTime === 'all' || itemTime === currentExpeditionTime;
                    item.style.display = (matchesLocation && matchesFrequency && matchesTime) ? 'flex' : 'none';
                });
            }

            bindFilterGroup('#expedition-location-filters .filter-btn', (value, btn) => {
                currentExpeditionLocation = value;
                const subtitle = document.getElementById('expedition-location-subtitle');
                if (subtitle) subtitle.textContent = locationLabel(btn);
                filterExpeditions();
            });
            bindFilterGroup('#expedition-frequency-filters .filter-btn', value => {
                currentExpeditionFrequency = value;
                filterExpeditions();
            });
            bindFilterGroup('#expedition-time-filters .filter-btn', value => {
                currentExpeditionTime = value;
                filterExpeditions();
            });
        });
    </script>
    <script src="~/js/exp-carousel.js" asp-append-version="true"></script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ItemList",
      "itemListElement": [
        @for(var i = 0; i < Model.ExperiencesList.Count; i++)
        {
            var exp = Model.ExperiencesList[i];
            <text>
            {
              "@@type": "ListItem",
              "position": @(i + 1),
              "item": {
                "@@type": "Service",
                "name": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(exp.Title))",
                "description": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(exp.Description))",
                "image": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(exp.ImageUrl))",
                "url": "https://purplebean.coffee@ExperienceUrls.PublicPath(exp)"
              }
            }
            @(i < Model.ExperiencesList.Count - 1 ? "," : "")
            </text>
        }
      ]
    }
    </script>
}
 
