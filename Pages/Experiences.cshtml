@page
@model TheBestBean.Pages.ExperiencesModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Coffee Experiences in Cusco";
    ViewData["MetaDescription"] = "Book coffee experiences in Peru: Cusco workshops, a Santa Teresa cloud-forest farm on the Machu Picchu corridor, and a Cup of Excellence farm visit in Jaén, Cajamarca.";
    ViewData["MetaImage"] = "https://purplebean.coffee/images/og-logo.png";
}
@Html.AntiForgeryToken()

<!-- MAIN CONTENT CONTAINER (Swiss Master Architecture) -->
<div class="flex-grow max-w-[1600px] mx-auto w-full px-6 md:px-12 relative pb-24 font-sans text-v-black dark:text-[#D6D0C8]">

    <!-- MAIN CONTENT GRID -->
    <main class="flex flex-col gap-32 md:gap-48 pt-8">
        
        <!-- SECTION: URBAN LABS -->
        <section aria-labelledby="workshops-heading" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 relative">
            
            <!-- Sticky Left Title & Filters (4 Columns) -->
            <div class="lg:col-span-4 flex flex-col items-start lg:sticky lg:top-32 h-max z-10">
                <div class="w-16 h-4 bg-v-yellow mb-5 md:mb-8"></div>
                <h2 id="workshops-heading" class="text-4xl md:text-5xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] leading-[0.9]" data-entity-id="Experiences_UrbanLabs_Title" data-entity-type="SiteContent" data-editable="Value">
                    @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_UrbanLabs_Title", "WORKSHOPS"))
                </h2>
                <span class="text-[10px] font-bold uppercase tracking-widest text-v-gray mt-3 md:mt-6 font-mono-jb block" data-entity-id="Experiences_UrbanLabs_Subtitle" data-entity-type="SiteContent" data-editable="Value">CUSCO</span>
                
                <div class="mt-3 md:mt-5 exp-filters font-mono-jb lg:w-full" aria-label="Workshop filters">
                    <div class="exp-filter-row">
                        <span class="exp-filter-label">Location</span>
                        <div class="exp-geo" id="urban-location-filters" role="group" aria-label="Filter by location">
                            <button type="button" class="exp-geo-all filter-btn active" data-filter="all">All</button>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-cusco filter-btn" data-filter="region:cusco">Cusco</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:city">City</button>
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:calca">Calca</button>
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:santa-teresa">Santa Teresa</button>
                                </div>
                            </div>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-lima filter-btn" data-filter="region:lima">Lima</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:barranco">Barranco</button>
                                </div>
                            </div>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-cajamarca filter-btn" data-filter="region:cajamarca">Cajamarca</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:jaen">Jaén</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="exp-filter-row">
                        <span class="exp-filter-label">When</span>
                        <div class="exp-when" id="urban-frequency-filters" role="group" aria-label="Filter by schedule">
                            <button type="button" class="exp-when-btn filter-btn active" data-filter="all">All</button>
                            @foreach (var when in Model.ExperiencesList
                                .Where(e => e.Category == "Urban Workshops" && !string.IsNullOrEmpty(e.Month) && !ExperienceGeo.IsMonWed(e.Month))
                                .Select(e => ExperienceGeo.WhenKey(e.Month))
                                .Where(k => !string.IsNullOrWhiteSpace(k))
                                .Distinct())
                            {
                                <button type="button" class="exp-when-btn filter-btn" data-filter="@when">@ExperienceGeo.WhenLabel(when)</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Content Container -->
            <div class="lg:col-span-8 flex flex-col gap-16" id="urban-labs-container">
                @{
                    var hourOrder = new[] { "Peru Tasting Hour", "Brew Your Own", "Introduction to Cupping" };
                    var urbanLabs = Model.ExperiencesList.Where(e => e.Category == "Urban Workshops").ToList();
                    var hourLabs = hourOrder
                        .Select(title => urbanLabs.FirstOrDefault(e => e.Title == title))
                        .Where(e => e != null)
                        .Cast<Experience>()
                        .ToList();
                    var featuredLab = urbanLabs.FirstOrDefault(e => e.Tag == "FEATURED");
                    var regularLabs = urbanLabs.Where(e => e.Tag != "FEATURED" && !hourOrder.Contains(e.Title)).ToList();
                }

                @if (hourLabs.Any())
                {
                    <div class="flex flex-col gap-6">
                        <div class="font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">1-hour workshops · Cusco</div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
                            @foreach (var exp in hourLabs)
                            {
                                var labGeo = ExperienceGeo.Locate(exp);
                                <article class="lab-item flex flex-col group" data-region="@labGeo.Region" data-place="@labGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)">
                                    <a asp-page="/Tour" asp-route-id="@exp.Id" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                                        <div class="w-full aspect-[3/2] bg-gray-100 dark:bg-[#1C191F] mb-5 overflow-hidden rounded-3xl relative">
                                            @if (!string.IsNullOrWhiteSpace(exp.ImageUrl))
                                            {
                                                <img src="@exp.ImageUrl" alt="@exp.Title" class="img-stark absolute inset-0 w-full h-full object-cover" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="absolute inset-0 flex items-center justify-center font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">Photos soon</div>
                                            }
                                            <div class="absolute top-3 right-3 bg-v-yellow text-v-black rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest">1 HOUR</div>
                                        </div>
                                        <div class="flex items-center gap-2 font-mono-jb text-[10px] font-bold tracking-widest uppercase mb-2">
                                            <div class="w-1.5 h-1.5 bg-v-yellow"></div>
                                            <span class="text-v-black dark:text-[#D6D0C8]">@exp.Duration</span>
                                            <span class="text-gray-300">/</span>
                                            <span class="text-v-gray">@exp.Difficulty</span>
                                        </div>
                                        <h3 class="text-xl md:text-2xl font-semibold tracking-tight text-v-black dark:text-[#D6D0C8] m-0 mb-3">@exp.Title</h3>
                                        <p class="text-v-gray text-sm leading-relaxed mb-5 pb-5 border-b border-v-black/10 dark:border-[#2A262C] font-normal flex-grow">@exp.Description</p>
                                        <div class="flex items-center justify-between mt-auto font-mono-jb">
                                            <span class="text-lg font-bold text-v-black dark:text-[#D6D0C8]">S/ @LocalPricing.YapeSoles(exp.Price).ToString("0") <span class="text-xs font-normal text-v-gray">Yape</span> <span class="text-sm font-normal text-v-gray">/ $@exp.Price</span></span>
                                            <span class="text-sm font-bold">Reserve <span class="ml-1">&rarr;</span></span>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    </div>
                }

                @if (featuredLab != null)
                {
                    var featuredGeo = ExperienceGeo.Locate(featuredLab);
                    <article class="lab-item flex flex-col group w-full" data-region="@featuredGeo.Region" data-place="@featuredGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(featuredLab.Month)">
                        <!-- Carousel Container -->
                        <div class="w-full aspect-[21/9] bg-gray-100 dark:bg-[#1C191F] mb-8 overflow-hidden rounded-3xl relative">
                            <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@featuredLab.Id" data-current="0">
                                @if (featuredLab.GalleryImages != null && featuredLab.GalleryImages.Any())
                                {
                                    foreach (var img in featuredLab.GalleryImages)
                                    {
                                        <img src="@img" alt="@featuredLab.Title" class="img-stark w-full h-full object-cover flex-shrink-0" loading="lazy" />
                                    }
                                }
                                else
                                {
                                    <img src="@featuredLab.ImageUrl" alt="@featuredLab.Title" class="img-stark w-full h-full object-cover flex-shrink-0" loading="lazy" />
                                }
                            </div>
                            <div class="absolute top-3 right-3 bg-v-yellow text-v-black rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm">FEATURED</div>
                            
                            <!-- Carousel Controls -->
                            <button aria-label="Previous Image" onclick="moveCarousel(@featuredLab.Id, -1)" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                <i class="bi bi-chevron-left text-xl"></i>
                            </button>
                            <button aria-label="Next Image" onclick="moveCarousel(@featuredLab.Id, 1)" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                <i class="bi bi-chevron-right text-xl"></i>
                            </button>
                        </div>

                        <!-- Data Grid splits inside -->
                        <a asp-page="/Tour" asp-route-id="@featuredLab.Id" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 flex-grow">
                                <!-- Left: Content & Button -->
                                <div class="md:col-span-7 flex flex-col">
                                    <div class="flex items-center gap-3 mb-4 font-mono-jb">
                                        <div class="w-3 h-3 bg-v-yellow"></div>
                                        <span class="text-[10px] font-bold uppercase tracking-widest text-v-black dark:text-[#D6D0C8]">@featuredLab.Duration</span>
                                        @if (!string.IsNullOrEmpty(featuredLab.Month) && !ExperienceGeo.IsMonWed(featuredLab.Month))
                                        {
                                            <span class="text-[10px] font-bold tracking-widest uppercase text-v-gray">@featuredLab.Month</span>
                                        }
                                        <span class="text-[10px] font-bold tracking-widest uppercase">@featuredLab.Location</span>
                                    </div>
                                    <h3 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4 m-0">@featuredLab.Title</h3>
                                    <p class="text-v-gray text-base leading-relaxed mb-6 font-normal max-w-xl">
                                        @featuredLab.Description
                                    </p>

                                    <!-- What You Get Box -->
                                    @if (featuredLab.ProvidedEquipment != null && featuredLab.ProvidedEquipment.Any())
                                    {
                                        <div class="relative mt-2 mb-8 max-w-xl font-sans">
                                            <!-- Top Tag -->
                                            <div class="absolute -top-3 left-6 bg-[#FF3B1F] text-white text-[10px] font-semibold px-2 py-0.5 z-10 uppercase tracking-widest">
                                                what you get
                                            </div>
                                            
                                            <!-- Main Box -->
                                            <div class="border border-[#FF3B1F] relative p-6 pt-8">
                                                <!-- Corner Nodes -->
                                                <div class="absolute -top-1 -left-1 w-2 h-2 bg-[#FF3B1F]"></div>
                                                <div class="absolute -top-1 -right-1 w-2 h-2 bg-[#FF3B1F]"></div>
                                                <div class="absolute -bottom-1 -left-1 w-2 h-2 bg-[#FF3B1F]"></div>
                                                <div class="absolute -bottom-1 -right-1 w-2 h-2 bg-[#FF3B1F]"></div>
                                                
                                                <!-- List -->
                                                <ul class="list-none p-0 m-0 space-y-3 font-mono-jb text-[11px] text-v-gray">
                                                    @for (int i = 0; i < featuredLab.ProvidedEquipment.Count; i++)
                                                    {
                                                        <li class="flex items-start gap-2">
                                                            <span class="text-v-black dark:text-[#D6D0C8] font-bold mt-0.5">@(i + 1).</span>
                                                            <span class="leading-relaxed">@featuredLab.ProvidedEquipment[i]</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                    <div class="flex items-center gap-6 mt-auto">
                                        <span class="bg-v-black text-v-white px-8 py-4 font-bold uppercase tracking-widest text-[10px] group-hover:bg-v-yellow group-hover:text-v-black transition-colors font-mono-jb">
                                            VIEW DETAILS
                                        </span>
                                        <span class="text-2xl font-semibold text-v-black dark:text-[#D6D0C8] font-mono-jb">S/ @LocalPricing.YapeSoles(featuredLab.Price).ToString("0") <span class="text-xs font-normal text-v-gray">Yape</span> · $@featuredLab.Price.ToString("0") card</span>
                                    </div>
                                </div>

                                <!-- Right: Syllabus -->
                                <div class="md:col-span-5 flex flex-col pt-2 md:pt-0 font-mono-jb">
                                    <h4 class="text-[10px] font-bold uppercase tracking-widest text-v-gray mb-4">SYLLABUS</h4>
                                    <div class="flex flex-col border-t border-v-black dark:border-[#2A262C] font-sans">
                                        @if (featuredLab.Syllabus != null && featuredLab.Syllabus.Any())
                                        {
                                            for (int i = 0; i < featuredLab.Syllabus.Count; i++)
                                            {
                                                var isLast = i == featuredLab.Syllabus.Count - 1;
                                                var paddingClasses = isLast ? "pt-4 pb-0" : "py-4 border-b border-v-light-gray";
                                                <div class="flex flex-col gap-1 @paddingClasses">
                                                    <span class="font-mono text-[10px] font-bold text-v-black dark:text-[#D6D0C8] uppercase tracking-widest">PART 0@(i + 1)</span>
                                                    <span class="text-sm @(isLast ? "font-semibold text-v-black dark:text-[#D6D0C8]" : "font-normal text-v-gray")">@featuredLab.Syllabus[i]</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </article>
                }

                @if (regularLabs.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16" id="urban-labs-grid">
                        @foreach (var exp in regularLabs)
                        {
                            var labGeo = ExperienceGeo.Locate(exp);
                            <article class="lab-item flex flex-col group" data-region="@labGeo.Region" data-place="@labGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)">
                                <a asp-page="/Tour" asp-route-id="@exp.Id" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                                    <div class="w-full aspect-[3/2] bg-gray-100 dark:bg-[#1C191F] mb-6 overflow-hidden rounded-3xl relative @(exp.Tag != null ? "border border-red-200" : "")">
                                        @if (!string.IsNullOrWhiteSpace(exp.ImageUrl))
                                        {
                                            <img src="@exp.ImageUrl" alt="@exp.Title" class="img-stark absolute inset-0 w-full h-full object-cover" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="ImageUrl" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="absolute inset-0 flex items-center justify-center font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">Photos soon</div>
                                        }
                                        @if (exp.Tag != null)
                                        {
                                            <div class="absolute top-3 right-3 bg-red-600 text-white rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Tag">@exp.Tag</div>
                                        }
                                    </div>
                                    <div class="flex flex-col mb-4">
                                        <div class="flex items-center gap-2 font-mono-jb text-[10px] font-bold tracking-widest uppercase mb-2">
                                            <div class="w-1.5 h-1.5 bg-[#F05A28]"></div>
                                            <span class="text-gray-300">/</span>
                                            <span class="text-v-black dark:text-[#D6D0C8]" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Location">@exp.Location</span>
                                            <span class="text-gray-500" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Month">@exp.Month</span>
                                            <span class="text-gray-300">/</span>
                                            <span class="text-[#F05A28]" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Difficulty">@exp.Difficulty</span>
                                        </div>
                                        <h3 class="text-2xl md:text-3xl font-semibold tracking-tight text-v-black dark:text-[#D6D0C8] m-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Title">@exp.Title</h3>
                                    </div>
                                    <p class="text-v-gray text-sm md:text-base leading-relaxed mb-6 pb-6 border-b border-v-black/10 dark:border-[#2A262C] font-normal flex-grow" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Description">
                                        @exp.Description
                                    </p>
                                    <div class="flex items-center justify-between mt-auto pt-4 font-mono-jb">
                                        <span class="text-2xl font-bold text-v-black dark:text-[#D6D0C8]">S/ @LocalPricing.YapeSoles(exp.Price).ToString("0") <span class="text-xs font-normal text-v-gray">Yape</span> <span class="text-sm font-normal text-v-gray">/ $<span data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Price">@exp.Price</span></span></span>
                                        <span class="text-sm font-bold text-v-black dark:text-[#D6D0C8] hover:text-v-gray transition-colors flex items-center">
                                            Reserve <span class="ml-2 transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                                        </span>
                                    </div>
                                </a>
                            </article>
                        }
                    </div>
                }
        </section>

        <!-- SECTION: EXPEDITIONS -->
        <section aria-labelledby="expeditions-heading" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 relative">
            
            <!-- Sticky Left Title & Filters (4 Columns) -->
            <div class="lg:col-span-4 flex flex-col items-start lg:sticky lg:top-32 h-max z-10">
                <div class="w-16 h-4 bg-v-red mb-5 md:mb-8"></div>
                <h2 id="expeditions-heading" class="text-5xl md:text-6xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] leading-[0.9]" data-entity-id="Experiences_Expeditions_Title" data-entity-type="SiteContent" data-editable="Value">
                    @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_Expeditions_Title", "ORIGIN <span class=\"text-lg md:text-2xl text-gray-400 dark:text-gray-500 font-light font-mono-tech tracking-widest uppercase inline-block ml-2\">EXPEDITIONS</span>"))
                </h2>
                <a asp-page="/OriginMap" class="text-[12px] md:text-[10px] font-bold uppercase tracking-widest text-v-gray hover:text-v-red mt-3 md:mt-6 font-mono-jb text-decoration-none cursor-pointer transition-colors" data-entity-id="Experiences_Expeditions_Subtitle" data-entity-type="SiteContent" data-editable="Value">@Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_Expeditions_Subtitle", "SANTA TERESA · CAJAMARCA"))</a>

                <div class="mt-3 md:mt-5 exp-filters font-mono-jb w-full" aria-label="Expedition filters">
                    <div class="exp-filter-row">
                        <span class="exp-filter-label">Location</span>
                        <div class="exp-geo" id="expedition-location-filters" role="group" aria-label="Filter by location">
                            <button type="button" class="exp-geo-all filter-btn active" data-filter="all">All</button>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-cusco filter-btn" data-filter="region:cusco">Cusco</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:city">City</button>
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:calca">Calca</button>
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:santa-teresa">Santa Teresa</button>
                                </div>
                            </div>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-lima filter-btn" data-filter="region:lima">Lima</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:barranco">Barranco</button>
                                </div>
                            </div>
                            <div class="exp-geo-region">
                                <button type="button" class="exp-geo-region-name is-cajamarca filter-btn" data-filter="region:cajamarca">Cajamarca</button>
                                <div class="exp-geo-places">
                                    <button type="button" class="exp-geo-place filter-btn" data-filter="place:jaen">Jaén</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="exp-filter-row">
                        <span class="exp-filter-label">When</span>
                        <div class="exp-when" id="expedition-frequency-filters" role="group" aria-label="Filter by schedule">
                            <button type="button" class="exp-when-btn filter-btn active" data-filter="all">All</button>
                            @foreach (var when in Model.ExperiencesList
                                .Where(e => e.Category == "Expedition" && !string.IsNullOrEmpty(e.Month) && !ExperienceGeo.IsMonWed(e.Month))
                                .Select(e => ExperienceGeo.WhenKey(e.Month))
                                .Where(k => !string.IsNullOrWhiteSpace(k))
                                .Distinct())
                            {
                                <button type="button" class="exp-when-btn filter-btn" data-filter="@when">@ExperienceGeo.WhenLabel(when)</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Content Column (8 Columns stacked) -->
            <div class="lg:col-span-8 flex flex-col gap-24 md:gap-32" id="expeditions-list">
                @foreach (var exp in Model.ExperiencesList.Where(e => e.Category == "Expedition"))
                {
                    var expeditionGeo = ExperienceGeo.Locate(exp);
                    <article class="expedition-item flex flex-col group" data-region="@expeditionGeo.Region" data-place="@expeditionGeo.PlaceKey" data-frequency="@ExperienceGeo.WhenKey(exp.Month)">
                        @{
                            var expeditionPhotos = (exp.GalleryImages != null && exp.GalleryImages.Any())
                                ? exp.GalleryImages
                                : (string.IsNullOrWhiteSpace(exp.ImageUrl) ? new List<string>() : new List<string> { exp.ImageUrl });
                        }
                        <div class="w-full aspect-[21/9] bg-gray-100 dark:bg-[#1C191F] mb-8 overflow-hidden rounded-3xl relative">
                            <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@exp.Id" data-current="0">
                                @foreach (var img in expeditionPhotos)
                                {
                                    <img src="@img" alt="@exp.Title" class="img-stark w-full h-full object-cover flex-shrink-0" loading="lazy" />
                                }
                            </div>
                            @if (exp.Tag != null)
                            {
                                <div class="absolute top-3 right-3 bg-red-600 text-white rounded-full px-3 py-1 text-[9px] font-mono-jb font-bold uppercase tracking-widest shadow-sm z-10" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Tag">@exp.Tag</div>
                            }
                            @if (expeditionPhotos.Count > 1)
                            {
                                <button type="button" aria-label="Previous Image" onclick="moveCarousel(@exp.Id, -1)" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-left text-xl"></i>
                                </button>
                                <button type="button" aria-label="Next Image" onclick="moveCarousel(@exp.Id, 1)" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                                    <i class="bi bi-chevron-right text-xl"></i>
                                </button>
                            }
                        </div>

                        <a asp-page="/Tour" asp-route-id="@exp.Id" class="text-decoration-none text-slate-900 dark:text-[#D6D0C8] flex flex-col h-full group">
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 flex-grow">
                                <!-- Left: Content & Button -->
                                <div class="md:col-span-7 flex flex-col">
                                    <div class="flex items-center gap-3 mb-4 font-mono-jb">
                                        <div class="w-3 h-3 bg-v-red"></div>
                                        <span class="text-[10px] font-bold uppercase tracking-widest text-v-black dark:text-[#D6D0C8]" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Duration">@exp.Duration</span>
                                        @if (!string.IsNullOrEmpty(exp.Month) && !ExperienceGeo.IsMonWed(exp.Month))
                                        {
                                            <span class="text-[10px] font-bold tracking-widest uppercase text-v-gray" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Month">@exp.Month</span>
                                        }
                                        <span class="text-[10px] font-bold tracking-widest uppercase" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Location">@exp.Location</span>
                                    </div>
                                    <h3 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4 m-0" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Title">@exp.Title</h3>
                                    <p class="text-v-gray text-base leading-relaxed mb-10 font-normal max-w-xl" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Description">
                                        @exp.Description
                                    </p>
                                    <div class="flex items-center gap-6 mt-auto">
                                        <span class="bg-v-black text-v-white px-8 py-4 font-bold uppercase tracking-widest text-[10px] group-hover:bg-v-red transition-colors font-mono-jb" data-entity-id="Experiences_ViewDossierButton" data-entity-type="SiteContent" data-editable="Value">
                                            @Html.Raw(Model.PageContent.GetValueOrDefault("Experiences_ViewDossierButton", "VIEW DOSSIER"))
                                        </span>
                                        <span class="text-2xl font-semibold text-v-black dark:text-[#D6D0C8] font-mono-jb">$<span data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Price">@exp.Price</span> USD</span>
                                    </div>
                                </div>

                                <!-- Right: Timeline / Syllabus -->
                                <div class="md:col-span-5 flex flex-col pt-2 md:pt-0 font-mono-jb">
                                    <h4 class="text-[10px] font-bold uppercase tracking-widest text-v-gray mb-4">SYLLABUS</h4>
                                    <div class="flex flex-col border-t border-v-black dark:border-[#2A262C] font-sans">
                                        @if (exp.Syllabus != null && exp.Syllabus.Any())
                                        {
                                            for (int i = 0; i < exp.Syllabus.Count; i++)
                                            {
                                                var isLast = i == exp.Syllabus.Count - 1;
                                                var paddingClasses = isLast ? "pt-4 pb-0" : "py-4 border-b border-v-light-gray";
                                                
                                                <div class="flex flex-col gap-1 @paddingClasses">
                                                    <span class="font-mono text-[10px] font-bold text-v-black dark:text-[#D6D0C8] uppercase tracking-widest">STEP 0@(i + 1)</span>
                                                    <span class="text-sm @(isLast ? "font-semibold text-v-black dark:text-[#D6D0C8]" : "font-normal text-v-gray")">@exp.Syllabus[i]</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-sm font-normal text-v-gray py-4">Syllabus details available upon request.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </article>
                }

            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            function setActiveFilter(buttons, activeBtn) {
                buttons.forEach(b => b.classList.remove('active'));
                activeBtn.classList.add('active');
                if (typeof activeBtn.scrollIntoView === 'function') {
                    activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
                }
            }

            function bindFilterGroup(selector, onChange) {
                const buttons = document.querySelectorAll(selector);
                buttons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        setActiveFilter(buttons, btn);
                        onChange(btn.getAttribute('data-filter'));
                    });
                });
                return buttons;
            }

            function matchesGeo(item, filter) {
                if (!filter || filter === 'all') return true;
                if (filter.startsWith('region:')) {
                    return (item.getAttribute('data-region') || '') === filter.slice(7);
                }
                if (filter.startsWith('place:')) {
                    return (item.getAttribute('data-place') || '') === filter.slice(6);
                }
                return false;
            }

            const labItems = document.querySelectorAll('.lab-item');
            let currentUrbanLocation = 'all';
            let currentUrbanFrequency = 'all';

            function filterUrbanLabs() {
                labItems.forEach(item => {
                    const itemFrequency = item.getAttribute('data-frequency') || 'all';
                    const matchesLocation = matchesGeo(item, currentUrbanLocation);
                    const matchesFrequency = currentUrbanFrequency === 'all' || itemFrequency === currentUrbanFrequency;
                    item.style.display = (matchesLocation && matchesFrequency) ? 'flex' : 'none';
                });
            }

            bindFilterGroup('#urban-location-filters .filter-btn', value => {
                currentUrbanLocation = value;
                filterUrbanLabs();
            });
            bindFilterGroup('#urban-frequency-filters .filter-btn', value => {
                currentUrbanFrequency = value;
                filterUrbanLabs();
            });

            const expeditionItems = document.querySelectorAll('.expedition-item');
            let currentExpeditionLocation = 'all';
            let currentExpeditionFrequency = 'all';

            function filterExpeditions() {
                expeditionItems.forEach(item => {
                    const itemFrequency = item.getAttribute('data-frequency') || 'all';
                    const matchesLocation = matchesGeo(item, currentExpeditionLocation);
                    const matchesFrequency = currentExpeditionFrequency === 'all' || itemFrequency === currentExpeditionFrequency;
                    item.style.display = (matchesLocation && matchesFrequency) ? 'flex' : 'none';
                });
            }

            bindFilterGroup('#expedition-location-filters .filter-btn', value => {
                currentExpeditionLocation = value;
                filterExpeditions();
            });
            bindFilterGroup('#expedition-frequency-filters .filter-btn', value => {
                currentExpeditionFrequency = value;
                filterExpeditions();
            });
        });

        // Global carousel function for featured workshops
        window.moveCarousel = function(id, direction) {
            // Prevent event from bubbling up to the anchor tag to avoid navigation
            event.preventDefault();
            event.stopPropagation();
            
            const container = document.getElementById('carousel-' + id);
            if (!container) return;
            
            const images = container.querySelectorAll('img');
            const total = images.length;
            if (total <= 1) return;
            
            let current = parseInt(container.getAttribute('data-current') || '0');
            current = (current + direction + total) % total;
            container.setAttribute('data-current', current.toString());
            
            // Move container by -100% * current
            container.style.transform = `translateX(-${current * 100}%)`;
        };
    </script>
}
