@page
@model TheBestBean.Pages.FarmerSurveys.DeleteModel
@{
    ViewData["Title"] = "Delete Survey";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h1 class="card-title h4 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Delete Farmer Survey
                    </h1>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this farmer survey?
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-danger">Survey to be deleted:</h5>
                        <div class="bg-light p-3 rounded">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Farm:</strong> @Html.DisplayFor(model => model.FarmerSurvey.FarmName)<br>
                                    <strong>Farmer:</strong> @Html.DisplayFor(model => model.FarmerSurvey.FarmerName)<br>
                                    <strong>Region:</strong> @Html.DisplayFor(model => model.FarmerSurvey.Region)
                                </div>
                                <div class="col-md-6">
                                    <strong>Survey Date:</strong> @Html.DisplayFor(model => model.FarmerSurvey.SurveyDate)<br>
                                    <strong>Elevation:</strong> @Html.DisplayFor(model => model.FarmerSurvey.ElevationMeters) m<br>
                                    @if (Model.FarmerSurvey.QualityRating.HasValue)
                                    {
                                        <strong>Quality Rating:</strong> @Model.FarmerSurvey.QualityRating<text>/10</text>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="FarmerSurvey.Id" />
                        <div class="d-flex justify-content-center">
                            <button type="submit" class="btn btn-danger me-3">
                                <i class="bi bi-trash me-2"></i>Yes, Delete Survey
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-primary">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
