@page
@model TheBestBean.Pages.FarmerSurveys.IndexModel
@{
    ViewData["Title"] = "Farmer Surveys";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 fw-bold mb-0">
                        <i class="bi bi-clipboard-data me-2"></i>Farmer Surveys
                    </h1>
                    <p class="text-muted mb-0">Comprehensive farm data collection</p>
                </div>
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-2"></i>Add New Survey
                </a>
            </div>
        </div>
    </div>

    <!-- Search Section -->
    @if (!string.IsNullOrEmpty(Model.SearchString))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info d-flex align-items-center">
                    <i class="bi bi-search me-2"></i>
                    <div class="flex-grow-1">
                        <strong>Search Results:</strong> Showing farmer surveys matching "<strong>@Model.SearchString</strong>"
                    </div>
                    <a asp-page="./Index" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-x-lg me-1"></i>Clear Search
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Search Form -->
    <div class="row mb-4">
        <div class="col-12">
            <form class="p-3 border rounded bg-light" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label for="searchString" class="form-label">Search Farmer Surveys</label>
                        <input type="text" class="form-control" id="searchString" name="SearchString" 
                               placeholder="Enter farm name, farmer name, or region..." 
                               asp-for="SearchString">
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SearchString))
                    {
                        <div class="col-md-2 d-grid">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i>Clear
                            </a>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.FarmerSurvey.Any())
    {
        <div class="row">
            @foreach (var item in Model.FarmerSurvey)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header" style="background-color: var(--fairtrade-green); color: var(--white);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@item.FarmName</h5>
                                    <small>@item.Region</small>
                                </div>
                                <span class="badge bg-light text-dark">@item.SurveyDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Farmer</small>
                                    <small class="fw-medium">@item.FarmerName</small>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Elevation</small>
                                    <small class="fw-medium">@item.ElevationMeters m</small>
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Coffee Area</small>
                                    <small class="fw-medium">@item.CoffeePlantedAreaHa ha</small>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Processing</small>
                                    <small class="fw-medium">@(item.ProcessingMethod ?? "Not specified")</small>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(item.VarietiesGrown))
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-block">Varieties</small>
                                    <small class="fw-medium">@item.VarietiesGrown</small>
                                </div>
                            }
                            @if (item.QualityRating.HasValue)
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-block">Quality Rating</small>
                                    <div class="d-flex align-items-center">
                                        @for (int i = 1; i <= 10; i++)
                                        {
                                            <i class="bi bi-star-fill @(i <= item.QualityRating.Value ? "text-warning" : "text-muted") fs-6"></i>
                                        }
                                        <span class="ms-2 fw-medium">@item.QualityRating.Value/10</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                <div class="btn-group">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-clipboard-x display-1 text-muted"></i>
            </div>
            <h3 class="h4 text-muted mb-3">No Farmer Surveys Yet</h3>
            <p class="text-muted mb-4">Start collecting comprehensive farm data by adding your first survey.</p>
            <a asp-page="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Add First Survey
            </a>
        </div>
    }
</div>
