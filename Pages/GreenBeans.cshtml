@page
@model GreenBeansModel
@{
    ViewData["Title"] = "All Coffees";
    ViewData["MetaDescription"] = "Shop specialty Peruvian coffee from Purple Bean Coffee. Single-origin beans from La Convención and Cajamarca, SCA scored, roasted in Cusco. Available roasted or as wholesale green beans.";
}
@Html.AntiForgeryToken()

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>

        :root {
            --brand-orange: #FF4D29;
            --brand-blue: #0055FF;
            --brand-green: #1D4C3A;
            --text-main: #111111;
            --text-muted: #666666;
            --bg-main: #FFFFFF;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            overscroll-behavior-y: none;
        }

        .font-mono-tech {
            font-family: 'Space Mono', monospace;
        }

        .tracking-tightest { letter-spacing: -0.04em; }
        .tracking-tech { letter-spacing: 0.08em; }
        
        #canvas-container {
            position: relative;
            width: 100%;
            max-width: 450px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            touch-action: none; 
            display: flex;
            align-items: center;
            justify-content: center;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        .flavor-label {
            position: absolute;
            font-family: 'Space Mono', monospace;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.05em;
            pointer-events: none;
            text-align: center;
            z-index: 20;
            color: var(--text-muted);
            transition: color 0.3s ease;
            background: white;
            padding: 2px 8px;
        }

        .flavor-label.active {
            color: var(--text-main);
            border-bottom: 2px solid var(--brand-orange);
        }

        .fade-transition {
            transition: opacity 0.3s ease;
        }

        /* Scientific Range Sliders */
        .range-track {
            position: relative;
            width: 100%;
            height: 4px;
            background-color: #F0F0F0;
            border-radius: 4px;
            margin: 8px 0;
            overflow: hidden;
        }

        .range-bar {
            position: absolute;
            top: 0;
            height: 100%;
            border-radius: 4px;
            transition: left 0.3s ease, width 0.3s ease, background 0.3s ease;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #E5E5E5; }
        
        .flavor-triangle {
            width: 100%;
            max-width: 400px;
            aspect-ratio: 1.15 / 1;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            position: relative;
            margin: 0 auto;
        }

        .triangle-marker {
            position: absolute;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            cursor: pointer;
        }
    
</style>


<!-- Section: Flavor Explorer (Receipt Style & Paper Background) -->
