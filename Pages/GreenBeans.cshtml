        <section aria-label="Coffee Products" class="container mx-auto px-4 md:px-8 py-16">
            <!-- Simple Filters -->
            <div class="flex flex-wrap justify-center gap-4 mb-16">
            @{
                var initialFilter = !string.IsNullOrEmpty(Model.Type) ? Model.Type.ToLower() : (!string.IsNullOrEmpty(Model.Filter) ? Model.Filter : "All");
                var filters = new Dictionary<string, string> 
                { 
                    { "All", "All" }, 
                    { "green", "Green Coffee" },
                    { "roasted", "Roasted Coffee" },
                    { "Peru", "Peru" }, 
                    { "Colombia", "Colombia (Coming Soon)" }, 
                    { "Washed", "Washed" }, 
                    { "Natural", "Natural" } 
                };
                foreach (var filter in filters)
                {
                    var isSelected = filter.Key.Equals(initialFilter, StringComparison.OrdinalIgnoreCase);
                    <button type="button" data-filter="@filter.Key"
                       class="filter-btn px-6 py-2 border rounded-full text-xs font-bold font-mono-jb uppercase tracking-widest transition-all @(isSelected ? "bg-black text-white border-black" : "bg-transparent text-gray-600 border-gray-200 hover:border-gray-400 hover:text-black dark:text-[#B8C9A9] dark:border-[#445239] dark:hover:border-[#F2F5EB]")">
                        @filter.Value
                    </button>
                }
            }
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const buttons = document.querySelectorAll('.filter-btn');
                const cards = document.querySelectorAll('.product-card-container');

                function applyFilter(filter) {
                    const lowerFilter = filter.toLowerCase();
                    // Update button styles
                    buttons.forEach(b => {
                        if (b.getAttribute('data-filter').toLowerCase() === lowerFilter) {
                            b.classList.remove('bg-white dark:bg-[#3C4A33]', 'hover:bg-gray-100 dark:bg-[#2F3A28]');
                            b.classList.add('bg-black', 'text-white');
                        } else {
                            b.classList.remove('bg-black', 'text-white');
                            b.classList.add('bg-white dark:bg-[#3C4A33]', 'hover:bg-gray-100 dark:bg-[#2F3A28]');
                        }
                    });

                    // Filter cards
                    cards.forEach(card => {
                        const origin = (card.getAttribute('data-origin') || '').toLowerCase();
                        const process = (card.getAttribute('data-process') || '').toLowerCase();
                        const coffeeType = (card.getAttribute('data-type') || '').toLowerCase();
                        
                        if (lowerFilter === 'all' || origin === lowerFilter || process === lowerFilter || coffeeType === lowerFilter) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                }

                buttons.forEach(btn => {
                    btn.addEventListener('click', function() {
                        const filter = this.getAttribute('data-filter');
                        applyFilter(filter);
                    });
                });

                // Apply initial filter if set in query
                const urlParams = new URLSearchParams(window.location.search);
                const typeParam = urlParams.get('type') || urlParams.get('filter');
                if (typeParam) {
                    applyFilter(typeParam);
                }
            });
        </script>
        
