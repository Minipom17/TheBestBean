<script>
    document.addEventListener('DOMContentLoaded', () => {
        // UI Elements
        const profileDetails = document.getElementById('active-profile-details');
        const categoryLabel = document.getElementById('category-label');
        const profileTitle = document.getElementById('profile-title');
        const profileDesc = document.getElementById('profile-desc');
        const tagsContainer = document.getElementById('tags-container');
        const zoneIndicator = document.getElementById('zone-indicator');

        const recTitle = document.getElementById('rec-title');
        const recOrigin = document.getElementById('rec-origin');
        const recProcess = document.getElementById('rec-process');
        const recAltitude = document.getElementById('rec-altitude');
        const recRoast = document.getElementById('rec-roast');
        const recDesc = document.getElementById('rec-desc');
        
        const rangeRoast = document.getElementById('flavor-slider');

        // Nodes data
        let nodes = [
            { id: 0, active: true, color: '#FF5A36', x: 50, y: 25 },
            { id: 1, active: false, color: '#CCCCCC', x: 40, y: 35 },
            { id: 2, active: false, color: '#CCCCCC', x: 60, y: 35 }
        ];

        // Flavor Zones from Backend
        const rawFlavorZones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FlavorZones));
        const flavorZones = rawFlavorZones.map(z => ({
            id: z.Id,
            name: z.Name,
            category: z.Category,
            description: z.Description,
            markers: z.Markers || [],
            color: z.Color || '#FF5A36',
            baryTarget: JSON.parse(z.BaryTargetJson || '{"t": 0.33, "br": 0.33, "bl": 0.33}'),
            specs: JSON.parse(z.SpecsJson || '{"roast": [45, 55], "body": [45, 55], "aftertaste": [45, 55]}'),
            recommendation: { 
                title: z.RecommendationTitle, 
                origin: z.RecommendationOrigin, 
                roast: z.RecommendationRoast, 
                desc: z.RecommendationDesc 
            }
        }));

        // Math Helpers (using percentage coords 0-100)
        function getBarycentric(px, py) {
            const ax = 50, ay = 0;
            const bx = 100, by = 100;
            const cx = 0, cy = 100;
            
            const v0x = bx - ax, v0y = by - ay;
            const v1x = cx - ax, v1y = cy - ay;
            const v2x = px - ax, v2y = py - ay;

            const d00 = v0x * v0x + v0y * v0y;
            const d01 = v0x * v1x + v0y * v1y;
            const d11 = v1x * v1x + v1y * v1y;
            const d20 = v2x * v0x + v2y * v0y;
            const d21 = v2x * v1x + v2y * v1y;

            const denom = d00 * d11 - d01 * d01;
            if (Math.abs(denom) < 1e-10) return { t: 0.33, br: 0.33, bl: 0.33 };
            
            const v = (d11 * d20 - d01 * d21) / denom;
            const w = (d00 * d21 - d01 * d20) / denom;
            const u = 1.0 - v - w;
            
            return { t: u, br: v, bl: w };
        }

        function clampToTriangle(px, py) {
            let bary = getBarycentric(px, py);
            if (bary.t >= 0 && bary.br >= 0 && bary.bl >= 0) return {x: px, y: py};
            
            let t = Math.max(0, Math.min(1, bary.t));
            let br = Math.max(0, Math.min(1, bary.br));
            let bl = Math.max(0, Math.min(1, bary.bl));
            const sum = t + br + bl;
            
            t /= sum; br /= sum; bl /= sum;
            
            const ax = 50, ay = 0;
            const bx = 100, by = 100;
            const cx = 0, cy = 100;
            
            return {
                x: t * ax + br * bx + bl * cx,
                y: t * ay + br * by + bl * cy
            };
        }

        function getClosestFlavorZone(bary) {
            let closestZone = flavorZones[0];
            let minDistance = Infinity;
            flavorZones.forEach(zone => {
                const dist = Math.sqrt(
                    Math.pow(bary.t - zone.baryTarget.t, 2) +
                    Math.pow(bary.br - zone.baryTarget.br, 2) +
                    Math.pow(bary.bl - zone.baryTarget.bl, 2)
                );
                if (dist < minDistance) {
                    minDistance = dist;
                    closestZone = zone;
                }
            });
            return closestZone;
        }

        // DOM Update Logic
        function updateUI(zones, activeNodes) {
            const uniqueZones = [];
            const seen = new Set();
            zones.forEach(z => {
                if (z && !seen.has(z.id)) {
                    seen.add(z.id);
                    uniqueZones.push(z);
                }
            });

            if (uniqueZones.length === 0) return;

            profileDetails.style.opacity = '0';
            
            setTimeout(() => {
                let activeColorStyle = '';
                
                let minRoast = 0, maxRoast = 0;
                let minBody = 0, maxBody = 0;
                let minAftertaste = 0, maxAftertaste = 0;
                
                zones.forEach(z => {
                    minRoast += z.specs.roast[0]; 
                    maxRoast += z.specs.roast[1];
                    minBody += z.specs.body[0]; 
                    maxBody += z.specs.body[1];
                    minAftertaste += z.specs.aftertaste[0]; 
                    maxAftertaste += z.specs.aftertaste[1];
                });
                const len = zones.length || 1;
                const blendRoast = (minRoast + maxRoast) / (2 * len);
                const blendBody = (minBody + maxBody) / (2 * len);
                const blendAftertaste = (minAftertaste + maxAftertaste) / (2 * len);
                
                if (rangeRoast) {
                    rangeRoast.value = blendRoast;
                }
                const bodySlider = document.getElementById('body-slider');
                if (bodySlider) {
                    bodySlider.value = blendBody;
                }
                const aftertasteSlider = document.getElementById('aftertaste-slider');
                if (aftertasteSlider) {
                    aftertasteSlider.value = blendAftertaste;
                }
                const specIndicator = document.getElementById('spec-indicator');

                if (uniqueZones.length === 1) {
                    const z = uniqueZones[0];
                    activeColorStyle = z.color;
                    zoneIndicator.style.background = activeColorStyle;
                    if (specIndicator) specIndicator.style.background = activeColorStyle;
                    
                    const roastLabel = document.getElementById('label-roast');
                    if (roastLabel) {
                        roastLabel.style.color = activeColorStyle;
                        roastLabel.style.borderColor = activeColorStyle;
                    }
                    if (rangeRoast) rangeRoast.style.setProperty('--thumb-color', activeColorStyle);
                    categoryLabel.textContent = z.category;
                    profileTitle.textContent = z.name;
                    profileDesc.textContent = z.description;
                    tagsContainer.textContent = (z.markers || []).join(' // ');
                    
                    if (z.recommendation) {
                        recTitle.textContent = z.recommendation.title || '';
                        const splitOrigin = (z.recommendation.origin || '').split('//');
                        if (recOrigin) recOrigin.textContent = splitOrigin.length > 1 ? splitOrigin[1].trim() : splitOrigin[0];
                        if (recProcess) recProcess.textContent = splitOrigin.length > 1 ? splitOrigin[0].trim() : 'Washed';
                        if (recRoast) recRoast.textContent = z.recommendation.roast || '';
                        if (recDesc) recDesc.textContent = z.recommendation.desc || '';
                    }

                    // Re-enable inline editing if the script is globally available
                    if (window.initInlineEditing) window.initInlineEditing();
                    
                } else {
                    // Blended State
                    const z1 = uniqueZones[0], z2 = uniqueZones[1];
                    activeColorStyle = `linear-gradient(90deg, ${z1.color} 0%, ${z2.color} 100%)`;
                    zoneIndicator.style.background = activeColorStyle;
                    
                    categoryLabel.textContent = `Custom Blend`;
                    profileTitle.textContent = `${z1.name} & ${z2.name}`;
                    profileDesc.textContent = `A complex profile balancing ${z1.category.toLowerCase()} notes with ${z2.category.toLowerCase()} characteristics.`;
                    
                    const mergedMarkers = [];
                    for(let i=0; i<3; i++) {
                        if (z1.markers && z1.markers[i]) mergedMarkers.push(z1.markers[i]);
                        if (z2.markers && z2.markers[i]) mergedMarkers.push(z2.markers[i]);
                    }
                    tagsContainer.textContent = mergedMarkers.join(' // ');

                    recTitle.textContent = 'Curated Field Blend';
                    if(recOrigin) recOrigin.textContent = 'Post-Harvest Blend';
                    if(recProcess) recProcess.textContent = 'Mixed Process';
                    if(recRoast) recRoast.textContent = 'Omni-Roast';
                    if(recDesc) recDesc.textContent = `A tailored coffee experience designed to bridge the gap between ${z1.markers[0].toLowerCase()} and ${z2.markers[0].toLowerCase()}.`;
                }
                
                profileDetails.style.opacity = '1';
            }, 300);
        }

        function processCurrentPosition() {
            const activeNodes = nodes.filter(n => n.active);
            const activeZones = activeNodes.map(n => {
                const bary = getBarycentric(n.x, n.y);
                return getClosestFlavorZone(bary);
            });
            updateUI(activeZones, activeNodes);
        }

        // Toggling Nodes
        document.getElementById('legend-1')?.addEventListener('click', () => toggleNode(1));
        
        function toggleNode(index) {
            const node = nodes[index];
            node.active = !node.active;
            
            const legendEl = document.getElementById(`legend-${index}`);
            const dotEl = document.getElementById(`dot-${index}`);
            const textEl = document.getElementById(`text-${index}`);
            const markerEl = document.getElementById(`triangle-marker-${index}`);

            if (node.active) {
                // place near primary node
                node.x = Math.max(0, Math.min(100, nodes[0].x + (index === 1 ? -15 : 15)));
                node.y = Math.max(0, Math.min(100, nodes[0].y + 15));
                markerEl.style.left = `${node.x}%`;
                markerEl.style.top = `${node.y}%`;
                
                legendEl.classList.remove('text-black', 'bg-transparent');
                legendEl.classList.add('bg-black', 'text-white');
                dotEl.innerHTML = '';
                dotEl.classList.remove('bg-transparent');
                dotEl.classList.add('bg-white');
                textEl.textContent = 'Secondary';
                markerEl.style.display = 'block';
            } else {
                legendEl.classList.add('text-black', 'bg-transparent');
                legendEl.classList.remove('bg-black', 'text-white');
                dotEl.innerHTML = '+';
                dotEl.classList.remove('bg-white');
                dotEl.classList.add('bg-transparent');
                textEl.textContent = 'Add Note';
                markerEl.style.display = 'none';
            }
            processCurrentPosition();
        }

        // Drag functionality
        const triangleEl = document.querySelector('.flavor-triangle');
        let draggingIdx = -1;

        function startDrag(e, idx) {
            e.preventDefault();
            draggingIdx = idx;
        }

        nodes.forEach((n, idx) => {
            const marker = document.getElementById(`triangle-marker-${idx}`);
            if (marker) {
                marker.addEventListener('mousedown', (e) => startDrag(e, idx));
                marker.addEventListener('touchstart', (e) => startDrag(e, idx), {passive: false});
            }
        });

        function updateDrag(clientX, clientY) {
            if (draggingIdx === -1) return;
            const rect = triangleEl.getBoundingClientRect();
            // Get percentage
            let px = ((clientX - rect.left) / rect.width) * 100;
            let py = ((clientY - rect.top) / rect.height) * 100;
            
            const clamped = clampToTriangle(px, py);
            
            nodes[draggingIdx].x = clamped.x;
            nodes[draggingIdx].y = clamped.y;
            
            const marker = document.getElementById(`triangle-marker-${draggingIdx}`);
            marker.style.left = `${clamped.x}%`;
            marker.style.top = `${clamped.y}%`;
            
            processCurrentPosition();
        }

        window.addEventListener('mousemove', (e) => updateDrag(e.clientX, e.clientY));
        window.addEventListener('touchmove', (e) => {
            if (draggingIdx !== -1) {
                e.preventDefault();
                updateDrag(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, {passive: false});

        window.addEventListener('mouseup', () => { draggingIdx = -1; });
        window.addEventListener('touchend', () => { draggingIdx = -1; });

        // Initial setup
        if (flavorZones.length > 0) {
            processCurrentPosition();
        }
    });
</script>
