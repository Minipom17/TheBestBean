        <section aria-label="Coffee Products" class="container mx-auto px-4 md:px-8 py-16">
            <!-- Filters — horizontal scroll strip matching product stat tags -->
            <div class="relative mb-12">
                <div class="flex overflow-x-auto gap-0 scrollbar-hide snap-x snap-mandatory -mx-4 px-4 md:mx-0 md:px-0 md:flex-wrap md:justify-center md:gap-2">
                @{
                    var initialFilter = !string.IsNullOrEmpty(Model.Type) ? Model.Type.ToLower() : (!string.IsNullOrEmpty(Model.Filter) ? Model.Filter : "All");
                    var filters = new Dictionary<string, string> 
                    { 
                        { "All", "All" }, 
                        { "green", "Green Coffee" },
                        { "roasted", "Roasted Coffee" },
                        { "Peru", "Peru" }, 
                        { "Colombia", "Colombia (Coming Soon)" }, 
                        { "Washed", "Washed" }, 
                        { "Natural", "Natural" } 
                    };
                    foreach (var filter in filters)
                    {
                        var isSelected = filter.Key.Equals(initialFilter, StringComparison.OrdinalIgnoreCase);
                        <button type="button" data-filter="@filter.Key" class="filter-btn snap-start shrink-0 md:shrink whitespace-nowrap px-3 py-1.5 font-mono-jb text-[8px] uppercase tracking-widest font-bold border-r border-gray-300 dark:border-[#2A262C] transition-all last:border-r-0 md:border md:rounded-none md:last:border-r @(isSelected ? "bg-black text-white dark:bg-cream dark:text-night" : "bg-white text-black dark:bg-[#1C191F] dark:text-mist hover:bg-gray-100 dark:hover:bg-[#2A262C]")">
                            @filter.Value
                        </button>
                    }
                }
                </div>
            </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const buttons = document.querySelectorAll('.filter-btn');
                const cards = document.querySelectorAll('.product-card-container');

                function applyFilter(filter) {
                    const lowerFilter = filter.toLowerCase();
                    // Update button styles
                    buttons.forEach(b => {
                        if (b.getAttribute('data-filter').toLowerCase() === lowerFilter) {
                            b.classList.remove('bg-white dark:bg-[#121014]', 'hover:bg-gray-100 dark:bg-[#1C191F]');
                            b.classList.add('bg-black', 'text-white');
                        } else {
                            b.classList.remove('bg-black', 'text-white');
                            b.classList.add('bg-white dark:bg-[#121014]', 'hover:bg-gray-100 dark:bg-[#1C191F]');
                        }
                    });

                    // Filter cards
                    cards.forEach(card => {
                        const origin = (card.getAttribute('data-origin') || '').toLowerCase();
                        const process = (card.getAttribute('data-process') || '').toLowerCase();
                        const coffeeType = (card.getAttribute('data-type') || '').toLowerCase();
                        
                        if (lowerFilter === 'all' || origin === lowerFilter || process === lowerFilter || coffeeType === lowerFilter) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                }

                buttons.forEach(btn => {
                    btn.addEventListener('click', function() {
                        const filter = this.getAttribute('data-filter');
                        applyFilter(filter);
                    });
                });

                // Apply initial filter if set in query
                const urlParams = new URLSearchParams(window.location.search);
                const typeParam = urlParams.get('type') || urlParams.get('filter');
                if (typeParam) {
                    applyFilter(typeParam);
                }
            });
        </script>
        
