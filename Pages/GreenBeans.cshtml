@page "/Coffee"
@model GreenBeansModel
@{
    ViewData["Title"] = "Coffee";
    ViewData["MetaDescription"] = "Shop specialty Peruvian coffee from Purple Bean Coffee. Single-origin beans from La Convención and Cajamarca, SCA scored, roasted in Cusco. Available roasted or as wholesale green beans.";
}
@Html.AntiForgeryToken()

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>

        :root {
            --brand-orange: #FF4D29;
            --brand-blue: #0055FF;
            --brand-green: #1D4C3A;
            --text-main: #111111;
            --text-muted: #666666;
            --bg-main: #FFFFFF;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            overscroll-behavior-y: none;
        }

        .font-mono-tech {
            font-family: 'Space Mono', monospace;
        }

        .tracking-tightest { letter-spacing: -0.04em; }
        .tracking-tech { letter-spacing: 0.08em; }
        
        #canvas-container {
            position: relative;
            width: 100%;
            max-width: 450px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            touch-action: none; 
            display: flex;
            align-items: center;
            justify-content: center;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        .flavor-label {
            position: absolute;
            font-family: 'Space Mono', monospace;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.05em;
            pointer-events: none;
            text-align: center;
            z-index: 20;
            color: var(--text-muted);
            transition: color 0.3s ease;
            background: white;
            padding: 2px 8px;
        }

        .flavor-label.active {
            color: var(--text-main);
            border-bottom: 2px solid var(--brand-orange);
        }

        .fade-transition {
            transition: opacity 0.3s ease;
        }

        /* Scientific Range Sliders */
        .range-track {
            position: relative;
            width: 100%;
            height: 4px;
            background-color: #F0F0F0;
            border-radius: 4px;
            margin: 8px 0;
            overflow: hidden;
        }

        .range-bar {
            position: absolute;
            top: 0;
            height: 100%;
            border-radius: 4px;
            transition: left 0.3s ease, width 0.3s ease, background 0.3s ease;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #E5E5E5; }
        
        .flavor-map {
            width: 100%;
            max-width: 280px;
            margin: 0 auto;
        }
        .flavor-map__top {
            text-align: center;
            border-bottom: 1px solid #111;
            padding-bottom: 0.25rem;
            margin: 0 auto 0.75rem;
            width: fit-content;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: #111;
        }
        html.dark .flavor-map__top {
            color: #D6D0C8;
            border-bottom-color: rgba(214, 208, 200, 0.22);
        }
        .flavor-triangle {
            width: 100%;
            max-width: 280px;
            aspect-ratio: 1.15 / 1;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            position: relative;
            margin: 0 auto;
            cursor: crosshair;
        }

        .triangle-marker {
            position: absolute;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            cursor: grab;
            z-index: 2;
        }
        .triangle-marker:active { cursor: grabbing; }

        .flavor-triangle-wrap {
            position: relative;
            width: 100%;
            overflow: visible;
        }
        .flavor-triangle-stage {
            position: relative;
            width: 100%;
            max-width: 280px;
            margin: 0 auto;
            overflow: visible;
        }
        .flavor-click-arrow {
            position: absolute;
            right: calc(100% + 8px);
            top: 50%;
            transform: translateY(-50%);
            z-index: 4;
            pointer-events: none;
            color: #111;
            display: block;
            line-height: 0;
            animation: flavor-arrow-nudge 1.1s ease-in-out infinite;
        }
        html.dark .flavor-click-arrow {
            color: #D6D0C8;
        }
        @@keyframes flavor-arrow-nudge {
            0%, 100% { transform: translate(-2px, -50%); }
            50% { transform: translate(3px, -50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .flavor-click-arrow { animation: none; transform: translateY(-50%); }
        }
        .flavor-prompt {
            position: absolute;
            left: 50%;
            top: 58%;
            transform: translate(-50%, -50%);
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            pointer-events: none;
            font-family: 'JetBrains Mono', monospace;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #111;
            background: rgb(137 215 255 / 70%);
            padding: 4px 8px 4px 6px;
            white-space: nowrap;
            transition: opacity 0.3s ease;
        }
        html.dark .flavor-prompt {
            color: #D6D0C8;
            background: rgba(18, 16, 20, 0.88);
        }
        .flavor-prompt-cursor {
            width: 7px;
            height: 12px;
            background: currentColor;
            animation: offerings-blink 0.7s step-end infinite;
            flex-shrink: 0;
        }
        .flavor-prompt.is-hidden {
            opacity: 0;
            pointer-events: none;
        }
        .flavor-hint-mouse { display: none; }
        .flavor-hint-touch { display: none; }
        @@media (hover: hover) and (pointer: fine) {
            .flavor-hint-mouse { display: flex; }
        }
        @@media (hover: none), (pointer: coarse) {
            .flavor-hint-touch { display: flex; }
        }
        .flavor-map__base {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.5rem;
            margin: 0.5rem 0 1rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #111;
        }
        html.dark .flavor-map__base { color: #D6D0C8; }
        .flavor-map__base span:first-child { text-align: left; max-width: 46%; }
        .flavor-map__base span:last-child { text-align: right; max-width: 46%; }

        .flavor-legend-block {
            width: 100%;
            max-width: 360px;
            margin: 0 auto 1rem;
            position: relative;
        }
        .flavor-legend-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 0.75rem;
        }
        .flavor-note-help-btn {
            width: 32px;
            min-width: 32px;
            height: 32px;
            border: 1px solid #111;
            background: transparent;
            cursor: pointer;
            font-family: 'JetBrains Mono', monospace;
            font-size: 16px;
            font-weight: 700;
            line-height: 1;
            color: #111;
            padding: 0;
        }
        html.dark .flavor-note-help-btn {
            border-color: rgba(214, 208, 200, 0.35);
            color: #D6D0C8;
        }
        .flavor-note-help-btn[aria-expanded="true"] {
            background: #111;
            color: #fff;
        }
        html.dark .flavor-note-help-btn[aria-expanded="true"] {
            background: #8B6FA0;
            color: #121014;
            border-color: #8B6FA0;
        }
        .flavor-note-help-text {
            display: none;
            margin: 0.6rem 0 0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(17, 17, 17, 0.6);
            text-align: center;
            line-height: 1.5;
        }
        html.dark .flavor-note-help-text { color: #8B8490; }
        .flavor-note-help-text.is-open { display: block; }

        .flavor-legend-btn.legend-selected {
            background-color: #111 !important;
            color: #fff !important;
        }
        html.dark .flavor-legend-btn.legend-selected {
            background-color: #8B6FA0 !important;
            color: #121014 !important;
            border-color: #8B6FA0 !important;
        }
    
</style>


