@page
@model IndexModel
@{
    ViewData["Title"] = "We source and roast coffees in Peru.";
    ViewData["MetaDescription"] = "Purple Bean Coffee — specialty coffee roastery in Cusco, Peru. We source from high-altitude farms in La Convención and Cajamarca, roast in small batches, and offer immersive coffee experiences.";
}

<!-- MAIN CONTENT CONTAINER (Full Width for Bleed) -->
<div class="flex-grow w-full relative pb-0 font-sans text-v-black dark:text-[#D6D0C8]">
    
    <!-- HERO FEATURE RELEASE (Full Bleed Image) -->
    <section aria-label="Hero" class="relative w-full h-[95vh] min-h-screen flex items-center mb-0">
        <!-- Background Image with Overlay -->
        <div class="absolute inset-0 w-full h-full">
            <img src="/Media/main1.jpg" alt="High-altitude coffee plantation in Cusco, Peru" class="w-full h-full object-cover" />
        </div>

        <!-- Content -->
        <div class="relative z-10 w-full max-w-[1600px] mx-auto px-6 md:px-12">
            <!-- Glassmorphism Text Container -->
            <div class="max-w-xl mt-10">
                <div class="bg-[#16A34A]/10 backdrop-blur-md p-4 mb-8">
                    <h1 class="text-2xl md:text-3xl lg:text-4xl font-light tracking-tight text-white dark:text-cream mb-6 font-mono-jb capitalize leading-tight" data-entity-id="Home_Hero_Title" data-entity-type="SiteContent" data-editable="Value">
                        @Html.Raw(Model.PageContent.GetValueOrDefault("Home_Hero_Title", "Elevate Your Senses"))
                    </h1>
                    
                    <p class="text-white dark:text-cream text-sm md:text-base leading-relaxed font-outfit" data-entity-id="Home_Hero_Desc" data-entity-type="SiteContent" data-editable="Value" style="font-family: 'Outfit', sans-serif; font-weight: 500;">
                        @Html.Raw(Model.PageContent.GetValueOrDefault("Home_Hero_Desc", "Unlock the wild, nuanced profiles born from the dramatic peaks of the Peruvian highlands. Grown in harmony with the mountains by our artisan farming families, every bean tells a story of extraordinary terroir. Sip the elevation at home, or join us on the mountain to live the magic behind the harvest."))
                    </p>
                </div>
                
                <!-- CTA Button -->
                <a asp-page="/GreenBeans" class="inline-flex bg-transparent border border-white dark:border-cream text-white dark:text-cream px-8 py-3 font-bold uppercase tracking-widest text-[11px] hover:bg-white hover:text-black dark:hover:bg-cream dark:hover:text-night transition-all duration-300 font-grotesk text-decoration-none group items-center">
                    SHOP COFFEES <span class="ml-3">&larr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- PHILOSOPHY / PHILOSOPHICAL HOOK (Lime Green) -->
    <section aria-labelledby="philosophy-heading" class="w-full bg-[#D4FF00] dark:bg-night-2 text-black dark:text-cream">
        <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-32">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <div class="lg:col-span-4">
                    <h3 id="philosophy-heading" class="text-[10px] font-bold uppercase tracking-widest text-gray-800 dark:text-mist font-mono-jb">01 // PHILOSOPHY</h3>
                </div>
                <div class="lg:col-span-8">
                    <p class="text-3xl md:text-5xl font-bold tracking-tight text-[#FF6464] dark:text-cream leading-[1.1] mb-8 font-mono-jb" data-entity-id="Home_Philosophy_Title" data-entity-type="SiteContent" data-editable="Value">
                        @Html.Raw(Model.PageContent.GetValueOrDefault("Home_Philosophy_Title", "We source and roast the finest coffees in <span class=\"border-b-4 border-white dark:border-cream\">Peru</span>."))
                    </p>
                    <p class="text-gray-900 dark:text-mist text-base md:text-lg font-normal leading-relaxed max-w-2xl font-grotesk" data-entity-id="Home_Philosophy_Desc" data-entity-type="SiteContent" data-editable="Value" style="font-family: 'Inter', sans-serif;">
                        @Html.Raw(Model.PageContent.GetValueOrDefault("Home_Philosophy_Desc", "Exploring the dynamic relationship between variety, altitude, and experimental post-harvest processing to showcase the inherent sweetness and vibrancy of the Andean coffee cherry."))
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CURRENT OFFERINGS (desktop split / mobile: coffee → image → workshops) -->
    <section id="offerings" aria-label="Current Offerings" class="w-full border-t border-v-light-gray bg-white dark:bg-night">
        <div class="offerings-split">

            @{
                string[] AccentSequence(int count)
                {
                    var core = new[] { "146, 219, 255", "80, 168, 235", "209, 147, 255", "255, 121, 121" };
                    if (count <= 0) return Array.Empty<string>();
                    if (count >= 5)
                    {
                        var seq = new string[count];
                        seq[0] = "160, 160, 160";
                        for (var k = 1; k < count; k++) seq[k] = core[(k - 1) % core.Length];
                        return seq;
                    }
                    return core.Take(count).ToArray();
                }
                int i = 0;
                var coffeeCount = Model.FeaturedProducts?.Count ?? 0;
                var expCount = Model.FeaturedExperiences?.Count ?? 0;
                var coffeeAccents = AccentSequence(coffeeCount);
                var expAccents = AccentSequence(expCount);
            }

            <!-- Coffee list -->
            <div class="offerings-split-coffee flex flex-col justify-end px-5 md:px-10 lg:px-12 pt-8 lg:pt-16 pb-6 lg:pb-4">
                <div class="text-[10px] font-bold uppercase tracking-widest text-gray-800 dark:text-mist font-mono-jb mb-2">02 // OFFERINGS</div>
                <p class="text-[10px] font-mono-jb uppercase tracking-widest text-gray-500 dark:text-mist mb-4 lg:mb-8">Cusco, PE</p>

                <div id="offerings-choose-prompt" class="offerings-choose-prompt" aria-hidden="true">
                    <span class="flavor-prompt-cursor" aria-hidden="true"></span>
                    <span>Tap to choose a coffee / workshop</span>
                </div>

                <div class="flex items-baseline justify-between mb-2">
                    <div class="text-[10px] md:text-[11px] font-bold text-gray-800 dark:text-mist uppercase tracking-widest font-mono-jb">coffee.</div>
                    <div class="text-[9px] font-mono-jb uppercase tracking-widest text-gray-400 dark:text-mist">[@coffeeCount]</div>
                </div>
                <div role="listbox" aria-label="Featured coffees">
                    @foreach (var item in Model.FeaturedProducts)
                    {
                        var imageUrl = item.ImageUrl ?? "/Media/bag.png";
                        var accent = coffeeAccents[i];
                        var origin = item.OriginCountry?.Name ?? "";
                        <a href="/Product/@item.Id"
                           class="offerings-row flex justify-between items-center gap-3 py-3.5 px-2 text-decoration-none group text-v-black dark:text-cream border-b border-gray-200 dark:border-[#2A262C] transition-colors"
                           data-img="@imageUrl"
                           data-title="@item.Name"
                           data-meta="@(string.IsNullOrEmpty(origin) ? "Specialty coffee" : origin)"
                           data-kind="coffee"
                           data-accent="@accent"
                           data-offerings-index="@i"
                           role="option"
                           aria-selected="false">
                            <span class="text-[10px] font-mono-jb tracking-widest opacity-60 shrink-0">[SCA <span data-entity-id="@item.Id" data-entity-type="CoffeeBean" data-editable="ScaScore">@item.ScaScore.ToString("0.##")</span>]</span>
                            <span class="flex items-center gap-2 min-w-0 justify-end text-right">
                                <span class="text-[11px] md:text-xs font-mono-jb font-bold border-b-2 pb-0.5 truncate uppercase" style="border-bottom-color: rgb(@accent);" data-entity-id="@item.Id" data-entity-type="CoffeeBean" data-editable="Name">@item.Name</span>
                                <span class="offerings-cursor" aria-hidden="true"></span>
                            </span>
                        </a>
                        i++;
                    }
                </div>
            </div>

            <!-- Preview image: between coffee and workshops on mobile; right column on desktop -->
            <div id="hoverImageContainer" class="offerings-split-image relative min-h-[42vh] h-[42vh] lg:h-auto lg:min-h-full bg-v-light-gray dark:bg-night-2 overflow-hidden">
                <a id="offeringsImageLink" href="#" class="block absolute inset-0 text-decoration-none">
                    <img id="hoverImage" src="" alt="Selected coffee or experience" class="w-full h-full object-cover transition-opacity duration-500" loading="lazy" />
                </a>
                <div id="offeringsOverlay" class="absolute top-4 left-4 z-10 bg-white dark:bg-night-2 px-4 py-3 max-w-[220px] pointer-events-none shadow-sm">
                    <div class="flex items-center gap-2 font-mono-jb text-[8px] font-bold uppercase tracking-widest text-v-black dark:text-cream mb-2">
                        <span class="w-2 h-2 bg-ember shrink-0"></span>
                        <span>Selected</span>
                    </div>
                    <div id="overlayTitle" class="font-mono-jb text-xs font-bold uppercase tracking-wide text-v-black dark:text-cream leading-tight mb-1"></div>
                    <div id="overlayMeta" class="font-mono-jb text-[9px] uppercase tracking-widest text-gray-500 dark:text-mist"></div>
                </div>
            </div>

            <!-- Workshops / farms -->
            <div class="offerings-split-workshops flex flex-col justify-start px-5 md:px-10 lg:px-12 pt-6 lg:pt-4 pb-8 lg:pb-16">
                <div class="hidden lg:flex items-baseline justify-between mb-2">
                    <div class="text-[10px] md:text-[11px] font-bold text-gray-800 dark:text-mist uppercase tracking-widest font-mono-jb">experiences.</div>
                    <div class="text-[9px] font-mono-jb uppercase tracking-widest text-gray-400 dark:text-mist">[@expCount]</div>
                </div>
                <div role="listbox" aria-label="Featured experiences">
                    @{
                        int j = 0;
                        var expStartIndex = i;
                    }
                    @foreach (var exp in Model.FeaturedExperiences)
                    {
                        var imageUrl = string.IsNullOrEmpty(exp.ImageUrl) ? "/Media/main1.jpg" : exp.ImageUrl;
                        var accent = expAccents[j];
                        var rowIndex = expStartIndex + j;
                        var location = string.IsNullOrWhiteSpace(exp.Location) ? "Cusco HQ" : exp.Location;
                        var kindLabel = (exp.Category ?? "").Contains("Expedition", StringComparison.OrdinalIgnoreCase) ? "Farm" : "Workshop";
                        <a href="/Experiences"
                           class="offerings-row flex justify-between items-center gap-3 py-3.5 px-2 text-decoration-none group text-v-black dark:text-cream border-b border-gray-200 dark:border-[#2A262C] transition-colors"
                           data-img="@imageUrl"
                           data-title="@exp.Title"
                           data-meta="@location"
                           data-kind="experience"
                           data-accent="@accent"
                           data-offerings-index="@rowIndex"
                           role="option"
                           aria-selected="false">
                            <span class="flex items-center gap-2 min-w-0">
                                <span class="text-[11px] md:text-xs font-mono-jb font-bold border-b-2 pb-0.5 truncate uppercase" style="border-bottom-color: rgb(@accent);" data-entity-id="@exp.Id" data-entity-type="Experience" data-editable="Title">@exp.Title</span>
                                <span class="offerings-cursor" aria-hidden="true"></span>
                            </span>
                            <span class="text-[10px] font-mono-jb tracking-widest shrink-0 text-ember">[@kindLabel]</span>
                        </a>
                        j++;
                    }
                </div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('.offerings-row');
            const imageContainer = document.getElementById('hoverImageContainer');
            const hoverImage = document.getElementById('hoverImage');
            const overlayTitle = document.getElementById('overlayTitle');
            const overlayMeta = document.getElementById('overlayMeta');
            const imageLink = document.getElementById('offeringsImageLink');
            const choosePrompt = document.getElementById('offerings-choose-prompt');
            if (!rows.length || !imageContainer || !hoverImage) return;

            let currentIndex = 0;
            let autoInterval = null;
            let userPaused = false;
            const CYCLE_MS = 2800;
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const isCoarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;

            function setActiveRow(index) {
                currentIndex = index;
                const row = rows[index];
                const rgb = row.getAttribute('data-accent') || '160, 160, 160';
                rows.forEach((r, i) => {
                    const active = i === index;
                    r.classList.toggle('offerings-active', active);
                    r.setAttribute('aria-selected', active ? 'true' : 'false');
                    if (active) {
                        r.style.setProperty('--offerings-hl', `rgba(${rgb}, 0.22)`);
                        r.style.setProperty('--offerings-hl-dark', `rgba(${rgb}, 0.42)`);
                    } else {
                        r.style.removeProperty('--offerings-hl');
                        r.style.removeProperty('--offerings-hl-dark');
                    }
                });
                const imgSrc = row.getAttribute('data-img');
                if (imgSrc) {
                    hoverImage.src = imgSrc;
                    hoverImage.alt = row.getAttribute('data-title') || 'Selected offering';
                }
                if (overlayTitle) overlayTitle.textContent = row.getAttribute('data-title') || '';
                if (overlayMeta) overlayMeta.textContent = row.getAttribute('data-meta') || '';
                if (imageLink) imageLink.href = row.getAttribute('href') || '#';
            }

            function hideChoosePrompt() {
                choosePrompt?.classList.add('is-hidden');
            }

            function startAutoCycle() {
                if (prefersReducedMotion) return;
                clearInterval(autoInterval);
                autoInterval = setInterval(() => {
                    if (userPaused || document.hidden) return;
                    setActiveRow((currentIndex + 1) % rows.length);
                }, CYCLE_MS);
            }

            rows.forEach((row, index) => {
                row.addEventListener('mouseenter', () => {
                    if (isCoarse) return;
                    userPaused = true;
                    setActiveRow(index);
                });
                row.addEventListener('mouseleave', () => {
                    if (isCoarse) return;
                    userPaused = false;
                });
                row.addEventListener('focus', () => {
                    userPaused = true;
                    setActiveRow(index);
                });
                row.addEventListener('blur', () => {
                    if (isCoarse) return;
                    userPaused = false;
                });
                row.addEventListener('click', (e) => {
                    hideChoosePrompt();
                    if (!isCoarse) return;
                    if (!row.classList.contains('offerings-active')) {
                        e.preventDefault();
                        userPaused = true;
                        setActiveRow(index);
                    }
                });
            });

            document.addEventListener('visibilitychange', () => {
                if (document.hidden) clearInterval(autoInterval);
                else startAutoCycle();
            });

            setActiveRow(0);
            startAutoCycle();
        });
    </script>



</div>

