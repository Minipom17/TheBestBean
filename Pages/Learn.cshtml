<script>
document.addEventListener('DOMContentLoaded', function() {
    const flavorBlobs = document.querySelectorAll('.flavor-blob');
    
    flavorBlobs.forEach(blob => {
        blob.addEventListener('click', function() {
            const flavor = this.getAttribute('data-flavor');
            // Add interactive behavior here
            console.log('Selected flavor:', flavor);
            
            // Visual feedback
            this.style.transform = 'scale(1.2)';
            setTimeout(() => {
                this.style.transform = 'scale(1)';
            }, 200);
        });
    });
});
