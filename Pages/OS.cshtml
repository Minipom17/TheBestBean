                    </div>
                    <p class="text-xs text-gray-500 uppercase tracking-widest font-bold mb-4"><span class="text-[#A3C8FF]">P</span>urple Bean Coffee</p>
                    <p class="text-sm text-gray-600 mb-6 line-clamp-2 min-h-[40px]">${r.notes || 'No notes.'}</p>
                    <div class="border-t border-dotted border-gray-300 pt-4 font-mono text-[10px] uppercase font-bold text-gray-500 space-y-2">
                        <div class="flex justify-between"><span>DATE</span><span class="text-black dark:text-[#FAF3DD]">${r.date}</span></div>
                        <div class="flex justify-between"><span>DTR / TIME</span><span class="text-black dark:text-[#FAF3DD]">${dtr}% / ${r.roastTime ? formatTime(r.roastTime) : '-'}</span></div>
                    </div>
                </div>`;
            });
            html += '</div>';
            container.innerHTML = html;
            if (window.lucide) lucide.createIcons();
        } else if (type === 'cupping') {
            await loadCuppingScores();
            if (cuppingScores.length === 0) {
                container.innerHTML = '<div class="card" style="text-align: center; padding: 40px; color: #666;"><p>No saved cupping forms found</p></div>';
                return;
            }
            
            let html = '<div style="display: grid; gap: 15px;">';
            cuppingScores.forEach(c => {
                const roast = roasts.find(r => r.id === c.roastBatchId) || {};
                const bean = inventory.find(b => b.id == roast.beanId) || { name: 'Unknown' };
                html += `<div class="card" style="padding: 15px;">
                    <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <h3 style="margin: 0 0 5px 0;">${bean.name}</h3>
                            <div style="font-size: 0.85rem; color: #666;">Date: ${c.cuppingDate} | Cupper: ${c.cupperName || 'N/A'} | Final Score: ${c.finalScore ? c.finalScore.toFixed(2) : 'N/A'}</div>
                        </div>
                        <button class="btn-outline" onclick="viewCuppingDetails(${c.id})" style="width: auto;">View Details</button>
                    </div>
                </div>`;
            });
            html += '</div>';
            container.innerHTML = html;
        }
    }

    function viewRoastDetails(roastId) {
        if(window.rl_openRoast) {
            window.rl_openRoast(roastId);
        } else {
            alert('Roast Lab is not loaded.');
        }
    }

    function viewCuppingDetails(cuppingId) {
        const cupping = cuppingScores.find(c => c.id === cuppingId);
        if (!cupping) {
            alert('Cupping form not found');
            return;
        }
        
