    function loadHerbertContent() {
        const saved = localStorage.getItem('herbert_content');
        if (!saved) return;
        
        try {
            const content = JSON.parse(saved);
            Object.keys(content).forEach(id => {
                const el = document.querySelector(`[data-herbert-id="${id}"]`);
                if (el) {
                    if (el.tagName === 'TEXTAREA') {
                        el.value = content[id];
                    } else {
                        el.innerHTML = content[id];
                    }
                }
            });
        } catch (e) {
            console.error('Error loading Herbert content:', e);
        }
    }

