        formData.append('costPerKg', document.getElementById('invCost').value || '');
        formData.append('hasCertificates', document.getElementById('invHasCertificates').value === 'true');
        
        const certFile = document.getElementById('invCertificate').files[0];
        if (certFile) {
            formData.append('certificate', certFile);
        }
        
        try {
            const response = await fetch('OS?handler=SaveInventory', {
                method: 'POST',
                body: formData
            });
