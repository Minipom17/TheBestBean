    // ========== HERBERT SESSION MANAGER ==========
    let herbertSessions = [
        {
            id: 1,
            name: "Session 001: Initial Assessment",
            grammar: [
                { original: "The coffee have a strong taste.", corrected: "The coffee <strong>has</strong> a <strong>robust</strong> profile." },
                { original: "I make the brew now.", corrected: "I am <strong>beginning</strong> the brew now." }
            ],
            pron: [
                { word: "Acidity", ipa: "/əˈsɪd.ɪ.ti/", note: "Stress 2nd syllable" },
                { word: "Specialty", ipa: "/ˈspeʃ.əl.ti/", note: "Sharp 'T' sound" }
            ],
            vocab: ["Viscous", "Astringent", "Extraction"]
        },
        {
            id: 2,
            name: "Session 002: Sourcing Vocabulary",
            grammar: [
                { original: "We buy the beans from farmer.", corrected: "We <strong>source</strong> the lots directly from the <strong>producer</strong>." }
            ],
            pron: [
                { word: "Origin", ipa: "/ˈɔːr.ə.dʒɪn/", note: "Soft 'g' sound" },
                { word: "Varietal", ipa: "/vəˈraɪ.ə.t̬əl/", note: "Long 'i' sound" }
            ],
            vocab: ["Direct Trade", "Microlot", "Cultivar", "Heirloom"]
        }
    ];

    let currentHerbertSessionId = 1;

    function loadHerbertSession(id) {
        currentHerbertSessionId = parseInt(id);
        const session = herbertSessions.find(s => s.id === currentHerbertSessionId);
        if (!session) return;

        // Update Grammar
        const gramContainer = document.getElementById('grammarContent');
        if (gramContainer) {
            gramContainer.innerHTML = session.grammar.map(g => `
                <div style="margin-bottom:1.5rem;">
                    <p style="margin:0; font-style:italic; color:#666;">"${g.original}"</p>
                    <div class="correction-box">${g.corrected}</div>
                </div>
            `).join('');
        }

        // Update Pronunciation
        const pronContainer = document.getElementById('pronContent');
        if (pronContainer) {
            pronContainer.innerHTML = session.pron.map(p => `
                <div style="margin-bottom:1rem;">
                    <strong>${p.word}</strong>
                    <p style="font-family:'JetBrains Mono', monospace; margin:0.2rem 0;">${p.ipa}</p>
                    <span style="font-size:0.8rem; color:#FF3B30;">${p.note}</span>
                </div>
            `).join('');
        }

        // Update Vocab
        const vocabContainer = document.getElementById('vocabContent');
        if (vocabContainer) {
            vocabContainer.innerHTML = session.vocab.map(v => `<span class="vocab-tag">${v}</span>`).join('');
        }
    }

    function addNewHerbertSession() {
        const name = prompt("Enter Session Name (e.g., Session 003: Roast Profiles):");
        if (name) {
            const newId = herbertSessions.length > 0 ? Math.max(...herbertSessions.map(s => s.id)) + 1 : 1;
            const newSession = {
                id: newId,
                name: name,
                grammar: [],
                pron: [],
                vocab: []
            };
            herbertSessions.push(newSession);
            currentHerbertSessionId = newId;
            renderHerbertDropdown();
            loadHerbertSession(newId);
            
            // Show Empty State
            const gramContainer = document.getElementById('grammarContent');
            const pronContainer = document.getElementById('pronContent');
            const vocabContainer = document.getElementById('vocabContent');
            if (gramContainer) gramContainer.innerHTML = '<p style="color:#999; font-style:italic;">No data yet. Upload transcript.</p>';
            if (pronContainer) pronContainer.innerHTML = '';
            if (vocabContainer) vocabContainer.innerHTML = '';
        }
    }

    function deleteHerbertSession() {
        if (confirm("Are you sure you want to delete this session?")) {
            herbertSessions = herbertSessions.filter(s => s.id !== currentHerbertSessionId);
            if (herbertSessions.length > 0) {
                currentHerbertSessionId = herbertSessions[0].id;
            } else {
                currentHerbertSessionId = null;
            }
            renderHerbertDropdown();
            if (currentHerbertSessionId) loadHerbertSession(currentHerbertSessionId);
        }
    }

    function renderHerbertDropdown() {
        const select = document.getElementById('sessionSelect');
        if (!select) return;
        select.innerHTML = '';
        herbertSessions.forEach(s => {
            const option = document.createElement('option');
            option.value = s.id;
            option.text = s.name;
            select.appendChild(option);
        });
        select.value = currentHerbertSessionId;
    }

    function simulateHerbertUpload() {
        const zone = document.getElementById('uploadZone');
        if (!zone) return;
        const originalText = zone.innerHTML;
        
        zone.innerHTML = '<h4 style="color:#FF3B30;">Analyzing Transcript...</h4><p>Extracting Grammar & Phonetics...</p>';
        
        setTimeout(() => {
            // Mock adding data to current session
            const session = herbertSessions.find(s => s.id === currentHerbertSessionId);
            if (session) {
                session.grammar.push({ original: "I think the coffee is good.", corrected: "I <strong>believe</strong> this coffee presents an <strong>elegant</strong> structure." });
                session.pron.push({ word: "Fermentation", ipa: "/ˌfɝː.menˈteɪ.ʃən/", note: "Clear 'shun' ending" });
                session.vocab.push("Anaerobic", "Thermal Shock");
                loadHerbertSession(currentHerbertSessionId);
            }
            zone.innerHTML = originalText;
            alert("Transcript Analyzed Successfully!");
        }, 1500);
    }

    // ========== VAULT MANAGER ==========
    let vaultModules = {};
    let currentVaultId = 1;

    function initVaultModules() {
        const saved = localStorage.getItem('vault_modules_data');
        if (saved) {
            try {
                vaultModules = JSON.parse(saved);
            } catch(e) { console.error("Error parsing saved vault modules", e); }
        }
        
        // If empty (first load), populate default
        if (Object.keys(vaultModules).length === 0) {
            vaultModules = {
                1: {
                    title: "Identify & Buy (Sourcing)",
                    subtitle: "STEP 1: ACQUISITION",
                    description: "Protocols for identifying farmers, buying samples first, and understanding contract terms.",
                    content: `
                        <div class="grid-2" style="margin-bottom:1rem; gap:1rem;">
                            <div style="padding:1rem; border:1px solid #e5e7eb;">
                                <strong>Contract Basics</strong>
                                <p style="font-size:0.9rem; color:#666;">FOB (Free on Board) vs CIF (Cost, Insurance, Freight).</p>
                            </div>
                            <div style="padding:1rem; border:1px solid #e5e7eb;">
                                <strong>Sample Protocol</strong>
                                <p style="font-size:0.9rem; color:#666;">Always request PSS (Pre-Shipment Sample) before final payment.</p>
                            </div>
                        </div>
                        <ul class="checklist">
                            <li>Identify origin seasonality (e.g., Ethiopia harvest in Jan-Mar).</li>
                            <li>Request Type Samples (Generic) vs Stock Lots (Specific).</li>
                        </ul>
                    `
                },
                2: {
                    title: "Test & Grade",
                    subtitle: "STEP 2: QUALITY CONTROL",
                    description: "Distinguishing between Physical Defects (Commercial) and Sensory Attributes (Specialty).",
                    content: `
                        <div class="grid-2" style="margin-bottom:1rem; gap:1rem;">
                            <div style="padding:1rem; border:1px solid #e5e7eb;">
                                <strong>Physical Grading</strong>
                                <p style="font-size:0.9rem; color:#666;">Counting stones, insect damage, broken beans. Crucial for commercial price negotiation.</p>
                            </div>
                            <div style="padding:1rem; border:1px solid #e5e7eb;">
                                <strong>SCA Sensory Grading</strong>
                                <p style="font-size:0.9rem; color:#666;">Scoring 0-100 based on Fragrance, Aroma, Acid, Body, Balance. 80+ is Specialty.</p>
                            </div>
                        </div>
                    `
                },
                3: {
                    title: "Place Orders & Repeat",
                    subtitle: "STEP 3: LOGISTICS",
                    description: "Logistics of placing the order, shipping, and establishing repeat business.",
                    content: `
                        <ul class="checklist">
                            <li>Confirm Incoterms (Who pays for shipping?).</li>
                            <li>Determine payment terms (Upfront vs Net 30).</li>
                            <li>Plan for warehousing and release schedule.</li>
                        </ul>
                    `
                }
            };
        }
        
        renderVaultDropdown();
        // Load the first available module if any
        const ids = Object.keys(vaultModules);
        if (ids.length > 0) {
            loadVaultModule(ids[0]);
        }
    }

    function saveVaultModules() {
        localStorage.setItem('vault_modules_data', JSON.stringify(vaultModules));
        renderVaultDropdown(); // Re-render to update titles if changed
    }

    function renderVaultDropdown() {
        const select = document.getElementById('vaultSelect');
        if (!select) return;
        select.innerHTML = '';
        Object.keys(vaultModules).forEach(id => {
            const m = vaultModules[id];
            const option = document.createElement('option');
            option.value = id;
            option.text = m.title; // Simplified display
            if (m.title.indexOf('.') === -1 && !isNaN(parseInt(id))) {
                 // Try to keep the numbering format if valuable, or just use title
                 // option.text = `0${id}. ${m.title}`; 
            }
            select.appendChild(option);
        });
        select.value = currentVaultId;
    }

    function addNewVaultModule() {
        const title = prompt("Enter Step Title (e.g., '04. Marketing Strategy'):");
        if (!title) return;
        const subtitle = prompt("Enter Subtitle (e.g., 'STEP 4: LAUNCH'):") || "NEW STEP";
        
        const ids = Object.keys(vaultModules).map(k => parseInt(k));
        const newId = ids.length > 0 ? Math.max(...ids) + 1 : 1;
        
        vaultModules[newId] = {
            title: title,
            subtitle: subtitle,
            description: "Description of this new step...",
            content: "<p>Start adding content here...</p>"
        };
        saveVaultModules();
        loadVaultModule(newId);
    }

    function deleteVaultModule() {
        if (!confirm("Are you sure you want to delete this step? This cannot be undone.")) return;
        delete vaultModules[currentVaultId];
        saveVaultModules();
        
        const ids = Object.keys(vaultModules);
        if (ids.length > 0) {
            loadVaultModule(ids[0]);
        } else {
            document.getElementById('vaultContentArea').innerHTML = '<div style="padding:2rem; text-align:center;">No steps available. Add a new one.</div>';
            currentVaultId = null;
        }
    }

    function loadVaultModule(idInput) {
        const id = parseInt(idInput);
        currentVaultId = id;
        
        // Update selection in dropdown
        const select = document.getElementById('vaultSelect');
        if (select) select.value = id;

        const module = vaultModules[id];
        const container = document.getElementById('vaultContentArea');
        if (!container) {
            console.error('vaultContentArea not found, retrying...');
            setTimeout(() => loadVaultModule(id), 200);
            return;
        }
        if (!module) {
            console.error('Vault module not found for id:', id);
            return;
        }
        
        console.log('Loading vault module:', id);
        
        container.innerHTML = `
            <div style="border:1px solid #e5e7eb; padding:2rem; background: #fff;">
                <div style="display:flex; justify-content:space-between; margin-bottom:1rem;">
                    <h4 style="margin:0;" contenteditable="true" data-herbert-id="vault-module-${id}-title">${module.title}</h4>
                    <span class="mono-text" style="font-family: 'JetBrains Mono', monospace; font-size:0.8rem; color:#FF3B30;">${module.subtitle}</span>
                </div>
                <p style="color:#666; font-size:1.1rem; border-bottom:1px solid #e5e7eb; padding-bottom:1rem;" contenteditable="true" data-herbert-id="vault-module-${id}-desc">${module.description}</p>
                
                <div style="margin-top:2rem;" contenteditable="true" data-herbert-id="vault-module-${id}-content">
                    ${module.content}
                </div>

                <div style="margin-top:2rem;">
                    <span class="section-label" style="color:#111111;">YOUR NOTES:</span>
                    <textarea class="notes-area" id="vault-notes-${id}" data-herbert-id="vault-notes-${id}" placeholder="Type your learning notes, contact details, or observations here..."></textarea>
                </div>
            </div>
        `;
        
        // Make inner content elements editable
        setTimeout(() => {
            const contentDiv = container.querySelector(`[data-herbert-id="vault-module-${id}-content"]`);
            if (contentDiv) {
                contentDiv.querySelectorAll('strong, p, li, div').forEach(el => {
                    if (!el.hasAttribute('contenteditable')) {
                        el.setAttribute('contenteditable', 'true');
                    }
                });
                // Re-initialize editable content handlers
                if (typeof initHerbertEditable === 'function') {
                    setTimeout(initHerbertEditable, 50);
                }
            }
        }, 100);
        
        // Load saved notes if any
        const savedNotes = localStorage.getItem(`vault_notes_${id}`);
        if (savedNotes) {
            const textarea = document.getElementById(`vault-notes-${id}`);
            if (textarea) textarea.value = savedNotes;
        }
        
        // Save notes on input
        const textarea = document.getElementById(`vault-notes-${id}`);
        if (textarea) {
            textarea.addEventListener('input', debounce(() => {
                localStorage.setItem(`vault_notes_${id}`, textarea.value);
            }, 500));
        }

        // Attach listeners to editable fields to auto-save to vaultModules
        const titleEl = document.querySelector(`[data-herbert-id="vault-module-${id}-title"]`);
        if(titleEl) titleEl.addEventListener('blur', () => { vaultModules[id].title = titleEl.innerText; saveVaultModules(); });
        
        const subEl = document.querySelector(`[data-herbert-id="vault-module-${id}-subtitle"]`);
        if(subEl) subEl.addEventListener('blur', () => { vaultModules[id].subtitle = subEl.innerText; saveVaultModules(); });
        
        const descEl = document.querySelector(`[data-herbert-id="vault-module-${id}-desc"]`);
        if(descEl) descEl.addEventListener('blur', () => { vaultModules[id].description = descEl.innerText; saveVaultModules(); });
        
        const contentAreaEl = document.querySelector(`[data-herbert-id="vault-module-${id}-content"]`);
        if(contentAreaEl) contentAreaEl.addEventListener('blur', () => { vaultModules[id].content = contentAreaEl.innerHTML; saveVaultModules(); });
    }

