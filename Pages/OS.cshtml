    function initHerbertEditable() {
        // Load saved content
        loadHerbertContent();
        
        // Add event listeners to all editable elements
        const editableElements = document.querySelectorAll('[data-herbert-id]');
        editableElements.forEach(el => {
            // Save on blur (when user finishes editing)
            el.addEventListener('blur', saveHerbertContent);
            // Save on Enter key (for better UX)
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey && el.tagName !== 'TEXTAREA') {
                    e.preventDefault();
                    el.blur();
                }
            });
        });
        
        // Handle textarea separately
        const textareas = document.querySelectorAll('#vault-step1-notes');
        textareas.forEach(ta => {
            ta.addEventListener('input', debounce(saveHerbertContent, 500));
        });
    }

    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

