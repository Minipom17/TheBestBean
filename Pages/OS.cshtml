                document.getElementById('invWeight').value = '';
                document.getElementById('invCost').value = '';
                document.getElementById('invHasCertificates').value = 'false';
                document.getElementById('invCertificate').value = '';
                document.getElementById('certificateUploadRow').style.display = 'none';
            } else {
                const errorText = await response.text();
                console.error('Error saving bean:', response.status, errorText);
                alert('Error saving bean: ' + (errorText || response.statusText || 'Unknown error'));
