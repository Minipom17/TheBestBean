    function buildSCAForm() {
        const container = document.getElementById('sampleRowsContainer');
        const tmpl = document.getElementById('scaRowTemplate');
        container.innerHTML = '';
        for(let i=1; i<=3; i++) {
            const clone = tmpl.content.cloneNode(true);
            const row = clone.querySelector('.sample-container');
            row.id = `row-${i}`;
            ['uni','sweet','clean'].forEach(type => {
                const grp = row.querySelector(`.check-${type}`);
                grp.querySelectorAll('.sq-check').forEach(sq => {
                    sq.onclick = function() { this.classList.toggle('checked'); calc(row.id); };
                });
            });
            row.querySelectorAll('input').forEach(inp => { inp.oninput = () => calc(row.id); });
            container.appendChild(clone);
        }
    }
    
    function limitInput(el) { let v = parseFloat(el.value); if(v > 10) el.value = 10; calc(el.closest('.sample-container').id); }
