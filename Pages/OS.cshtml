    function exportRoastLogCSV() { 
        if (!currentRoast.data || currentRoast.data.length === 0) {
            alert('No roast data to export');
            return;
        }
        
        let csv = "Time,Temperature,RoR,Events\n";
        currentRoast.data.forEach((point, index) => {
            const timeStr = formatTime(point.time);
            const temp = point.temp !== null && point.temp !== undefined ? point.temp : '';
            const ror = point.ror !== null && point.ror !== undefined ? point.ror.toFixed(2) : '';
            
            // Find events at this time point (within 30 seconds)
            const eventsAtTime = currentRoast.events.filter(e => Math.abs(e.time - point.time) <= 30);
            const eventStr = eventsAtTime.map(e => e.type).join('; ') || '';
            
            csv += `${timeStr},${temp},${ror},"${eventStr}"\n`;
        });
        
        // Add summary at the end
        const beanSelect = document.getElementById('roastBeanSelect');
        const beanName = beanSelect.options[beanSelect.selectedIndex]?.text || 'Unknown Bean';
        const greenWeight = document.getElementById('greenWeight').value || '';
        const roastedWeight = document.getElementById('roastedWeight').value || '';
        const notes = document.getElementById('roastNotes').value || '';
        
        csv += "\n";
        csv += "Summary\n";
        csv += `Bean,${beanName}\n`;
        csv += `Green Weight (g),${greenWeight}\n`;
        csv += `Roasted Weight (g),${roastedWeight}\n`;
        csv += `Total Time,${formatTime(secondsElapsed)}\n`;
        if (notes) {
            csv += `Notes,"${notes.replace(/"/g, '""')}"\n`;
        }
        
        downloadFile(csv, `roast_log_${new Date().toISOString().split('T')[0]}.csv`);
    }
    function downloadFile(c,n) { const a=document.createElement('a'); a.href="data:text/csv;charset=utf-8,"+encodeURI(c); a.download=n; a.click(); }
    function formatTime(s) { return `${Math.floor(s/60)}:${(s%60).toString().padStart(2,'0')}`; }
    function triggerEvent(n) { document.getElementById('roastNotes').value += `[${formatTime(secondsElapsed)}] ${n}\n`; currentRoast.events.push({type:n, time:secondsElapsed}); }
    function populateQCDropdown() { const s = document.getElementById('qcRoastSelect'); s.innerHTML='<option value="">-- Select Batch --</option>'; roasts.forEach(r => { const b=inventory.find(x=>x.id==r.beanId)||{name:'Unknown'}; s.innerHTML+=`<option value="${r.id}">${b.name} (${r.date})</option>`; }); }
    function calcLoss() { 
        const green = parseFloat(document.getElementById('greenWeight').value) || 0;
        const roasted = parseFloat(document.getElementById('roastedWeight').value) || 0;
        if (green > 0) {
            const loss = ((green - roasted) / green * 100).toFixed(2);
            document.getElementById('staticLoss').innerText = loss + '%';
        }
    }
    // Duplicate loadBeanDetails removed

