    async function saveBean() { 
        const beanId = parseInt(document.getElementById('invId').value) || 0;
        const name = document.getElementById('invName').value;
        if(!name) return alert('Name is required');
        
        const formData = new FormData();
        formData.append('id', beanId);
        formData.append('name', name);
        formData.append('country', document.getElementById('invCountry').value || '');
        formData.append('farmer', document.getElementById('invFarmer').value || '');
        formData.append('process', document.getElementById('invProcess').value || '');
