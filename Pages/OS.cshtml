<script>
    const translations = {
        en: { nav_stock:"Stock", nav_roast:"Roast", nav_sca:"SCA", nav_mode:"Mode", btn_add_bean:"+ Add Bean", new_shipment:"New Shipment", lbl_name:"Name", lbl_country:"Country", lbl_farmer:"Farmer", lbl_process:"Process", lbl_weight:"Weight (kg)", lbl_cost:"Cost/kg", btn_save:"Save Stock", btn_cancel:"Cancel", btn_start:"START ROAST", lbl_select_bean:"Select Bean", lbl_overlay:"Ghost Overlay", lbl_green:"Green (g)", lbl_roasted:"Roasted (g)", lbl_temp_check:"Temp Check", lbl_notes:"Batch Notes", btn_save_batch:"💾 Save Batch", btn_image:"📸 Image" },
        es: { nav_stock:"Inventario", nav_roast:"Tueste", nav_sca:"SCA", nav_mode:"Modo", btn_add_bean:"+ Nuevo", new_shipment:"Nueva Carga", lbl_name:"Nombre", lbl_country:"País", lbl_farmer:"Productor", lbl_process:"Proceso", lbl_weight:"Peso (kg)", lbl_cost:"Costo/kg", btn_save:"Guardar", btn_cancel:"Cancelar", btn_start:"INICIAR", lbl_select_bean:"Elegir Grano", lbl_overlay:"Superponer", lbl_green:"Verde (g)", lbl_roasted:"Tostado (g)", lbl_temp_check:"Control Temp", lbl_notes:"Notas Lote", btn_save_batch:"💾 Guardar", btn_image:"📸 Imagen" },
        cn: { nav_stock:"库存", nav_roast:"烘焙", nav_sca:"杯测", nav_mode:"模式", btn_add_bean:"+ 添加生豆", new_shipment:"新进货", lbl_name:"名称", lbl_country:"国家", lbl_farmer:"农场", lbl_process:"处理法", lbl_weight:"重量 (kg)", lbl_cost:"成本/kg", btn_save:"保存", btn_cancel:"取消", btn_start:"开始烘焙", lbl_select_bean:"选择生豆", lbl_overlay:"参考曲线", lbl_green:"生豆 (g)", lbl_roasted:"熟豆 (g)", lbl_temp_check:"温度检查", lbl_notes:"烘焙笔记", btn_save_batch:"💾 保存", btn_image:"📸 截图" }
    };
    function setLang(lang) { const t = translations[lang]; if(!t)return; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.dataset.i18n; if(t[k]) el.innerText=t[k]; }); }

    let inventory = [];
    let roasts = [];
    let cuppingScores = [];
    let currentRoast = { data: [], events: [] };
    let timerInterval, secondsElapsed = 0, isRunning = false, roastChart, activeOverlays = [];
    const overlayColors = ['#bdc3c7', '#e67e22', '#9b59b6', '#e74c3c', '#1abc9c'];

    window.onload = async function() {
        // Initialize Herbert session manager if on Herbert tab
        if (document.getElementById('view-herbert') && document.getElementById('view-herbert').classList.contains('active')) {
            renderHerbertDropdown();
            loadHerbertSession(currentHerbertSessionId);
            // Load vault with a delay to ensure DOM is ready
            setTimeout(() => {
                initVaultModules();
            }, 300);
            // Initialize editable content
            setTimeout(initHerbertEditable, 200);
        }
        initChart(); 
        await loadInventory(); 
        await loadRoasts();
        await loadCuppingScores();
        renderInventory(); 
        populateRoastDropdown(); 
        initRoastTable(); 
        populateOverlayDropdown(); 
        populateQCDropdown();
        document.getElementById('qcDate').innerText = new Date().toLocaleDateString();
        buildSCAForm();
    };

    // API Functions
    async function loadInventory() {
        try {
            const response = await fetch('OS?handler=Inventory');
            if (response.ok) {
                inventory = await response.json();
            }
        } catch (error) {
            console.error('Error loading inventory:', error);
        }
    }

    async function loadRoasts() {
        try {
            const response = await fetch('OS?handler=Roasts');
            if (response.ok) {
                const data = await response.json();
                roasts = data.map(r => ({
                    id: r.id,
                    beanId: r.beanId,
                    beanName: r.beanName,
                    date: r.date,
                    roastTime: r.roastTime,
                    data: r.data ? JSON.parse(r.data) : [],
                    events: r.events ? JSON.parse(r.events) : []
                }));
            }
        } catch (error) {
            console.error('Error loading roasts:', error);
        }
    }

    async function loadCuppingScores() {
        try {
            const response = await fetch('OS?handler=CuppingScores');
            if (response.ok) {
                cuppingScores = await response.json();
            }
        } catch (error) {
            console.error('Error loading cupping scores:', error);
        }
    }

    // ========== HERBERT EDITABLE CONTENT MANAGER ==========
    function saveHerbertContent() {
        const editableElements = document.querySelectorAll('[data-herbert-id]');
        const content = {};
        editableElements.forEach(el => {
            const id = el.getAttribute('data-herbert-id');
            if (el.tagName === 'TEXTAREA') {
                content[id] = el.value;
            } else {
                content[id] = el.innerHTML;
            }
        });
        localStorage.setItem('herbert_content', JSON.stringify(content));
