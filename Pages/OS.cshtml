    async function saveRoastAndDeduct() { 
        const bid=document.getElementById('roastBeanSelect').value; 
        if(!bid) return alert("Select Bean");
        
        // Calculate weight loss
        const greenWeight = parseFloat(document.getElementById('greenWeight').value) || 0;
        const roastedWeight = parseFloat(document.getElementById('roastedWeight').value) || 0;
        const weightLossPercent = greenWeight > 0 ? ((greenWeight - roastedWeight) / greenWeight * 100) : null;
        
        // Extract event times
        const events = currentRoast.events || [];
        const firstCrackTime = events.find(e => e.type === 'FC')?.time || null;
        const dropTime = events.find(e => e.type === 'DROP')?.time || null;
        const turnPointTime = events.find(e => e.type === 'TP')?.time || null;
        const dryEndTime = events.find(e => e.type === 'Dry')?.time || null;
        
        // Extract Planner Variables
        const plannerAgtron = document.getElementById('plannerAgtron') ? document.getElementById('plannerAgtron').value : '';
        const plannerStrat = document.getElementById('plannerDevStrategy') ? document.getElementById('plannerDevStrategy').value : '';
        const chargeTemp = document.getElementById('plannerCharge') ? document.getElementById('plannerCharge').value : '';
        const dropTemp = document.getElementById('plannerDrop') ? document.getElementById('plannerDrop').value : '';
        
        let notesText = document.getElementById('roastNotes').value || '';
        if (plannerAgtron || chargeTemp) {
            notesText = `[PLAN] Agtron: #${plannerAgtron} | Strat: ${plannerStrat} | Charge: ${chargeTemp}C | Drop: ${dropTemp}C\n\n` + notesText;
        }

        const roastData = {
            beanId: parseInt(bid),
            roastTimeSeconds: secondsElapsed || null,
            greenWeight: greenWeight,
            roastedWeight: roastedWeight,
            weightLossPercent: weightLossPercent,
            dTRPercent: parseFloat(document.getElementById('dtrValue').innerText) || null,
            firstCrackTime: firstCrackTime,
            dropTime: dropTime,
            turnPointTime: turnPointTime,
            dryEndTime: dryEndTime,
            temperatureData: currentRoast.data,
            events: events,
            notes: notesText || null
        };
        
        try {
            const response = await fetch('OS?handler=SaveRoast', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(roastData)
            });
            if (response.ok) {
                await loadRoasts();
                populateOverlayDropdown();
                alert("Roast saved successfully!");
            } else {
                alert('Error saving roast');
            }
        } catch (error) {
            console.error('Error saving roast:', error);
            alert('Error saving roast');
        }
    }
