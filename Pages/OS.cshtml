        details += `Date: ${cupping.cuppingDate}\n`;
        details += `Cupper: ${cupping.cupperName || 'N/A'}\n`;
        details += `Lot Number: ${cupping.lotNumber || 'N/A'}\n`;
        details += `Final Score: ${cupping.finalScore ? cupping.finalScore.toFixed(2) : 'N/A'}\n`;
        details += `\nScores:\n`;
        details += `  Fragrance: ${cupping.fragranceScore || 'N/A'}\n`;
        details += `  Flavor: ${cupping.flavorScore || 'N/A'}\n`;
        details += `  Aftertaste: ${cupping.aftertasteScore || 'N/A'}\n`;
        details += `  Acidity: ${cupping.acidityScore || 'N/A'}\n`;
        details += `  Body: ${cupping.bodyScore || 'N/A'}\n`;
        details += `  Balance: ${cupping.balanceScore || 'N/A'}\n`;
        details += `  Overall: ${cupping.overallScore || 'N/A'}\n`;
        
        alert(details);
