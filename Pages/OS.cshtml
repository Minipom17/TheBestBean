    function calc(rowId) {
        const row = document.getElementById(rowId);
        let attrSum = 0;
        ['frag','flav','after','acid','body','bal','overall'].forEach(k => { attrSum += (parseFloat(row.querySelector(`.sc-${k}`).value) || 0); });
        let sysSum = 0;
        ['uni','sweet','clean'].forEach(k => { sysSum += (row.querySelector(`.check-${k}`).querySelectorAll('.checked').length * 2); });
        const defects = (parseFloat(row.querySelector('.d-cups').value)||0) * 2; 
        const total = attrSum + sysSum - defects;
        row.querySelector('.final-score-disp').innerText = total.toFixed(2);
    }

