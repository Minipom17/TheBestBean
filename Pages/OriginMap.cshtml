@page
@model TheBestBean.Pages.OriginMapModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Origin Map";
    ViewData["HideDeliveryFloat"] = true;
}
@Html.AntiForgeryToken()

<div class="fixed inset-0 w-full h-full z-[100] overflow-hidden bg-white dark:bg-[#1A2315]" id="map-wrapper">

    <!-- EXIT BUTTON -->
    <button type="button" onclick="history.back()" class="absolute top-6 right-6 z-50 w-10 h-10 bg-black text-white dark:bg-white dark:text-black border-none flex items-center justify-center hover:bg-red-600 dark:hover:bg-red-600 dark:hover:text-white transition-colors cursor-pointer text-xl font-mono-jb no-underline" aria-label="Close map">
        &times;
    </button>

    <!-- FLOATING LEGEND — desktop only (no TOC / legend on mobile) -->
    <div class="hidden md:flex absolute top-6 left-6 z-50 bg-white/90 dark:bg-[#111111]/90 text-black dark:text-white backdrop-blur-md shadow-sm p-6 w-[240px] rounded-lg border border-gray-200 dark:border-none flex-col max-h-[calc(100vh-3rem)]">
        <h3 class="font-mono-jb text-[11px] uppercase tracking-widest font-bold mb-4 border-b border-gray-300 dark:border-gray-600 pb-2">Legend</h3>

        <ul class="flex flex-col gap-2 font-mono-jb text-[9px] uppercase tracking-wider m-0 p-0 list-none overflow-y-auto pr-2 flex-grow" id="map-legend">
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="megantoni">
                <div class="w-3 h-3 rounded-full bg-[#82C341]"></div>
                <span>Megantoni</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="echarati">
                <div class="w-3 h-3 rounded-full bg-[#00B4D8]"></div>
                <span>Echarati</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="quellouno">
                <div class="w-3 h-3 rounded-full bg-[#C2F970]"></div>
                <span>Quellouno</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="pichari">
                <div class="w-3 h-3 rounded-full bg-[#E5F5A1]"></div>
                <span>Pichari</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="kimbiri">
                <div class="w-3 h-3 rounded-full bg-[#B5E48C]"></div>
                <span>Kimbiri</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="villa-virgen">
                <div class="w-3 h-3 rounded-full bg-[#52796F]"></div>
                <span>Villa Virgen</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="vilcabamba">
                <div class="w-3 h-3 rounded-full bg-[#F4A261]"></div>
                <span>Vilcabamba</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="santa-ana">
                <div class="w-3 h-3 rounded-full bg-[#E76F51]"></div>
                <span>Santa Ana</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="huayopata">
                <div class="w-3 h-3 rounded-full bg-[#D62828]"></div>
                <span>Huayopata</span>
            </li>
            <li class="flex items-center gap-4 cursor-pointer hover:text-v-red transition-colors" data-target="ocobamba">
                <div class="w-3 h-3 rounded-full bg-[#4EA8DE]"></div>
                <span>Ocobamba</span>
            </li>
        </ul>

        <div class="mt-6 pt-3 border-t border-gray-300 dark:border-gray-600 shrink-0">
            <button type="button" id="reset-map" class="w-full bg-transparent border-none text-left p-0 font-mono-jb text-[10px] uppercase tracking-widest font-bold text-black dark:text-white hover:text-red-600 transition-colors cursor-pointer">
                Reveal All
            </button>
        </div>
    </div>

    <!-- PANZOOM CONTAINER — no mix-blend (it blanks the map under transform on mobile) -->
    <div id="map-viewport" class="w-full h-full relative overflow-hidden touch-none">
        <div id="panzoom-element" class="origin-center will-change-transform">
            <img src="/Media/LaConvencionMap.svg"
                 class="block max-w-none w-[2000px] h-auto select-none"
                 alt="Map of La Convención"
                 id="svg-map"
                 draggable="false" />
        </div>
    </div>

    <!-- MAP CONTROLS -->
    <div class="absolute bottom-6 right-6 z-50 flex flex-col gap-2">
        <button type="button" id="zoom-in" class="w-10 h-10 bg-black text-white dark:bg-white dark:text-black border-none flex items-center justify-center hover:bg-red-600 dark:hover:bg-red-600 dark:hover:text-white transition-colors cursor-pointer text-lg font-mono-jb" aria-label="Zoom in">+</button>
        <button type="button" id="zoom-out" class="w-10 h-10 bg-black text-white dark:bg-white dark:text-black border-none flex items-center justify-center hover:bg-red-600 dark:hover:bg-red-600 dark:hover:text-white transition-colors cursor-pointer text-lg font-mono-jb" aria-label="Zoom out">−</button>
    </div>
</div>

@section Styles {
    <style>
        .active-legend {
            color: #DC2626 !important;
        }
        /* Keep transformed map painting on its own layer (avoids mobile blank frames). */
        #panzoom-element,
        #svg-map {
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            backface-visibility: hidden;
        }
        html.dark #svg-map {
            opacity: 0.85;
            filter: invert(0.92) hue-rotate(180deg);
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@panzoom/panzoom/dist/panzoom.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const elem = document.getElementById('panzoom-element');
            const viewport = document.getElementById('map-viewport');
            const img = document.getElementById('svg-map');
            if (!elem || !viewport || !img || typeof Panzoom !== 'function') return;

            const imgWidth = 2000;
            const imgHeight = 1125;
            const isMobile = window.innerWidth < 768;

            function fitScale() {
                const availableHeight = viewport.clientHeight || window.innerHeight;
                const availableWidth = viewport.clientWidth || window.innerWidth;
                return Math.min(availableWidth / imgWidth, availableHeight / imgHeight);
            }

            const base = fitScale();
            // Mobile: fill more of the screen; desktop: leave room for the legend.
            const start = isMobile ? Math.min(base * 1.35, 2.2) : Math.min(base * 1.15, 1.8);

            const pz = Panzoom(elem, {
                maxScale: 5,
                minScale: Math.max(base * 0.55, 0.2),
                startScale: start,
                startX: isMobile ? 0 : 180,
                startY: 0,
                contain: false,
                cursor: 'grab',
                animate: true
            });

            viewport.addEventListener('wheel', pz.zoomWithWheel, { passive: false });

            // Touch pinch / drag — panzoom binds to the element; ensure parent doesn't scroll.
            viewport.addEventListener('touchmove', (e) => {
                if (e.cancelable) e.preventDefault();
            }, { passive: false });

            document.getElementById('zoom-in')?.addEventListener('click', () => pz.zoomIn({ animate: true }));
            document.getElementById('zoom-out')?.addEventListener('click', () => pz.zoomOut({ animate: true }));

            const locations = {
                'megantoni': { x: 50, y: 30, scale: 2.2 },
                'echarati': { x: 45, y: 55, scale: 2.2 },
                'quellouno': { x: 65, y: 55, scale: 2.2 },
                'pichari': { x: 25, y: 50, scale: 2.6 },
                'kimbiri': { x: 30, y: 60, scale: 2.6 },
                'villa-virgen': { x: 35, y: 70, scale: 3 },
                'vilcabamba': { x: 45, y: 80, scale: 2.2 },
                'santa-ana': { x: 55, y: 75, scale: 3 },
                'huayopata': { x: 65, y: 85, scale: 2.6 },
                'ocobamba': { x: 65, y: 75, scale: 2.6 }
            };

            const legendItems = document.querySelectorAll('#map-legend li');
            legendItems.forEach(item => {
                item.addEventListener('click', () => {
                    legendItems.forEach(li => li.classList.remove('active-legend'));
                    item.classList.add('active-legend');

                    const loc = locations[item.getAttribute('data-target')];
                    if (!loc) return;

                    const containerRect = viewport.getBoundingClientRect();
                    const targetX = imgWidth * (loc.x / 100);
                    const targetY = imgHeight * (loc.y / 100);
                    const centerX = containerRect.width / 2;
                    const centerY = containerRect.height / 2;

                    pz.zoom(loc.scale, { animate: true });
                    setTimeout(() => {
                        pz.pan(centerX - targetX * loc.scale, centerY - targetY * loc.scale, { animate: true });
                    }, 120);
                });
            });

            document.getElementById('reset-map')?.addEventListener('click', () => {
                legendItems.forEach(li => li.classList.remove('active-legend'));
                pz.reset({ animate: true });
            });

            // Re-fit on rotate / resize so the map doesn't vanish off-canvas.
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    const next = fitScale();
                    pz.setOptions({ minScale: Math.max(next * 0.55, 0.2) });
                }, 150);
            });
        });
    </script>
}
