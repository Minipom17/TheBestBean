@page "{slug}"
@model TheBestBean.Pages.PostModel
@{
    ViewData["Title"] = Model.BlogPost?.Title ?? "Blog Post Not Found";
    Layout = "_Layout";
    
    if (Model.BlogPost != null)
    {
        var rawContent = System.Text.RegularExpressions.Regex.Replace(Model.BlogPost.Content ?? "", "<.*?>", string.Empty);
        ViewData["MetaDescription"] = rawContent.Length > 155 ? rawContent.Substring(0, 152) + "..." : rawContent;
        ViewData["OgType"] = "article";
        if (!string.IsNullOrEmpty(Model.BlogPost.ImageUrl))
        {
            var request = ViewContext.HttpContext.Request;
            var baseUrl = $"{request.Scheme}://{request.Host}";
            ViewData["MetaImage"] = Model.BlogPost.ImageUrl.StartsWith("http") ? Model.BlogPost.ImageUrl : baseUrl + Model.BlogPost.ImageUrl;
        }
    }
}

@if (Model.BlogPost == null)
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <h1 class="text-4xl font-mono-jb uppercase font-bold text-v-black dark:text-[#D6D0C8]">Post Not Found</h1>
        <p class="mt-4 text-v-gray dark:text-gray-300">The blog post you are looking for does not exist.</p>
        <a asp-page="/Blog" class="mt-8 inline-block bg-v-red px-6 py-3 text-white font-mono-jb uppercase tracking-widest hover:bg-v-red/90 transition-colors">Back to Blog</a>
    </div>
}
else
{
    <article class="bg-white dark:bg-v-black">
        <!-- Hero Header -->
        <header class="relative bg-white dark:bg-v-black py-24 sm:py-32 overflow-hidden border-b border-v-black/10 dark:border-[#2A262C]">
            @if (!string.IsNullOrEmpty(Model.BlogPost.ImageUrl))
            {
                <div class="absolute inset-0 z-0">
                    <img src="@Model.BlogPost.ImageUrl" alt="@Model.BlogPost.Title" class="w-full h-full object-cover opacity-10">
                </div>
            }
            <div class="relative z-10 max-w-[1600px] mx-auto px-6 md:px-12 text-left">
                <div class="mb-6">
                    <time datetime="@Model.BlogPost.PublishedAt?.ToString("yyyy-MM-dd")" class="text-v-red font-mono-jb uppercase tracking-widest text-[10px] font-bold">@Model.BlogPost.PublishedAt?.ToString("MMMM dd, yyyy")</time>
                </div>
                <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] uppercase mb-6">
                    @Model.BlogPost.Title
                </h1>
                <p class="text-xl text-v-gray font-mono-jb max-w-2xl leading-relaxed">
                    By <span class="font-bold text-v-black dark:text-[#D6D0C8]">@Model.BlogPost.Author</span>
                </p>
            </div>
        </header>

        <!-- Article Body -->
        <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-16 sm:py-24">
            <div class="prose prose-lg dark:prose-invert prose-p:font-sans prose-p:text-v-black dark:prose-p:text-[#D6D0C8] prose-headings:font-bold prose-headings:uppercase prose-headings:tracking-tighter prose-a:text-v-red max-w-4xl">
                @Html.Raw(Model.BlogPost.Content)
            </div>
        <div class="mt-16 pt-8 border-t border-v-black/10 dark:border-[#2A262C] flex justify-center pb-24">
            <a asp-page="/Blog" class="inline-flex items-center text-v-red hover:text-v-black dark:hover:text-[#D6D0C8] font-mono-jb uppercase tracking-widest transition-colors text-xs font-bold text-decoration-none">
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                RETURN TO CHRONICLES
            </a>
        </div>
    </article>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Article",
      "headline": "@Html.Raw(Model.BlogPost.Title)",
      "image": [ "@Html.Raw(Model.BlogPost.ImageUrl)" ],
      "datePublished": "@(Model.BlogPost.PublishedAt?.ToString("O"))",
      "author": [{
          "@@type": "Person",
          "name": "@Html.Raw(Model.BlogPost.Author)"
      }]
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [{
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://purplebean.coffee/"
      },{
        "@@type": "ListItem",
        "position": 2,
        "name": "Chronicles",
        "item": "https://purplebean.coffee/Blog"
      },{
        "@@type": "ListItem",
        "position": 3,
        "name": "@Html.Raw(Model.BlogPost.Title)"
      }]
    }
    </script>
}
