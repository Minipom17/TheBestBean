@page "{slug}"
@model TheBestBean.Pages.PostModel
@{
    ViewData["Title"] = Model.BlogPost?.Title ?? "Blog Post Not Found";
    Layout = "_Layout";
    
    if (Model.BlogPost != null)
    {
        var rawContent = System.Text.RegularExpressions.Regex.Replace(Model.BlogPost.Content ?? "", "<.*?>", string.Empty);
        ViewData["MetaDescription"] = rawContent.Length > 155 ? rawContent.Substring(0, 152) + "..." : rawContent;
        ViewData["OgType"] = "article";
        if (!string.IsNullOrEmpty(Model.BlogPost.ImageUrl))
        {
            var request = ViewContext.HttpContext.Request;
            var baseUrl = $"{request.Scheme}://{request.Host}";
            ViewData["MetaImage"] = Model.BlogPost.ImageUrl.StartsWith("http") ? Model.BlogPost.ImageUrl : baseUrl + Model.BlogPost.ImageUrl;
        }
    }
}

<style>
    .blog-hero {
        background: #004E45 !important;
        color: #DEFFAF !important;
    }
    .blog-hero h1, html.dark .blog-hero h1 { color: #DEFFAF !important; }
    .blog-hero__kicker { color: #FFC6FF !important; }
    .blog-hero__lede { color: #DEFFAF !important; }
    .blog-post-body {
        background: #ffffff !important;
        color: #004E45 !important;
    }
    html.dark .blog-post-body { background: #ffffff !important; }
    .blog-prose,
    .blog-prose p,
    .blog-prose li,
    .blog-prose span,
    html.dark .blog-prose,
    html.dark .blog-prose p { color: #004E45 !important; }
    .blog-prose h1, .blog-prose h2, .blog-prose h3, .blog-prose h4,
    html.dark .blog-prose h1, html.dark .blog-prose h2, html.dark .blog-prose h3 {
        color: #801620 !important;
    }
    .blog-prose a, html.dark .blog-prose a { color: #801620 !important; }
    .blog-back, html.dark .blog-back { color: #801620 !important; }
    .blog-post-body__rule { border-top: 1px solid #e5e5e5; }
</style>

@if (Model.BlogPost == null)
{
    <div class="blog-page">
        <div class="blog-hero py-24 text-center">
            <p class="blog-hero__kicker font-mono-jb uppercase tracking-widest text-[10px] font-bold">Blog</p>
            <h1 class="text-4xl font-mono-jb uppercase font-bold">Post Not Found</h1>
            <p class="mt-4 blog-hero__lede">The blog post you are looking for does not exist.</p>
            <a asp-page="/Blog" class="mt-8 inline-block font-mono-jb uppercase tracking-widest blog-back">Back to Blog</a>
        </div>
    </div>
}
else
{
    <article class="blog-page">
        <header class="blog-hero blog-hero--post relative py-24 sm:py-32 overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.BlogPost.ImageUrl))
            {
                <div class="absolute inset-0 z-0">
                    <img src="@Model.BlogPost.ImageUrl" alt="@Model.BlogPost.Title" class="w-full h-full object-cover opacity-15">
                </div>
            }
            <div class="relative z-10 max-w-[1600px] mx-auto px-6 md:px-12 text-left">
                <div class="mb-6">
                    <time datetime="@Model.BlogPost.PublishedAt?.ToString("yyyy-MM-dd")" class="blog-hero__kicker font-mono-jb uppercase tracking-widest text-[10px] font-bold">@Model.BlogPost.PublishedAt?.ToString("MMMM dd, yyyy")</time>
                </div>
                <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-tighter uppercase mb-6">
                    @Model.BlogPost.Title
                </h1>
                <p class="blog-hero__lede font-mono-jb max-w-2xl leading-relaxed">
                    By <span class="font-bold">@Model.BlogPost.Author</span>
                </p>
            </div>
        </header>

        <div class="blog-post-body">
            <div class="max-w-[1600px] mx-auto px-6 md:px-12 py-16 sm:py-24">
                <div class="blog-prose max-w-4xl">
                    @Html.Raw(Model.BlogPost.Content)
                </div>
                <div class="mt-16 pt-8 blog-post-body__rule flex justify-center pb-24">
                    <a asp-page="/Blog" class="blog-back font-mono-jb uppercase tracking-widest text-xs font-bold text-decoration-none inline-flex items-center">
                        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                        RETURN TO CHRONICLES
                    </a>
                </div>
            </div>
        </div>
    </article>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Article",
      "headline": "@Html.Raw(Model.BlogPost.Title)",
      "image": [ "@Html.Raw(Model.BlogPost.ImageUrl)" ],
      "datePublished": "@(Model.BlogPost.PublishedAt?.ToString("O"))",
      "author": [{
          "@@type": "Person",
          "name": "@Html.Raw(Model.BlogPost.Author)"
      }]
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [{
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://purplebean.coffee/"
      },{
        "@@type": "ListItem",
        "position": 2,
        "name": "Chronicles",
        "item": "https://purplebean.coffee/Blog"
      },{
        "@@type": "ListItem",
        "position": 3,
        "name": "@Html.Raw(Model.BlogPost.Title)"
      }]
    }
    </script>
}
