@page "/Product/{id}"
@model TheBestBean.Pages.ProductModel
@using System.Net
@{
    ViewData["Title"] = Model.Product?.Name ?? "Product Details";
    if (Model.Product != null)
    {
        ViewData["MetaDescription"] = $"Buy {Model.Product.Name}, a premium {Model.Product.Type.ToLower()} from {Model.Product.Origin}. {Model.Product.Description}";
        ViewData["OgType"] = "product";
        if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
        {
            var request = ViewContext.HttpContext.Request;
            var baseUrl = $"{request.Scheme}://{request.Host}";
            ViewData["MetaImage"] = Model.Product.ImageUrl.StartsWith("http") ? Model.Product.ImageUrl : baseUrl + Model.Product.ImageUrl;
        }
    }
}

@if (Model.Product != null)
{
    <!-- Back Button -->
    <article class="container-fluid px-6 py-8" style="max-width: 1400px; margin: 0 auto;">
        <a href="/Coffee" class="flex items-center gap-2 text-xs font-mono font-bold mb-8 hover:text-swiss-red transition-colors" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; font-weight: 700; margin-bottom: 2rem; color: #111; text-decoration: none; transition: color 0.3s; background: none; border: none; cursor: pointer; padding: 0;">
            <i class="bi bi-arrow-left"></i> BACK TO CATALOG
        </a>

        <!-- 1. Main Header -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-start mb-24 relative" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; align-items: start; margin-bottom: 6rem; position: relative;">
            <div class="w-full">
                <div class="w-full aspect-square overflow-hidden bg-white dark:bg-[#313A29] relative rounded-2xl md:rounded-3xl shadow-sm border border-gray-100 dark:border-[#445239] mb-4" style="margin-bottom: 1rem;">
                    <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="ImageUrl" data-position-key="Product_@(Model.Product.Id)_ImageUrl_Position" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" style="width: 100%; height: 100%; object-fit: cover; object-position: @(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_ImageUrl_Position") ? Model.PageContent[$"Product_{Model.Product.Id}_ImageUrl_Position"] : "50% 50%"); transition: transform 0.7s;">
                </div>
                @if (Model.Product.Name.Contains("Chuncho"))
                {
                    <!-- Image Gallery for Chuncho -->
                    <div class="grid grid-cols-3 gap-4 mt-4" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1rem;">
                        <div class="flex items-center justify-center relative overflow-hidden bg-white dark:bg-[#3C4A33] dark:bg-[#111]" style="display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: white;">
                            <img src="/Media/Cacao/Llama_Cacao_paper.webp" alt="Chuncho Cacao - Paper Wrapper" class="w-full h-full object-contain transition-transform duration-700 hover:scale-105" style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.7s;" loading="lazy">
                        </div>
                        <div class="flex items-center justify-center relative overflow-hidden bg-white dark:bg-[#3C4A33] dark:bg-[#111]" style="display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: white;">
                            <img src="/Media/Cacao/naked_cacao.webp" alt="Chuncho Cacao - Unwrapped" class="w-full h-full object-contain transition-transform duration-700 hover:scale-105" style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.7s;" loading="lazy">
                        </div>
                        <div class="flex items-center justify-center relative overflow-hidden bg-white dark:bg-[#3C4A33] dark:bg-[#111]" style="display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: white;">
                            <img src="/Media/Cacao/Chunco_naked_broken.webp" alt="Chuncho Cacao - Broken Open" class="w-full h-full object-contain transition-transform duration-700 hover:scale-105" style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.7s;" loading="lazy">
                        </div>
                    </div>
                }
            </div>
            
            <div class="flex flex-col w-full" style="display: flex; flex-direction: column;">
                <div class="mb-6 font-mono-jb">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-1" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Producer">
                        @(string.IsNullOrEmpty(Model.Product.Producer) ? "Guiliar Pérez Cuéllar" : Model.Product.Producer)
                    </p>
                    <p class="text-sm font-bold text-black dark:text-white uppercase tracking-widest mb-1" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Origin">
                        @(string.IsNullOrEmpty(Model.Product.Origin) ? "LA GRANJA" : Model.Product.Origin)
                    </p>
                    <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">
                        @(string.IsNullOrEmpty(Model.Product.Variety) ? "PINK BOURBON" : Model.Product.Variety) - @(string.IsNullOrEmpty(Model.Product.ProcessingMethod) ? "WASHED" : Model.Product.ProcessingMethod)
                    </p>
                    <p class="text-xs text-gray-500 uppercase tracking-widest" data-entity-id="Product_@(Model.Product.Id)_Country" data-entity-type="SiteContent" data-editable="Value">
                        @(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_Country") ? Model.PageContent[$"Product_{Model.Product.Id}_Country"] : "Colombia")
                    </p>
                </div>
                
                <span class="font-mono text-xs text-swiss-red font-bold mb-2 uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #FF3B30; font-weight: 700; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.1em;">@Model.Product.Type</span>
                <div class="flex items-center gap-4 mb-4 flex-wrap">
                    <h1 class="font-grotesk text-4xl md:text-6xl font-bold leading-tight m-0" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Name" style="font-family: 'Space Grotesk', sans-serif; font-size: 3rem; font-weight: 700; line-height: 1.1;">@Model.Product.Name</h1>
                    <span class="bg-black text-white px-3 py-1 text-sm font-bold font-mono tracking-widest rounded-sm whitespace-nowrap" style="font-family: 'JetBrains Mono', monospace;">SCA @Model.Product.ScaScore.ToString("0.##")</span>
                </div>
                <p class="font-grotesk text-2xl font-bold mb-8 price-display" id="main-product-price" data-base-usd="@Model.Product.BasePriceUSD" data-base-pen="@Model.Product.BasePricePEN" data-price-usd="@Model.Product.BasePriceUSD" data-price-pen="@Model.Product.BasePricePEN" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">$@Model.Product.BasePriceUSD.ToString("F2")</p>
                <p class="font-sans text-gray-600 dark:text-gray-300 mb-8 leading-relaxed text-lg" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="FlavorProfile" style="font-family: 'Inter', sans-serif; color: #4b5563; margin-bottom: 2rem; line-height: 1.75; font-size: 1.125rem;">@Model.Product.Description</p>
                
                <div class="border-t border-gray-200 dark:border-dark-border pt-8" style="border-top: 1px solid #e5e7eb; padding-top: 2rem;">
                    <form method="post" asp-page-handler="AddToCart">
                        <input type="hidden" name="productId" value="@Model.Product.Id" />
                        <input type="hidden" name="productName" value="@Model.Product.Name" />
                        <input type="hidden" name="productType" value="@Model.Product.Type" />
                        <input type="hidden" name="price" value="@Model.Product.BasePriceUSD" id="product-base-price" />
                        <input type="hidden" name="weight" value="100g" id="product-selected-weight" />
                        <input type="hidden" name="imageUrl" value="@Model.Product.ImageUrl" />
                        <input type="hidden" name="description" value="@Model.Product.Description" />

                        <!-- Weight Selection -->
                        <div class="mb-6 font-mono-jb">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3 block">Size / Weight</label>
                            <div class="flex gap-2">
                                <label class="cursor-pointer">
                                    <input type="radio" name="weight-select" value="100g" checked class="peer sr-only" onchange="updateProductWeight('100g', 1)" />
                                    <div class="px-4 py-2 border border-black bg-transparent text-black peer-checked:bg-black peer-checked:text-white dark:border-[#FAF3DD] dark:text-[#FAF3DD] dark:peer-checked:bg-[#FAF3DD] dark:peer-checked:text-black transition-all font-bold text-xs font-mono">100g</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="weight-select" value="200g" class="peer sr-only" onchange="updateProductWeight('200g', 2)" />
                                    <div class="px-4 py-2 border border-black bg-transparent text-black peer-checked:bg-black peer-checked:text-white dark:border-[#FAF3DD] dark:text-[#FAF3DD] dark:peer-checked:bg-[#FAF3DD] dark:peer-checked:text-black transition-all font-bold text-xs font-mono">200g</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="weight-select" value="500g" class="peer sr-only" onchange="updateProductWeight('500g', 4.5)" />
                                    <div class="px-4 py-2 border border-black bg-transparent text-black peer-checked:bg-black peer-checked:text-white dark:border-[#FAF3DD] dark:text-[#FAF3DD] dark:peer-checked:bg-[#FAF3DD] dark:peer-checked:text-black transition-all font-bold text-xs font-mono">500g</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="weight-select" value="1kg" class="peer sr-only" onchange="updateProductWeight('1kg', 8)" />
                                    <div class="px-4 py-2 border border-black bg-transparent text-black peer-checked:bg-black peer-checked:text-white dark:border-[#FAF3DD] dark:text-[#FAF3DD] dark:peer-checked:bg-[#FAF3DD] dark:peer-checked:text-black transition-all font-bold text-xs font-mono flex flex-col items-center">
                                        1kg <span class="text-[9px] text-[#FF6464] leading-none mt-1">-20%</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <script>
                            function updateProductWeight(weightLabel, multiplier) {
                                document.getElementById('product-selected-weight').value = weightLabel;
                                
                                const priceEl = document.getElementById('main-product-price');
                                const baseUsd = parseFloat(priceEl.getAttribute('data-base-usd'));
                                const basePen = parseFloat(priceEl.getAttribute('data-base-pen'));
                                
                                const newUsd = (baseUsd * multiplier).toFixed(2);
                                const newPen = (basePen * multiplier).toFixed(2);
                                
                                priceEl.setAttribute('data-price-usd', newUsd);
                                priceEl.setAttribute('data-price-pen', newPen);
                                
                                // update form price input (always store USD base to backend)
                                document.getElementById('product-base-price').value = newUsd;
                                
                                if (window.updateCurrencyPrices) {
                                    window.updateCurrencyPrices();
                                }
                            }
                        </script>

                        <!-- Purchase Type Selection: One-time vs Subscription -->
                        <div class="mb-6 font-mono-jb">
                            <label class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3 block">Purchase Type</label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <!-- One-Time Purchase Option -->
                                <label id="onetime-card" class="cursor-pointer border border-black p-4 flex flex-col justify-between transition-all bg-transparent">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="font-bold text-xs text-black dark:text-[#FAF3DD] uppercase tracking-wider font-mono">One-Time Purchase</span>
                                        <input type="radio" name="purchaseType" value="OneTime" checked onchange="handlePurchaseTypeChange('OneTime')" class="accent-[#FF6464]">
                                    </div>
                                    <span class="text-[10px] text-gray-500 font-normal font-mono">Standard price</span>
                                </label>

                                <!-- Subscribe & Save Option -->
                                <label id="sub-card" class="cursor-pointer border border-gray-300 dark:border-white/20 p-4 flex flex-col justify-between transition-all hover:border-black">
                                    <div class="flex items-center justify-between mb-1">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-bold text-xs text-black dark:text-[#FAF3DD] uppercase tracking-wider font-mono">Subscribe</span>
                                            <span class="bg-[#FF6464] text-white text-[9px] font-bold px-1.5 py-0.5 uppercase tracking-wider font-mono">10% OFF</span>
                                        </div>
                                        <input type="radio" name="purchaseType" value="Subscribe" onchange="handlePurchaseTypeChange('Subscribe')" class="accent-[#FF6464]">
                                    </div>
                                    <span class="text-[10px] text-gray-500 font-normal font-mono">Auto-delivered • Cancel anytime</span>
                                </label>
                            </div>

                            <!-- Subscription Frequency Selector -->
                            <div id="sub-frequency-container" class="mt-3 hidden p-3 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-300 dark:border-yellow-700/50">
                                <label class="text-[10px] font-bold uppercase tracking-widest text-yellow-900 dark:text-yellow-200 mb-1.5 block">Delivery Frequency</label>
                                <select name="subscriptionFrequency" class="w-full p-2.5 bg-white dark:bg-[#3C4A33] border border-yellow-400 dark:border-yellow-600 text-xs font-mono-jb text-black dark:text-[#FAF3DD] outline-none">
                                    <option value="Every 2 Weeks">Every 2 Weeks (10% Discount applied)</option>
                                    <option value="Every 4 Weeks" selected>Every 4 Weeks (10% Discount applied)</option>
                                    <option value="Every 6 Weeks">Every 6 Weeks (10% Discount applied)</option>
                                </select>
                            </div>
                        </div>

                        <script>
                            function handlePurchaseTypeChange(type) {
                                const onetimeCard = document.getElementById('onetime-card');
                                const subCard = document.getElementById('sub-card');
                                const subFreq = document.getElementById('sub-frequency-container');

                                if (type === 'Subscribe') {
                                    onetimeCard.classList.remove('border-black');
                                    onetimeCard.classList.add('border-gray-300', 'dark:border-white/20');
                                    
                                    subCard.classList.remove('border-gray-300', 'dark:border-white/20');
                                    subCard.classList.add('border-black', 'dark:border-white');
                                    
                                    subFreq.classList.remove('hidden');
                                } else {
                                    subCard.classList.remove('border-black', 'dark:border-white');
                                    subCard.classList.add('border-gray-300', 'dark:border-white/20');
                                    
                                    onetimeCard.classList.remove('border-gray-300', 'dark:border-white/20');
                                    onetimeCard.classList.add('border-black');
                                    
                                    subFreq.classList.add('hidden');
                                }
                            }
                        </script>

                        <div class="flex gap-4" style="display: flex; gap: 1rem;">
                            <input type="number" value="1" min="1" class="w-16 p-3 bg-transparent border border-black text-center font-mono focus:outline-none" name="quantity" style="width: 4rem; padding: 0.75rem; background: transparent; border: 1px solid #111111; text-align: center; font-family: 'JetBrains Mono', monospace; outline: none; -moz-appearance: textfield;">
                            <button type="submit" class="btn-lab flex-grow" style="padding: 0.75rem 0;">Add to Cart</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Moved Processing & Fact Sheet Section -->
        <div class="mb-24 flex flex-col md:flex-row gap-12 border-t border-gray-200 dark:border-dark-border pt-16" style="margin-bottom: 6rem; display: flex; gap: 3rem; border-top: 1px solid #e5e7eb; padding-top: 4rem;">
            <div class="w-full md:w-1/2">
                <h4 class="font-grotesk text-2xl font-bold mb-6" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">About the Processing</h4>
                <p class="font-sans text-gray-600 dark:text-gray-400 leading-relaxed" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="ProcessingDescription" style="font-family: 'Inter', sans-serif; color: #4b5563; line-height: 1.75;">
                    @{
                        var processDescFallback = Model.Product.Type == "Cacao"
                            ? $"This {Model.Product.Name} is carefully fermented and dried using traditional methods passed down through generations. The fermentation process develops the complex flavors characteristic of Cusco cacao, while careful drying preserves the quality and prevents mold."
                            : Model.Product.Name.Contains("Roast") || Model.Product.Name.Contains("Roasted")
                            ? $"This {Model.Product.Name} is roasted in small batches in Cusco using traditional methods. Our roasting process is carefully calibrated to bring out the unique characteristics of the Cusco terroir, whether light, medium, or dark roast."
                            : Model.Product.Name.Contains("SL09")
                            ? $"SL09 is fully washed and fermented for 24-36 hours, then carefully dried on raised beds. This processing method results in a clean, bright cup that highlights the chocolate and caramel notes characteristic of La Convención coffees. The beans are then sorted and prepared for export or local roasting."
                            : Model.Product.ProcessingMethod == "Washed"
                            ? $"This {Model.Product.Name} is fully washed and fermented for 24 hours. The result is a clean cup that highlights the terroir of the Cusco region."
                            : Model.Product.ProcessingMethod == "Natural"
                            ? $"This {Model.Product.Name} is naturally processed, allowing the coffee cherries to dry with the fruit intact. This method enhances sweetness and body, creating a unique flavor profile from Cusco's high-altitude farms."
                            : $"This {Model.Product.Name} is processed using traditional methods from the Cusco region, carefully selected to bring out the unique characteristics of Peruvian coffee.";
                    }
                    @(string.IsNullOrEmpty(Model.Product.ProcessingDescription) ? processDescFallback : Model.Product.ProcessingDescription)
                </p>
            </div>
            <div class="w-full md:w-1/2 mt-8 md:mt-0">
                <h4 class="font-mono-jb text-sm font-bold uppercase tracking-widest mb-6 border-b border-gray-200 dark:border-gray-700 pb-2">@(Model.Product.Type == "Cacao" ? "Cacao Specs" : "Bean Specs")</h4>
                <dl class="grid grid-cols-[100px_1fr] gap-y-3 font-mono-jb text-xs">
                    <dt class="text-gray-400 uppercase tracking-wider">Country</dt>
                    <dd class="text-black dark:text-white" data-entity-id="Product_@(Model.Product.Id)_Country" data-entity-type="SiteContent" data-editable="Value">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_Country") ? Model.PageContent[$"Product_{Model.Product.Id}_Country"] : "Colombia")</dd>
                    
                    <dt class="text-gray-400 uppercase tracking-wider">Region</dt>
                    <dd class="text-black dark:text-white" data-entity-id="Product_@(Model.Product.Id)_Region" data-entity-type="SiteContent" data-editable="Value">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_Region") ? Model.PageContent[$"Product_{Model.Product.Id}_Region"] : (Model.Product.Origin.Contains("Cusco") ? "Cusco" : Model.Product.Origin.Contains("La Convención") ? "La Convención, Cusco" : Model.Product.Origin.Split(',').Length > 0 ? Model.Product.Origin.Split(',')[0].Trim() : "Cusco"))</dd>
                    
                    @if (Model.Product.Type != "Cacao")
                    {
                        <dt class="text-gray-400 uppercase tracking-wider">Variety</dt>
                        <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Variety">@(string.IsNullOrEmpty(Model.Product.Variety) ? (Model.Product.Name.Contains("SL09") ? "SL09" : Model.Product.Name.Contains("Typica") ? "Typica" : Model.Product.Name.Contains("Pacamara") ? "Pacamara" : "Mixed") : Model.Product.Variety)</dd>
                        
                        <dt class="text-gray-400 uppercase tracking-wider">Height</dt>
                        <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Altitude">@(string.IsNullOrEmpty(Model.Product.Altitude) ? (Model.Product.Name.Contains("SL09") ? "1000-1600 MASL" : Model.Product.Origin.Contains("Highlands") ? "1200-1800 MASL" : "1000-1800 MASL") : Model.Product.Altitude)</dd>
                    }
                    else
                    {
                        <dt class="text-gray-400 uppercase tracking-wider">Variety</dt>
                        <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Variety">@(string.IsNullOrEmpty(Model.Product.Variety) ? "Criollo / Trinitario" : Model.Product.Variety)</dd>
                        
                        <dt class="text-gray-400 uppercase tracking-wider">Height</dt>
                        <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="Altitude">@(string.IsNullOrEmpty(Model.Product.Altitude) ? "600-1200 MASL" : Model.Product.Altitude)</dd>
                    }
                    
                    <dt class="text-gray-400 uppercase tracking-wider">Process</dt>
                    <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="ProcessingMethod">@(string.IsNullOrEmpty(Model.Product.ProcessingMethod) ? (Model.Product.Type == "Cacao" ? "Fermented & Dried" : "Washed") : Model.Product.ProcessingMethod)</dd>
                    
                    <dt class="text-gray-400 uppercase tracking-wider">Profile</dt>
                    <dd class="text-black dark:text-white" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="FlavorProfile">@(string.IsNullOrEmpty(Model.Product.FlavorProfile) ? (Model.Product.Type == "Cacao" ? "Rich & Fruity" : "Complex") : Model.Product.FlavorProfile)</dd>
                </dl>
            </div>
        </div>

        @if (Model.Product.Type == "Bean" || Model.Product.Type == "Cacao" || Model.Product.Name.Contains("Roast") || Model.Product.Name.Contains("SL09"))
        {
            <!-- 2. Producer Info -->
            <div class="border-t border-gray-200 dark:border-dark-border py-16" style="border-top: 1px solid #e5e7eb; padding: 4rem 0;">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; align-items: center;">
                    <div class="h-[400px] w-full bg-gray-100 dark:bg-[#2F3A28] dark:bg-[#111] overflow-hidden relative" style="height: 400px; width: 100%; background: #f3f4f6; overflow: hidden; position: relative;">
                        @{
                            var producerImageFallback = string.IsNullOrEmpty(Model.Product.ProducerImageUrl) 
                                ? "https://images.unsplash.com/photo-1596627689932-349099c26d7c?q=80&w=1600&auto=format&fit=crop" 
                                : Model.Product.ProducerImageUrl;
                        }
                        <img src="@producerImageFallback" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" alt="Producer" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="ProducerImageUrl" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); transition: all 0.7s;" loading="lazy">
                    </div>
                    <div class="bg-[#1a3c2f] text-white p-12 h-full flex flex-col justify-center" style="background: #1a3c2f; color: white; padding: 3rem; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                        <h3 class="font-grotesk text-3xl font-bold mb-6" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.875rem; font-weight: 700; margin-bottom: 1.5rem;">About the Producers</h3>
                        <p class="font-sans text-white/80 leading-relaxed mb-6" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="ProducerDescription" style="font-family: 'Inter', sans-serif; color: rgba(255,255,255,0.8); line-height: 1.75; margin-bottom: 1.5rem;">
                            @{
                                var producerDescFallback = Model.Product.Type == "Cacao" || Model.Product.Name.Contains("Cacao")
                                    ? "Sourced from smallholder cacao farmers in the Cusco region, who practice traditional organic cultivation methods. These farmers work in cooperatives to ensure quality and fair trade practices, preserving the rich heritage of Peruvian cacao production."
                                    : Model.Product.Name.Contains("SL09")
                                    ? "SL09 is our flagship coffee, grown by the Huadquiña cooperative in La Convención, Cusco. This cooperative consists of 300+ smallholder farmers dedicated to organic practices and preserving traditional Peruvian coffee varieties. Currently in stock and available for both local sale and international export."
                                    : Model.Product.Origin.Contains("Cusco") || Model.Product.Origin.Contains("Peru") || Model.Product.Origin.Contains("La Convención")
                                    ? "Grown by smallholder farmers in the Cusco region, particularly the Huadquiña cooperative and other local cooperatives. These farmers are dedicated to organic practices, sustainable farming, and preserving traditional Peruvian coffee varieties. Each batch represents the hard work of families who have cultivated coffee in these high-altitude regions for generations."
                                    : "Grown by smallholder farmers in the Cusco region, dedicated to organic practices and preserving traditional Peruvian coffee varieties.";
                            }
                            @(string.IsNullOrEmpty(Model.Product.ProducerDescription) ? producerDescFallback : Model.Product.ProducerDescription)
                        </p>
                    </div>
                </div>
            </div>



            <!-- 4. Flavor Wheel -->
            <div class="border-t border-gray-200 dark:border-dark-border py-16" style="border-top: 1px solid #e5e7eb; padding: 4rem 0;">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; align-items: start;">
                    <div class="lab-card">
                        <span class="lab-title" style="border-bottom:none; margin-bottom: 4px; color: #FF6464; display: block; font-size: 8px;">02 // LABORATORY ANALYSIS</span>
                        <h4 class="font-grotesk text-4xl font-bold mb-6" style="font-family: 'Space Grotesk', sans-serif; font-size: 2.25rem; font-weight: 700; margin-bottom: 1.5rem; letter-spacing: -0.02em;">Flavor<br><span class="text-gray-500 font-normal">Explorer.</span></h4>
                        <span class="lab-title">@(Model.Product.Type == "Cacao" ? "Sensory Profile" : "Bright & Fruity")</span>
                        <h5 class="text-xl font-bold mb-4 font-grotesk">@(Model.Product.FlavorProfile)</h5>
                        @{
                            string flavorWheelFallback;
                            if (Model.Product.Type == "Cacao")
                            {
                                flavorWheelFallback = "This cacao exhibits a complex sensory profile. You can expect a sweet, fruit-forward acidity balanced by deep, earthy undertones, characteristic of high-altitude Chuncho varietals. The prominent chocolate notes are incredibly rich and lingering.";
                            }
                            else
                            {
                                var profile = Model.Product.FlavorProfile?.ToLower() ?? "";
                                var descriptors = profile.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                                
                                if (descriptors.Count > 0)
                                {
                                    var firstNote = descriptors[0];
                                    var otherNotes = descriptors.Count > 1 ? string.Join(" and ", descriptors.Skip(1)) : "complex terroir characteristics";
                                    
                                    flavorWheelFallback = $"This {Model.Product.Name} boasts a sophisticated sensory profile driven by organic acids and enzymatic reactions during processing. The initial tasting notes reveal pronounced {firstNote}, supported by a vibrant backbone of {otherNotes}. ";
                                    
                                    if (profile.Contains("sweet") || profile.Contains("fruit") || profile.Contains("peach") || profile.Contains("berry"))
                                        flavorWheelFallback += "The sweetness is distinctly fruit-forward, reminiscent of ripe stone fruit and berries, balancing the sparkling malic acidity. ";
                                    if (profile.Contains("floral") || profile.Contains("jasmine") || profile.Contains("bergamot"))
                                        flavorWheelFallback += "Delicate floral aromatics carry through the entire cup, contributing to an elegant, tea-like body and a remarkably clean finish. ";
                                    if (profile.Contains("chocolate") || profile.Contains("caramel") || profile.Contains("nut"))
                                        flavorWheelFallback += "A rich foundation of Maillard-reaction sweetness provides deep chocolate and caramelized sugar undertones, creating a syrupy, lingering mouthfeel. ";
                                    if (profile.Contains("savory") || profile.Contains("complex"))
                                        flavorWheelFallback += "The structured acidity cuts beautifully through the savory undertones, resulting in a multi-layered, dynamic cup profile.";
                                }
                                else
                                {
                                    flavorWheelFallback = $"The sensory profile of this {Model.Product.Name} is deeply tied to its terroir. You can expect a sweet, well-rounded cup that highlights the pristine growing conditions of Cusco, with distinct notes of chocolate and caramel.";
                                }
                            }
                        }
                        <p class="font-sans text-gray-600 dark:text-gray-400 leading-relaxed mb-6" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelText" data-entity-type="SiteContent" data-editable="Value" style="font-family: 'Inter', sans-serif; color: #4b5563; line-height: 1.75; margin-bottom: 1.5rem;">
                            @Html.Raw(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelText") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelText"] : flavorWheelFallback)
                        </p>
                    </div>
                    <div class="flex justify-center" style="display: flex; justify-content: center;">
                        <div class="flavor-wheel" style="width: 300px; height: 300px; max-width: 100%; border-radius: 50%; background: conic-gradient(#194d33 0% 25%, #f0f0f0 25% 50%, #111111 50% 75%, #e5e5e5 75% 100%); position: relative; margin: 0 auto; border: 1px solid #e5e7eb; box-shadow: none !important;">
                            @if (Model.Product.Type == "Cacao")
                            {
                                <!-- Fruity - Top Right -->
                                <div class="flavor-label" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel1" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 25%; left: 75%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #fff; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel1") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel1"] : "Fruity")</div>
                                <!-- Nutty - Bottom Right -->
                                <div class="flavor-label dark-text" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel2" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 75%; left: 75%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #111; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel2") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel2"] : "Nutty")</div>
                                <!-- Chocolate - Bottom Left -->
                                <div class="flavor-label" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel3" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 75%; left: 25%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #fff; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel3") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel3"] : "Chocolate")</div>
                                <!-- Earthy - Top Left -->
                                <div class="flavor-label dark-text" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel4" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 25%; left: 25%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #111; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel4") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel4"] : "Earthy")</div>
                            }
                            else
                            {
                                <!-- Fresh Fruit - Top Right -->
                                <div class="flavor-label" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel1" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 25%; left: 75%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #fff; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel1") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel1"] : "Fresh Fruit")</div>
                                <!-- Floral - Bottom Right -->
                                <div class="flavor-label dark-text" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel2" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 75%; left: 75%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #111; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel2") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel2"] : "Floral")</div>
                                <!-- Chocolate - Bottom Left -->
                                <div class="flavor-label" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel3" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 75%; left: 25%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #fff; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel3") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel3"] : "Chocolate")</div>
                                <!-- Sweet - Top Left -->
                                <div class="flavor-label dark-text" data-entity-id="Product_@(Model.Product.Id)_FlavorWheelLabel4" data-entity-type="SiteContent" data-editable="Value" style="position: absolute; top: 25%; left: 25%; transform: translate(-50%, -50%); font-family: 'Inter', monospace; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #111; text-align: center; white-space: nowrap; z-index: 5; pointer-events: none;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorWheelLabel4") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorWheelLabel4"] : "Sweet")</div>
                            }
                            <div class="flavor-inner" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; max-width: 40%; max-height: 40%; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-align: center; font-family: 'Space Grotesk', sans-serif; font-weight: bold; font-size: 0.8rem; z-index: 10; border: 1px solid #e5e7eb; box-shadow: none !important;">
                                <div>
                                    <div class="text-[10px] text-gray-400 uppercase tracking-widest" data-entity-id="Product_@(Model.Product.Id)_FlavorIntensityLabel" data-entity-type="SiteContent" data-editable="Value" style="font-size: 10px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.1em;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorIntensityLabel") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorIntensityLabel"] : (Model.Product.Type == "Cacao" ? "Intensity" : "Body"))</div>
                                    <div class="text-xl" data-entity-id="Product_@(Model.Product.Id)_FlavorIntensityValue" data-entity-type="SiteContent" data-editable="Value" style="font-size: 1.25rem;">@(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_FlavorIntensityValue") ? Model.PageContent[$"Product_{Model.Product.Id}_FlavorIntensityValue"] : (Model.Product.Type == "Cacao" ? "Rich" : "Medium"))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Map & Origin -->
            <div class="border-t border-gray-200 dark:border-dark-border py-16" style="border-top: 1px solid #e5e7eb; padding: 4rem 0;">
                <div class="flex flex-col md:flex-row gap-12 items-center w-full">
                    <a href="/OriginMap" class="map-container w-full md:w-1/2 aspect-[4/3] md:aspect-square overflow-hidden group relative flex items-center justify-center transition-all duration-300" style="display: flex; align-items: center; justify-content: center; text-decoration: none; cursor: pointer;">
                        @{
                            var mapImageFallback = string.IsNullOrEmpty(Model.Product.MapImageUrl)
                                ? "/Media/LaConvencionMap.svg"
                                : Model.Product.MapImageUrl;
                        }
                        <img src="@mapImageFallback" alt="Map" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="MapImageUrl" data-position-key="Product_@(Model.Product.Id)_MapImageUrl_Position" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" style="width: 100%; height: 100%; object-fit: cover; object-position: @(Model.PageContent != null && Model.PageContent.ContainsKey($"Product_{Model.Product.Id}_MapImageUrl_Position") ? Model.PageContent[$"Product_{Model.Product.Id}_MapImageUrl_Position"] : "50% 50%");" loading="lazy">
                        <div class="absolute bottom-2 right-2 bg-black text-white px-3 py-1 font-mono text-xs opacity-0 group-hover:opacity-100 transition-opacity rounded-sm shadow pointer-events-none hidden md:block">Click for Interactive Map</div>
                    </a>
                    <div class="w-full md:w-1/2 pl-0 md:pl-12">
                        <h4 class="font-grotesk text-2xl font-bold mb-4" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">
                            About @(Model.Product.Name.Contains("SL09") ? "La Convención, Cusco" : Model.Product.Origin.Contains("Cusco") ? "Cusco Region" : Model.Product.Origin.Contains("La Convención") ? "La Convención, Cusco" : "Cusco, Peru")
                        </h4>
                        <p class="font-sans text-gray-600 dark:text-gray-400 mb-8" data-entity-id="@Model.Product.Id" data-entity-type="CoffeeBean" data-editable="OriginDescription" style="font-family: 'Inter', sans-serif; color: #4b5563; margin-bottom: 2rem;">
                            @{
                                string originDescFallback = "";
                                if (Model.Product.Type == "Cacao")
                                {
                                    originDescFallback = "Explore the Cusco region where this cacao is grown. The unique microclimates and traditional farming methods create exceptional quality cacao with rich, complex flavors.";
                                }
                                else if (Model.Product.Name.Contains("SL09"))
                                {
                                    originDescFallback = "SL09 comes from La Convención province in Cusco, Peru's premier coffee-producing region. This area stretches from the high Andes to the edge of the Amazon rainforest, producing some of the world's finest organic coffee at altitudes between 1000-1600 meters.";
                                }
                                else
                                {
                                    originDescFallback = "Explore the Cusco region where this coffee is grown. The high-altitude farms, diverse microclimates, and traditional farming methods create exceptional quality coffee with unique flavor profiles.";
                                }
                            }
                            @(string.IsNullOrEmpty(Model.Product.OriginDescription) ? originDescFallback : Model.Product.OriginDescription)
                        </p>
                        <a href="/Experiences" class="px-6 py-3 border border-black dark:border-white font-mono text-xs uppercase hover:bg-black hover:text-white dark:hover:bg-white dark:bg-[#3C4A33] dark:hover:text-black dark:text-[#FAF3DD] transition-colors inline-block" style="padding: 0.75rem 1.5rem; border: 1px solid #111; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; text-transform: uppercase; transition: all 0.3s; text-decoration: none; color: #111;">Explore Cusco Regions</a>
                    </div>
                </div>
            </div>
        }
    </article>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <section aria-label="Related Products" class="container-fluid px-6 py-12 border-t border-gray-200 dark:border-dark-border" style="max-width: 1400px; margin: 0 auto; padding: 3rem 1.5rem; border-top: 1px solid #e5e7eb;">
            <h3 class="font-grotesk text-3xl font-bold mb-8 text-center" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.875rem; font-weight: 700; margin-bottom: 2rem; text-align: center;">Related Products</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
                @foreach (var product in Model.RelatedProducts.Take(6))
                {
                    <div class="border border-gray-200 dark:border-dark-border hover:bg-off-white dark:hover:bg-white/5 transition-colors group cursor-pointer" style="border: 1px solid #e5e7eb; transition: background-color 0.3s; cursor: pointer;">
                        <a href="@Url.Page("/Product", new { id = product.Id })" class="text-decoration-none" style="text-decoration: none; color: inherit;">
                            <div class="h-48 bg-gray-100 dark:bg-[#2F3A28] dark:bg-[#111] overflow-hidden" style="height: 12rem; background: #f3f4f6; overflow: hidden;">
                                <img src="@product.ImageUrl" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;" loading="lazy">
                            </div>
                            <div class="p-6" style="padding: 1.5rem;">
                                <h5 class="font-grotesk font-bold text-lg mb-2 group-hover:text-swiss-red transition-colors" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.125rem; margin-bottom: 0.5rem; transition: color 0.3s;">@product.Name</h5>
                                <p class="font-mono text-xs text-gray-500 mb-4" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #6b7280; margin-bottom: 1rem;">@product.Origin</p>
                                <div class="flex justify-between items-center border-t border-gray-200 dark:border-dark-border pt-4" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e5e7eb; padding-top: 1rem;">
                                    <span class="font-bold text-lg" style="font-weight: 700; font-size: 1.125rem;">S/ @((product.Price * 3.8m).ToString("F2"))</span>
                                    <span class="text-xs font-bold uppercase tracking-widest flex items-center gap-2 group-hover:text-swiss-red transition-colors" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; display: flex; align-items: center; gap: 0.5rem; transition: color 0.3s;">View <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>
    }


}
else
{
    <div class="container-fluid px-6 py-12 text-center" style="max-width: 1400px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
        <h2 class="font-grotesk text-3xl font-bold mb-4" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.875rem; font-weight: 700; margin-bottom: 1rem;">Product Not Found</h2>
        <p class="font-sans text-gray-600 dark:text-gray-400 mb-8" style="font-family: 'Inter', sans-serif; color: #4b5563; margin-bottom: 2rem;">The product you're looking for doesn't exist or has been removed.</p>
        <a href="/GreenBeans" class="px-6 py-3 bg-charcoal dark:bg-white text-white dark:text-black font-mono text-xs uppercase hover:bg-swiss-red dark:hover:bg-gray-200 transition-colors inline-block" style="padding: 0.75rem 1.5rem; background: #111111; color: white; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; text-transform: uppercase; transition: background-color 0.3s; text-decoration: none;">Back to Green Beans</a>
    </div>
}

<style>
    /* Dark mode support for flavor wheel */
    .dark .flavor-wheel {
        background: conic-gradient(#194d33 0% 25%, #333333 25% 50%, #000000 50% 75%, #444444 75% 100%) !important;
    }
    
    .dark .flavor-inner {
        background: #0a0a0a !important;
        color: white !important;
    }
    
    .dark .flavor-label.dark-text {
        color: #ccc !important;
    }
    
    /* Number input spinner arrows */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        opacity: 1 !important;
        height: 1.5rem !important;
        width: 1.25rem !important;
        cursor: pointer !important;
    }
    
    input[type="number"] {
        -moz-appearance: textfield;
    }
    
    input[type="number"]::-webkit-inner-spin-button {
        opacity: 1;
        cursor: pointer;
    }
    
    input[type="number"]::-webkit-outer-spin-button {
        opacity: 1;
        cursor: pointer;
    }
    
    .dark input[type="number"] {
        color: white;
    }
    
    .dark input[type="number"]::-webkit-inner-spin-button,
    .dark input[type="number"]::-webkit-outer-spin-button {
        filter: invert(1);
    }
    
    /* Responsive */
    @@media (max-width: 768px) {
        .grid.grid-cols-1.lg\:grid-cols-2 {
            grid-template-columns: 1fr !important;
        }
        
        .grid.grid-cols-1.md\:grid-cols-2 {
            grid-template-columns: 1fr !important;
        }
        
        .grid.grid-cols-1.md\:grid-cols-2.lg\:grid-cols-3 {
            grid-template-columns: 1fr !important;
        }
        
        /* Flavor wheel responsive */
        .flavor-wheel {
            width: 250px !important;
            height: 250px !important;
            max-width: 90vw !important;
        }
        
        .flavor-label {
            font-size: 0.6rem !important;
        }
        
        .flavor-inner {
            width: 100px !important;
            height: 100px !important;
        }
        
        .flavor-inner .text-xl {
            font-size: 1rem !important;
        }
        
        .flavor-inner .text-[10px] {
            font-size: 8px !important;
        }
    }
    
    @@media (max-width: 480px) {
        .flavor-wheel {
            width: 200px !important;
            height: 200px !important;
        }
        
        .flavor-label {
            font-size: 0.5rem !important;
        }
        
        .flavor-inner {
            width: 80px !important;
            height: 80px !important;
        }
        
        .flavor-inner .text-xl {
            font-size: 0.875rem !important;
        }
        
        .flavor-inner .text-[10px] {
            font-size: 7px !important;
        }
    }
</style>

@if (Model.Product != null)
{
    <script type="application/ld+json">
    @Html.Raw($@"{{
      ""@context"": ""https://schema.org/"",
      ""@type"": ""Product"",
      ""name"": ""{Model.Product.Name}"",
      ""image"": [
        ""{Model.Product.ImageUrl}""
       ],
      ""description"": ""{Model.Product.Description}"",
      ""sku"": ""{Model.Product.Id}"",
      ""offers"": {{
        ""@type"": ""Offer"",
        ""url"": ""https://purplebean.coffee/Product/{Model.Product.Id}"",
        ""priceCurrency"": ""USD"",
        ""price"": ""{Model.Product.BasePriceUSD}"",
        ""availability"": ""https://schema.org/InStock""
      }}
    }}")
    </script>
    <script type="application/ld+json">
    @Html.Raw($@"{{
      ""@context"": ""https://schema.org"",
      ""@type"": ""BreadcrumbList"",
      ""itemListElement"": [{{
        ""@type"": ""ListItem"",
        ""position"": 1,
        ""name"": ""Home"",
        ""item"": ""https://purplebean.coffee/""
      }},{{
        ""@type"": ""ListItem"",
        ""position"": 2,
        ""name"": ""Shop"",
        ""item"": ""https://purplebean.coffee/GreenBeans""
      }},{{
        ""@type"": ""ListItem"",
        ""position"": 3,
        ""name"": ""{Model.Product.Name}""
      }}]
    }}")
    </script>
}
