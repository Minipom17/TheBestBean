@page
@model TheBestBean.Pages.ResourcesModel
@{
    ViewData["Title"] = "Resources";
    ViewData["MetaDescription"] = "Purple Bean Coffee resources — workshop slide decks, brew guides, and coffee education from the Cusco lab.";
    Layout = "_Layout";
}

<div class="max-w-[1100px] mx-auto px-6 md:px-12 py-16 md:py-24">
    <p class="font-mono-jb uppercase tracking-widest text-[10px] font-bold mb-4">Lab notes</p>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tighter uppercase mb-6">Resources</h1>
    <p class="font-grotesk max-w-2xl text-base leading-relaxed mb-14">
        Slide decks and references we use in the Cusco lab. Start with the crash course, then keep going in the brew guides.
    </p>

    <article class="border border-v-light-gray dark:border-[rgba(214,208,200,0.12)] p-8 md:p-10 mb-10">
        <p class="font-mono-jb uppercase tracking-widest text-[10px] font-bold mb-3">Workshop deck · ~18 slides</p>
        <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight mb-4">The Coffee Project — Crash Course</h2>
        <p class="font-grotesk max-w-xl leading-relaxed mb-8">
            Origins, Peru growing zones, altitude, fermentation, SL09, the flavor wheel, grind, water, espresso vs pour-over, V60, roast, defects, and aroma.
        </p>
        <a href="/presentations/coffee-presentation.html" class="inline-block font-mono-jb uppercase tracking-widest text-[11px] font-bold px-5 py-3 bg-v-black text-v-white dark:bg-cream dark:text-night text-decoration-none">
            Open slide deck
        </a>
    </article>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a asp-page="/BrewMethods" class="block border border-v-light-gray dark:border-[rgba(214,208,200,0.12)] p-6 text-decoration-none text-inherit hover:border-v-black dark:hover:border-cream transition-colors">
            <p class="font-mono-jb uppercase tracking-widest text-[10px] font-bold mb-2">Guides</p>
            <h3 class="text-lg font-bold uppercase mb-2">Brew methods</h3>
            <p class="text-sm leading-relaxed">Ratios, grind, and step-by-step for the brewers we use in the lab.</p>
        </a>
        <a asp-page="/Learn" class="block border border-v-light-gray dark:border-[rgba(214,208,200,0.12)] p-6 text-decoration-none text-inherit hover:border-v-black dark:hover:border-cream transition-colors">
            <p class="font-mono-jb uppercase tracking-widest text-[10px] font-bold mb-2">Tasting</p>
            <h3 class="text-lg font-bold uppercase mb-2">Flavor map</h3>
            <p class="text-sm leading-relaxed">A walk through coffee flavors and how we talk about them in cupping.</p>
        </a>
    </div>
</div>
