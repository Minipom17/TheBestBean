        <img src="~/brand/logo-mark.png" alt="" class="brand-mark brand-mark--light" width="40" height="40" />
        <img src="~/brand/logo-mark-dark.png" alt="" class="brand-mark brand-mark--dark" width="40" height="40" />
    </span>
    <span class="brand-wordmark" aria-hidden="true">
