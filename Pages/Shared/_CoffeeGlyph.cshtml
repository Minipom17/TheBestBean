@model string
@{
    var glyph = (Model ?? "").Trim().ToLowerInvariant();
}
<svg class="coffee-glyph coffee-glyph--@glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
@if (glyph == "farmer")
{
    <path d="M2 7.15h12" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    <path d="M5.1 7.15V5.35c0-1.35 1.25-2.45 2.9-2.45s2.9 1.1 2.9 2.45v1.8" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    <circle cx="8" cy="9.05" r="1.55" fill="currentColor"/>
    <path d="M3.2 14.7c.55-2.35 2.15-3.45 4.8-3.45s4.25 1.1 4.8 3.45" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
}
else if (glyph == "bean")
{
    <path d="M5.05 3.55c-2.15 2.2-2.2 6.85.05 9.05 1.15 1.1 2.7 1.5 4.15 1.1 1.85-.5 3.2-2.1 3.55-3.95.5-2.35-.35-4.85-2.15-6.5C8.9 2.45 6.35 2.25 5.05 3.55z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
    <path d="M7.85 3.95c-.15 2.7.35 5.35.1 8.35" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
}
else if (glyph == "location")
{
    <path d="M8 2.45c-2.35 0-4.25 1.85-4.25 4.2 0 3.15 4.25 7.7 4.25 7.7s4.25-4.55 4.25-7.7c0-2.35-1.9-4.2-4.25-4.2z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
    <circle cx="8" cy="6.55" r="1.4" fill="currentColor"/>
}
else if (glyph == "process")
{
    <path d="M8 2.35s-4.15 5.05-4.15 7.55A4.15 4.15 0 0 0 8 14.05a4.15 4.15 0 0 0 4.15-4.15C12.15 7.4 8 2.35 8 2.35z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
    <path d="M6.45 9.15c.35-1.05 1.2-1.7 2.15-1.9" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
}
else if (glyph == "warehouse")
{
    <path d="M2.35 7.15 L8 2.5 L13.65 7.15" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M3.2 7.15 V13.5 H12.8 V7.15" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6.15 13.5 V9.85 H9.85 V13.5" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
}
</svg>
