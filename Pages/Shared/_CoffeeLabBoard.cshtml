@model TheBestBean.Services.CoffeeLabBoard
@using System.Text.Json
@{
    var board = Model ?? new CoffeeLabBoard();
    var compact = board.Compact;
    var roastJsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<section class="lab-board@(compact ? " lab-board--compact" : "")" aria-label="Coffee freshness">
    <header class="lab-board__head">
        <div class="lab-board__kicker-row">
            <p class="lab-board__kicker">@board.Kicker <span class="offerings-cursor" aria-hidden="true"></span></p>
            @if (compact)
            {
                <div class="lab-stock-legend" aria-label="Stock colors">
                    <span class="lab-stock-legend__swatch lab-stock-legend__swatch--green">green bean</span>
                    <span class="lab-stock-legend__swatch lab-stock-legend__swatch--roast">roasted coffee</span>
                </div>
            }
        </div>
        <h2>@board.Title</h2>
        @if (board.ShowLede)
        {
            <p class="lab-board__lede">
                We buy green from farmers and labs, profile the roast, then roast after you order and ship the next day so rest happens in transit. Most lots are for pour-over; the same coffee works as espresso if you want those flavors in the shot.
            </p>
        }
    </header>

    @if (board.Lots.Count > 0)
    {
        var colors = new[] { "#FF6464", "#50A8EB", "#D193FF", "#92DBFF", "#FF9F43" };
        int colorIndex = 0;
        <div class="lab-board__feed" role="list">
            @foreach (var lot in board.Lots)
            {
                var color = colors[colorIndex % colors.Length];
                colorIndex++;
                var title = CoffeeDisplayName.ForLab(lot.Name);
                var greenKg = CoffeeLotStatus.FormatKg(lot.GreenKg);
                var roastKg = CoffeeLotStatus.FormatKg(lot.RoastedKg);
                var roastsJson = JsonSerializer.Serialize(lot.Roasts.Select(r => new
                {
                    date = r.RoastDate.ToString("dd MMM yyyy"),
                    daysAgo = r.DaysAgo,
                    profile = r.Profile,
                    grams = r.WeightGrams,
                    phaseLabel = r.PhaseLabel,
                    phaseHint = r.PhaseHint
                }), roastJsonOpts);

                if (compact)
                {
                    <div class="lab-board__row group" role="listitem">
                        <span class="lab-board__stock" aria-label="@greenKg green, @roastKg roasted">
                            <button type="button"
                                    class="lab-board__kg lab-board__kg--green lab-board__kg-btn"
                                    data-lab-popup="green"
                                    data-name="@title"
                                    data-kg="@greenKg"
                                    data-producer="@(lot.Producer ?? "")"
                                    data-process="@(lot.ProcessingMethod ?? "")"
                                    data-altitude="@(lot.Altitude ?? "")"
                                    data-flavor="@(lot.FlavorProfile ?? "")"
                                    data-has-roast="@(lot.HasRoast ? "1" : "0")"
                                    aria-label="@greenKg green bean details for @title">
                                @greenKg
                            </button>
                            <button type="button"
                                    class="lab-board__kg lab-board__kg--roast lab-board__kg-btn"
                                    data-lab-popup="roast"
                                    data-name="@title"
                                    data-kg="@roastKg"
                                    data-roasts="@roastsJson"
                                    aria-label="@roastKg roasted coffee details for @title">
                                @roastKg
                            </button>
                        </span>
                        <span class="lab-board__name-wrap">
                            <a asp-page="/Product" asp-route-id="@lot.CoffeeBeanId" class="lab-board__name-link" style="border-bottom-color: @color;">@title</a>
                        </span>
                    </div>
                }
                else
                {
                    <a asp-page="/Product" asp-route-id="@lot.CoffeeBeanId" class="lab-board__row group" role="listitem">
                        <span class="lab-board__meta">
                            @if (lot.HasGreen)
                            {
                                <text>[ @greenKg GREEN ]</text>
                            }
                            else
                            {
                                <text>[ ROAST TO ORDER ]</text>
                            }
                        </span>
                        <span class="lab-board__name-wrap">
                            <span class="lab-board__name-link" style="border-bottom-color: @color;">@title</span>
                        </span>
                    </a>
                }
            }
        </div>
    }

    @if (board.ShowTimeline)
    {
        <ol class="fresh-timeline" aria-label="Coffee freshness timeline">
            @foreach (var phase in new[] { FreshPhase.Degas, FreshPhase.Peak, FreshPhase.Fade, FreshPhase.Stale })
            {
                var on = board.Highlight == phase;
                <li class="fresh-timeline__phase@(on ? " is-now" : "")">
                    <span class="fresh-timeline__window">@CoffeeFreshnessService.PhaseWindow(phase)</span>
                    <strong>@CoffeeFreshnessService.PhaseLabel(phase)</strong>
                    <p>@CoffeeFreshnessService.PhaseHint(phase)</p>
                </li>
            }
        </ol>
    }

    @if (board.ShowGrind)
    {
        <div class="lab-board__grind">
            <p><strong>Whole bean.</strong> After you open the bag, flavor holds about a month. We don’t grind for shipping — ground coffee is at peak for 20–30 minutes, then aroma drops fast.</p>
            <p>Pour-over: brew 2–3 days after roast with a bloom. Press, Moka, AeroPress: 3–7 days. Espresso: 5–14 days so CO₂ doesn’t wreck the shot.</p>
        </div>
    }
</section>

@if (compact)
{
    <div id="lab-stock-modal" class="lab-stock-modal" hidden aria-hidden="true">
        <div class="lab-stock-modal__backdrop" data-lab-modal-close></div>
        <div class="lab-stock-modal__panel lab-board__lot" role="dialog" aria-modal="true" aria-labelledby="lab-stock-modal-title">
            <button type="button" class="lab-stock-modal__close" data-lab-modal-close aria-label="Close">×</button>
            <div class="lab-board__lot-top">
                <strong id="lab-stock-modal-title" class="lab-board__name"></strong>
                <span id="lab-stock-modal-pill" class="lab-board__pill"></span>
            </div>
            <p id="lab-stock-modal-lede" class="lab-stock-modal__lede"></p>
            <dl id="lab-stock-modal-facts" class="lab-stock-modal__facts"></dl>
            <ul id="lab-stock-modal-roasts" class="lab-board__roasts" hidden></ul>
            <p id="lab-stock-modal-empty" class="lab-board__empty-roast" hidden></p>
        </div>
    </div>
    <script src="~/js/lab-board.js" asp-append-version="true"></script>
}
