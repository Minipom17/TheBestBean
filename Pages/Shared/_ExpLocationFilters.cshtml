@model string
@{
    var id = Model ?? "";
    var urban = id.StartsWith("urban", StringComparison.OrdinalIgnoreCase);
}
<div class="exp-filter-row">
    <span class="exp-filter-label exp-filter-label--emoji" title="Location" aria-hidden="true">📍</span>
    <div class="exp-geo" id="@id" role="group" aria-label="Filter by location">
        <button type="button" class="exp-geo-all filter-btn active" data-filter="all">All</button>
        @if (urban)
        {
            <span class="exp-geo-sep" aria-hidden="true">·</span>
            <button type="button" class="exp-geo-place filter-btn" data-filter="region:cusco">Cusco</button>
            <span class="exp-geo-sep" aria-hidden="true">·</span>
            <button type="button" class="exp-geo-place filter-btn" data-filter="region:lima">Lima</button>
        }
        else
        {
            <span class="exp-geo-sep" aria-hidden="true">·</span>
            <button type="button" class="exp-geo-place filter-btn" data-filter="place:santa-teresa">Santa Teresa, Cusco</button>
            <span class="exp-geo-sep" aria-hidden="true">·</span>
            <button type="button" class="exp-geo-place filter-btn" data-filter="place:jaen">Jaén, Cajamarca</button>
        }
    </div>
</div>
