@using TheBestBean.Services
@using Microsoft.Extensions.Configuration
@inject CartService CartService
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="color-scheme" content="only light">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    @{
        var canonicalPath = $"{Context.Request.Path.Value}{Context.Request.QueryString.Value}";
        var canonicalUrl = ViewData["CanonicalUrl"] as string ?? $"https://purplebean.coffee{canonicalPath}";
    }
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon-48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <title>@ViewData["Title"] | Purple Bean Coffee</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Specialty coffee shop and roasting lab in Cusco, Peru. Sourcing and roasting the finest high-altitude coffees, and offering immersive coffee tours and workshops.")">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:title" content="@ViewData["Title"] | Purple Bean Coffee">
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Sourcing and roasting the finest coffees from the high altitudes of Cusco, Peru.")">
    <meta property="og:image" content="@(ViewData["MetaImage"] ?? "https://purplebean.coffee/images/og-logo.png")">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="@ViewData["Title"] | Purple Bean Coffee">
    <meta property="og:site_name" content="Purple Bean Coffee">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="@canonicalUrl">
    <meta property="twitter:title" content="@ViewData["Title"] | Purple Bean Coffee">
    <meta property="twitter:description" content="@(ViewData["MetaDescription"] ?? "Sourcing and roasting the finest coffees from the high altitudes of Cusco, Peru.")">
    <meta property="twitter:image" content="@(ViewData["MetaImage"] ?? "https://purplebean.coffee/images/og-logo.png")">

    @{
        var gaId = Configuration["GoogleAnalytics:MeasurementId"];
    }
    @if (!string.IsNullOrEmpty(gaId))
    {
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '@gaId');
          window.pbEmitGaEvents = function (events) {
            if (!events || typeof gtag !== 'function') return;
            events.forEach(function (e) {
              if (!e || !e.event) return;
              if (e.event === 'purchase' && e.params && e.params.transaction_id) {
                var key = 'pb_ga_purchase_' + e.params.transaction_id;
                try {
                  if (sessionStorage.getItem(key)) return;
                  sessionStorage.setItem(key, '1');
                } catch (err) {}
              }
              gtag('event', e.event, e.params || {});
            });
          };
        </script>
    }

    <!-- LocalBusiness Schema -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": ["CafeOrCoffeeShop", "TouristAttraction"],
      "name": "Purple Bean Coffee",
      "description": "Specialty coffee roastery based in Cusco, Peru. We source from high-altitude farms in La Convención and Cajamarca, roast in small batches, and offer immersive coffee experiences for travelers.",
      "image": [
        "https://purplebean.coffee/images/og-logo-square.png",
        "https://purplebean.coffee/images/brand-icon.png"
      ],
      "logo": {
        "@@type": "ImageObject",
        "url": "https://purplebean.coffee/images/og-logo-square.png",
        "width": 1200,
        "height": 1200
      },
      "telephone": "+51993779381",
      "url": "https://purplebean.coffee/",
      "sameAs": [
        "https://www.instagram.com/purple.beancoffee/"
      ],
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Near San Pedro Market",
        "addressLocality": "Cusco",
        "addressRegion": "Cusco",
        "postalCode": "08000",
        "addressCountry": "PE"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": -13.52,
        "longitude": -71.97
      },
      "areaServed": {
        "@@type": "City",
        "name": "Cusco",
        "containedInPlace": {
          "@@type": "Country",
          "name": "Peru"
        }
      },
      "priceRange": "$$",
      "servesCuisine": "Specialty Coffee",
      "knowsLanguage": ["en", "es"],
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "Purple Bean Coffee Products & Experiences",
        "itemListElement": [
          {
            "@@type": "OfferCatalog",
            "name": "Specialty Coffee",
            "description": "Single-origin roasted specialty coffee from Cusco and Cajamarca"
          },
          {
            "@@type": "OfferCatalog",
            "name": "Coffee Experiences",
            "description": "Hands-on coffee workshops, tastings, and farm visits in Cusco"
          },
          {
            "@@type": "OfferCatalog",
            "name": "Wholesale Green Beans",
            "description": "Direct-trade green coffee beans for roasters"
          }
        ]
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Purple Bean Coffee",
      "url": "https://purplebean.coffee/",
      "publisher": {
        "@@type": "Organization",
        "name": "Purple Bean Coffee",
        "logo": {
          "@@type": "ImageObject",
          "url": "https://purplebean.coffee/images/og-logo-square.png",
          "width": 1200,
          "height": 1200
        }
      }
    }
    </script>
    
    <!-- Early theme init: prevent FOUC by setting dark class before render -->
    <script>
        (function() {
            var saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
            var brandFont = localStorage.getItem('brandFont');
            var brandOk = { 'varela-round': 1, 'instrument-serif': 1, 'syne': 1, 'fraunces': 1 };
            if (!brandFont || !brandOk[brandFont]) brandFont = 'varela-round';
            document.documentElement.setAttribute('data-brand-font', brandFont);
        })();
    </script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'v-white': 'var(--color-v-white)',
                        'v-black': 'var(--color-v-black)',
                        'v-gray': 'var(--color-v-gray)',
                        'v-light-gray': 'var(--color-v-light-gray)',
                        'night': '#121014',
                        'night-2': '#1C191F',
                        'cream': '#D6D0C8',
                        'mist': '#8B8490',
                        'sun': '#B9A3C9',
                        'ember': '#8B6FA0',
                        'v-yellow': '#FACC15', // Accent
                        'v-blue': '#2563EB',   // Accent
                        'v-green': '#16A34A',  // Accent
                        'v-red': '#DC2626',    // JMB Structural Red
                        'v-magenta': '#DB2777', // Accent
                        'ink-black': '#000000',
                        'paper-white': '#FFFFFF',
                        'brand-red': '#DC2626'
                    },
                    fontFamily: {
                        'sans': ['"Inter"', 'sans-serif'],
                        'mono': ['"JetBrains Mono"', 'monospace'],
                        'grotesk': ['"Inter"', 'sans-serif'],
                        'mono-jb': ['"JetBrains Mono"', 'monospace'],
                    },
                    letterSpacing: {
                        'tighter': '-0.04em',
                        'tight': '-0.02em',
                        'widest': '0.15em',
                    }
                }
            }
        }
    </script>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@200;300;400;600;700&family=Anton&display=swap" as="style">
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;600;700&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@200;300;400;600;700&family=Anton&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Ubuntu:400,700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Cropper.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --color-v-white: #FFFFFF;
            --color-v-black: #000000;
            --color-v-gray: #737373;
            --color-v-light-gray: #E5E5E5;
        }

        html.dark {
            --color-v-white: #121014;
            --color-v-black: #D6D0C8;
            --color-v-gray: #8B8490;
            --color-v-light-gray: #2A262C;
            --night: #121014;
            --night-2: #1C191F;
            --cream: #D6D0C8;
            --mist: #8B8490;
            --sun: #B9A3C9;
            --ember: #8B6FA0;
            --line: rgba(214, 208, 200, 0.12);
        }
        
        body {
            background-color: #FFFFFF;
            color: #000000;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        html.dark body {
            background-color: var(--night);
            color: var(--cream);
        }
        html.dark ::selection {
            background: var(--ember);
            color: var(--night);
        }
        
        .edit-mode-only { display: none !important; }
        body.edit-mode .edit-mode-only { display: block !important; }
        
        h1, h2, h3, h4, h5, h6 {
            overflow-wrap: normal;
            word-break: normal;
            font-family: 'JetBrains Mono', monospace;
        }
        p {
            font-family: 'Inter', sans-serif;
        }
        .font-grotesk { font-family: 'Inter', sans-serif; }
        .font-outfit, p.font-outfit { font-family: 'Outfit', sans-serif; }
        .font-mono-jb, .font-mono, .font-mono-tech { font-family: 'JetBrains Mono', monospace; }
        .font-marker { font-family: 'Inter', sans-serif; }
        
        .rule-thin {
            border-bottom: 1px solid #E5E5E5;
        }
        html.dark .rule-thin {
            border-bottom-color: var(--line);
        }

        header .brand-lockup,
        #mobile-nav-menu .brand-lockup,
        footer .brand-lockup {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            line-height: 0;
        }
        header img.brand-logo,
        #mobile-nav-menu img.brand-logo,
        footer img.brand-logo {
            height: 1.85rem;
            width: auto;
            max-height: 1.85rem;
            object-fit: contain;
            flex-shrink: 0;
            padding: 0 2px;
        }
        header .brand-wordmark,
        #mobile-nav-menu .brand-wordmark,
        footer .brand-wordmark {
            font-family: 'Ubuntu', sans-serif;
            font-weight: 700;
            font-size: 1.33rem;
            line-height: 1;
            letter-spacing: -0.01em;
            text-transform: lowercase;
            color: #3c1950;
        }
        html.dark header .brand-wordmark,
        html.dark footer .brand-wordmark,
        #mobile-nav-menu .brand-wordmark {
            color: #DED6C8;
        }
        header img.brand-logo.brand-logo--ink { display: block; }
        header img.brand-logo.brand-logo--cream { display: none; }
        html.dark header img.brand-logo.brand-logo--ink { display: none; }
        html.dark header img.brand-logo.brand-logo--cream { display: block; }
        footer img.brand-logo.brand-logo--ink { display: block; }
        footer img.brand-logo.brand-logo--cream { display: none; }
        html.dark footer img.brand-logo.brand-logo--ink { display: none; }
        html.dark footer img.brand-logo.brand-logo--cream { display: block; }
        #mobile-nav-menu img.brand-logo.brand-logo--ink { display: none !important; }
        #mobile-nav-menu img.brand-logo.brand-logo--cream { display: block !important; }
        .lab-recipe-card__name {
            font-family: 'Inter', sans-serif !important;
            font-weight: 700 !important;
            font-style: normal;
            letter-spacing: -0.01em;
            text-transform: lowercase !important;
            font-size: 16px !important;
            line-height: 1;
        }
        html[data-brand-font="instrument-serif"] .lab-recipe-card__name,
        html[data-brand-font="syne"] .lab-recipe-card__name,
        html[data-brand-font="fraunces"] .lab-recipe-card__name {
            font-family: 'Inter', sans-serif !important;
            font-weight: 700 !important;
            letter-spacing: -0.01em;
            font-size: 16px !important;
        }
        .brand-font-cycle {
            border: 0;
            background: transparent;
            cursor: pointer;
            padding: 0 0.15rem;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            letter-spacing: 0.02em;
            color: inherit;
            opacity: 0.4;
        }
        .brand-font-cycle:hover {
            opacity: 1;
        }

        /* Minimalist structural scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #E5E5E5; }
        ::-webkit-scrollbar-thumb:hover { background: #000000; }

        /* JMB Image Treatment: High contrast, stark grayscale on desktop, full color on mobile */
        .img-stark {
            transition: filter 0.5s ease;
        }

        body.is-scrolling .img-stark {
            filter: grayscale(100%) contrast(1.15) brightness(0.95) !important;
        }
        
        @@media (hover: hover) {
            .img-stark {
                filter: grayscale(100%) contrast(1.15) brightness(0.95);
            }
            .img-stark:hover, .group:hover .img-stark {
                filter: grayscale(0%) contrast(1.0) brightness(1.0);
            }
        }

        /* Delivery & WhatsApp Float Button */
        .delivery-float {
            position: fixed;
            height: 48px;
            padding: 0 20px;
            bottom: 24px;
            right: 24px;
            background-color: #d4ff00;
            color: #111111;
            /* border: 2px solid #FACC15; */
            border-radius: 0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            box-shadow: none;
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .delivery-float:hover {
            background-color: #111111;
            border-color: #111111;
            color: #FFFFFF;
            transform: none;
        }

        html.dark .delivery-float {
            background-color: #8B6FA0;
            color: #121014;
            border: 1px solid #8B6FA0;
        }
        html.dark .delivery-float:hover {
            background-color: #B9A3C9;
            color: #121014;
            border-color: #B9A3C9;
        }

        html.dark header.sticky,
        html.dark footer {
            background-color: var(--night) !important;
            color: var(--cream);
            border-color: var(--line);
        }

        html.dark h1, html.dark h2, html.dark h3, html.dark h4, html.dark h5, html.dark h6 {
            color: var(--cream);
        }

        html.dark a:hover {
            color: var(--sun);
        }

        html.dark .filter-btn {
            color: var(--mist);
        }
        html.dark .filter-btn.active {
            color: var(--cream);
            border-color: var(--ember);
        }
        html.dark .filter-btn:hover {
            color: var(--sun);
        }

        html.dark button,
        html.dark .btn,
        html.dark [class*="btn-lab"],
        html.dark a.inline-flex,
        html.dark a[class*="uppercase"][class*="font-bold"] {
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        html.dark .btn-lab,
        html.dark button.border-2,
        html.dark a.border-2 {
            border-color: var(--cream);
            color: var(--cream);
            background: transparent;
        }
        html.dark .btn-lab:hover,
        html.dark button.border-2:hover,
        html.dark a.border-2:hover {
            background: var(--ember);
            border-color: var(--ember);
            color: var(--night);
        }

        html.dark .bg-v-green,
        html.dark .bg-v-yellow,
        html.dark [class*="bg-v-green"] {
            background-color: var(--ember) !important;
            color: var(--night) !important;
        }
        html.dark .bg-v-green:hover,
        html.dark .hover\:bg-green-700:hover {
            background-color: var(--sun) !important;
            color: var(--night) !important;
        }

        html.dark .lab-title {
            color: var(--cream);
            border-bottom-color: var(--ember);
        }

        html.dark .lab-card {
            background-color: var(--night-2);
            color: var(--cream);
            border-left-color: var(--ember);
        }

        html.dark ::-webkit-scrollbar-thumb { background: var(--mist); }
        html.dark ::-webkit-scrollbar-thumb:hover { background: var(--sun); }

        html.dark input, html.dark textarea, html.dark select {
            background-color: var(--night-2);
            color: var(--cream);
            border-color: var(--line);
        }

        /* Nothing stays paper-white in dark mode */
        html.dark .bg-white,
        html.dark .bg-paper-white,
        html.dark .bg-gray-50,
        html.dark .bg-gray-100,
        html.dark .bg-slate-50,
        html.dark .bg-slate-100,
        html.dark .bg-off-white {
            background-color: var(--night-2) !important;
        }
        html.dark .bg-v-white {
            background-color: var(--night) !important;
        }
        html.dark .dark\:bg-white {
            background-color: var(--cream) !important;
        }
        html.dark .text-white {
            color: var(--cream) !important;
        }
        html.dark .dark\:text-black {
            color: var(--night) !important;
        }
        html.dark .border-white,
        html.dark .border-v-white {
            border-color: var(--cream) !important;
        }
        html.dark .hover\:bg-white:hover {
            background-color: var(--cream) !important;
            color: var(--night) !important;
        }
        html.dark .hover\:text-white:hover {
            color: var(--cream) !important;
        }
        html.dark [style*="background: white"],
        html.dark [style*="background:white"],
        html.dark [style*="background: #fff"],
        html.dark [style*="background: #ffffff"],
        html.dark [style*="background: #f3f4f6"] {
            background-color: var(--night-2) !important;
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen flex flex-col font-sans text-sm selection:bg-v-black selection:text-v-white relative bg-v-white dark:bg-night text-v-black dark:text-cream transition-colors duration-300">
    @{
        var cartCount = 0;
        try {
            cartCount = CartService.GetCartItemCount(Context.Session);
        } catch {}
    }

    <partial name="_Header" model="cartCount" />
    
    <main class="flex-1">
        @RenderBody()
    </main>
    
    <partial name="_Footer" />

    <!-- Unified Delivery & WhatsApp Float Button -->
    <a href="https://wa.me/51993779381" target="_blank" class="delivery-float" title="Delivery & WhatsApp Dispatch"
       onclick="if (typeof gtag === 'function') { gtag('event', 'whatsapp_click', { event_category: 'engagement', event_label: location.pathname, page_path: location.pathname, transport_type: 'beacon' }); gtag('event', 'generate_lead', { event_category: 'engagement', method: 'whatsapp', page_path: location.pathname, transport_type: 'beacon' }); }">
        <i class="bi bi-truck text-xl"></i>
        <span>//</span>
        <i class="bi bi-whatsapp text-xl"></i>
    </a>

    <script>
        // Theme Toggle Logic (init already done in <head> to prevent FOUC)
        function setTheme(isDark) {
            if (isDark) {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            }
        }

        let scrollTimeout;
        window.addEventListener('scroll', () => {
            document.body.classList.add('is-scrolling');
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                document.body.classList.remove('is-scrolling');
            }, 150);
        }, { passive: true });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Image Crop Modal (Hidden by default) -->
    <div id="crop-modal-overlay" class="fixed inset-0 bg-black/80 z-[99999] hidden flex items-center justify-center">
        <div class="bg-white dark:bg-night-2 rounded-none p-6 max-w-4xl w-full mx-4 flex flex-col max-h-[90vh] border border-transparent dark:border-[rgba(214, 208, 200, 0.12)]">
            <h3 class="text-xl font-bold mb-4 font-grotesk dark:text-cream">Crop Image</h3>
            <div class="flex-1 overflow-hidden min-h-[400px] bg-gray-100 dark:bg-night relative flex items-center justify-center">
                <img id="crop-image-target" src="" class="max-w-full max-h-full block">
            </div>
            <div class="mt-6 flex justify-end gap-4">
                <button id="crop-cancel-btn" class="px-6 py-2 border-2 border-v-black dark:border-cream rounded-none font-mono text-sm font-bold uppercase hover:bg-gray-100 dark:hover:bg-ember dark:hover:text-night dark:hover:border-ember transition-colors">Cancel</button>
                <button id="crop-save-btn" class="px-6 py-2 bg-v-green dark:bg-ember text-white dark:text-night rounded-none font-mono text-sm font-bold uppercase flex items-center gap-2 hover:bg-green-700 dark:hover:bg-sun transition-colors"><i class="bi bi-crop"></i> Crop & Upload</button>
            </div>
        </div>
    </div>

    <script>
        // Currency Geolocation Logic
        document.addEventListener('DOMContentLoaded', function() {
            function updatePrices() {
                const currency = localStorage.getItem('Currency') || 'USD';
                // Find all elements marked for dynamic price display
                document.querySelectorAll('.price-display').forEach(el => {
                    const priceUsd = el.getAttribute('data-price-usd');
                    const pricePen = el.getAttribute('data-price-pen');
                    const isFrom = el.hasAttribute('data-from');
                    
                    if (!priceUsd || !pricePen) return;

                    let prefix = isFrom ? 'From ' : '';
                    if (currency === 'PEN') {
                        el.textContent = `${prefix}S/${parseFloat(pricePen).toFixed(2)}`;
                    } else {
                        el.textContent = `${prefix}$${parseFloat(priceUsd).toFixed(2)}`;
                    }
                });
            }

            // Also attach it to window so we can trigger it from other pages (like Product page)
            window.updateCurrencyPrices = updatePrices;
            window.renderYapePrice = function (root, usd, pen) {
                if (!root) return;
                const yapeRate = 3.75;
                const cardRate = 4.10;
                const yape = Math.round((pen > 0 ? pen : usd * yapeRate));
                const cardPen = Math.round(usd * cardRate);
                const save = Math.max(0, cardPen - yape);
                const from = root.getAttribute('data-from') || '';
                const soles = root.querySelector('[data-yape-soles]');
                const cardUsd = root.querySelector('[data-card-usd]');
                const cardPenEl = root.querySelector('[data-card-pen]');
                const saveEl = root.querySelector('[data-yape-save]');
                if (soles) soles.textContent = from + 'S/ ' + yape;
                if (cardUsd) cardUsd.textContent = '$' + Number(usd).toFixed(2);
                if (cardPenEl) cardPenEl.textContent = '≈ S/ ' + cardPen;
                if (saveEl) saveEl.textContent = save > 0
                    ? 'Save S/ ' + save + ' paying with Yape — no card FX.'
                    : '';
            };

            const storedCurrency = localStorage.getItem('Currency');
            if (!storedCurrency) {
                // Fetch from free IP API
                fetch('https://ipapi.co/json/')
                    .then(response => response.json())
                    .then(data => {
                        if (data.country_code === 'PE') {
                            localStorage.setItem('Currency', 'PEN');
                        } else {
                            localStorage.setItem('Currency', 'USD');
                        }
                        updatePrices();
                    })
                    .catch(err => {
                        console.error('IP Geolocation failed', err);
                        localStorage.setItem('Currency', 'USD');
                        updatePrices();
                    });
            } else {
                updatePrices();
            }
        });
    </script>

    <!-- Cropper.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <button id="inline-edit-toggle" aria-label="Toggle Edit Mode" class="fixed top-0 right-0 z-[100000] bg-v-yellow text-v-black border-0 p-0 m-0 w-8 h-8 flex items-center justify-center cursor-pointer text-base" title="Toggle Edit Mode">
            <i class="bi bi-pencil-fill"></i>
        </button>
    }

    <!-- Inline Editor Logic -->
    <script src="~/js/inline-editor.js" asp-append-version="true"></script>
    @{
        var ga4Queued = TempData[TheBestBean.Services.Ga4Ecommerce.TempKey] as string;
        var ga4Page = ViewData[TheBestBean.Services.Ga4Ecommerce.ViewKey] as string;
    }
    @if (!string.IsNullOrEmpty(ga4Queued) || !string.IsNullOrEmpty(ga4Page))
    {
        <script>
            (function () {
                var queued = @Html.Raw(string.IsNullOrEmpty(ga4Queued) ? "[]" : ga4Queued);
                var pageEvents = @Html.Raw(string.IsNullOrEmpty(ga4Page) ? "[]" : ga4Page);
                var emit = window.pbEmitGaEvents || function (events) {
                    if (!events || typeof gtag !== 'function') return;
                    events.forEach(function (e) { gtag('event', e.event, e.params || {}); });
                };
                emit(pageEvents.concat(queued));
            })();
        </script>
    }
</body>
</html>
