@model TheBestBean.Models.CoffeeBean
@{
    var lots = ViewData["CoffeeLots"] as Dictionary<int, CoffeeLotStatus>;
    CoffeeLotStatus? lot = null;
    if (lots != null && lots.TryGetValue(Model.Id, out var found))
    {
        lot = found;
    }
    var greenKg = lot?.GreenKg ?? 0m;
    var roastKg = lot?.RoastedKg ?? 0m;
    var region = Model.CoffeeRegion?.Name;
    var farmer = string.IsNullOrWhiteSpace(Model.Producer) ? null : Model.Producer.Trim();
    var process = Model.ProcessingMethod;
    var hasOriginMeta = !string.IsNullOrWhiteSpace(region)
        || !string.IsNullOrWhiteSpace(farmer)
        || !string.IsNullOrWhiteSpace(process);
}

<article class="coffee-product-card product-card-container group cursor-pointer flex flex-col bg-white dark:bg-[#1C191F] border border-gray-200 dark:border-[#3A353C] transition-all h-full"
     data-origin="@(Model.OriginCountry?.Name ?? "Peru")"
     data-process="@Model.ProcessingMethod"
     data-type="@(Model.Name.Contains("Roast") || Model.Name.Contains("Roasted") ? "roasted" : "green")">

    <div class="coffee-card-head">
        <div class="coffee-card-identity">
            <div class="coffee-card-identity__top">
                <p class="coffee-card-kicker">Bean</p>
                <p class="coffee-card-sca">SCA @Model.ScaScore.ToString("0.##")</p>
            </div>
            <a asp-page="/Product" asp-route-id="@Model.Id" class="coffee-card-title-link text-decoration-none hover:opacity-75 transition-opacity block">
                <h3 class="coffee-card-title" data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="Name">
                    @CoffeeDisplayName.ForLab(Model.Name)
                </h3>
            </a>
            <p class="coffee-card-notes" data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="FlavorProfile">
                @Model.FlavorProfile
            </p>
        </div>
    </div>

    <a asp-page="/Product" asp-route-id="@Model.Id" class="coffee-card-media text-decoration-none" aria-label="@CoffeeDisplayName.ForLab(Model.Name)">
        <img
            src="@Model.ImageUrl"
            alt="Peruvian specialty coffee beans: @CoffeeDisplayName.ForLab(Model.Name)"
            loading="lazy"
            class="coffee-bean-photo coffee-card-media__img"
            data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="ImageUrl"
        />
    </a>

    <div class="coffee-card-metrics">
        <span class="coffee-card-stock-green">@CoffeeLotStatus.FormatKg(greenKg) green</span>
        <span class="coffee-card-stock-roast">@CoffeeLotStatus.FormatKg(roastKg) roasted</span>
        <div class="coffee-card-price">
            <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = Model.BasePriceUSD, Pen = Model.BasePricePEN, Compact = true, From = false }" />
        </div>
    </div>

    @if (hasOriginMeta)
    {
        <dl class="coffee-card-origin">
            @if (!string.IsNullOrWhiteSpace(region))
            {
                <div class="coffee-card-origin__row">
                    <dt>Region</dt>
                    <dd>@region</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(farmer))
            {
                <div class="coffee-card-origin__row">
                    <dt>Farmer</dt>
                    <dd>@farmer</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(process))
            {
                <div class="coffee-card-origin__row">
                    <dt>Process</dt>
                    <dd>@process</dd>
                </div>
            }
        </dl>
    }

    <div class="coffee-card-actions">
        <form method="post" asp-page="/Cart" asp-page-handler="AddToCart" class="coffee-card-actions__form">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="productName" value="@Model.Name" />
            <input type="hidden" name="productType" value="Bean" />
            <input type="hidden" name="price" value="@Model.BasePriceUSD" />
            <input type="hidden" name="weight" value="100g" />
            <input type="hidden" name="roastLevel" value="profile" />
            <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
            <input type="hidden" name="description" value="@Model.FlavorProfile" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn-lab coffee-card-actions__btn">
                Add to Cart
            </button>
        </form>
    </div>
</article>
