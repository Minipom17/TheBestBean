@model TheBestBean.Models.CoffeeBean

<article class="coffee-product-card product-card-container group cursor-pointer flex flex-col bg-white dark:bg-[#1C191F] border border-gray-200 dark:border-[#3A353C] transition-all h-full" 
     data-origin="@(Model.OriginCountry?.Name ?? "Peru")" 
     data-process="@Model.ProcessingMethod"
     data-type="@(Model.Name.Contains("Roast") || Model.Name.Contains("Roasted") ? "roasted" : "green")">
    
    <div class="aspect-square w-full overflow-hidden bg-transparent relative">
        <div class="coffee-card-meta">
            <div class="coffee-card-meta__tags">
            @if (!string.IsNullOrEmpty(Model.Altitude))
            {
                <span>@Model.Altitude</span>
            }
            @if (!string.IsNullOrEmpty(Model.ProcessingMethod))
            {
                <span class="coffee-card-meta__tag">
                    <partial name="_CoffeeGlyph" model='"process"' />
                    @Model.ProcessingMethod
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.Variety))
            {
                <span class="coffee-card-meta__tag">
                    <partial name="_CoffeeGlyph" model='"bean"' />
                    @Model.Variety
                </span>
            }
            @if (string.IsNullOrEmpty(Model.Altitude) && string.IsNullOrEmpty(Model.ProcessingMethod) && string.IsNullOrEmpty(Model.Variety))
            {
                <span>Coffee</span>
            }
            </div>
            <span class="coffee-card-meta__sca">SCA @Model.ScaScore.ToString("0.##")</span>
        </div>
        

        <a asp-page="/Product" asp-route-id="@Model.Id" class="block w-full h-full text-decoration-none">
            <img 
                src="@Model.ImageUrl" 
                alt="Peruvian specialty coffee beans: @Model.Name"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 mix-blend-multiply dark:mix-blend-normal"
                data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="ImageUrl"
            />
        </a>
    </div>
    
    <div class="flex flex-col flex-grow p-4 md:p-6 border-t border-gray-200 dark:border-[#3A353C]">
        <div class="flex flex-col gap-2">
            @{
                var title = CoffeeCardTitle.From(Model);
            }
            <a asp-page="/Product" asp-route-id="@Model.Id" class="text-decoration-none hover:opacity-75 transition-opacity block">
                <h3 class="coffee-card-title" data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="Name">
                    <span class="coffee-card-title__variety">@title.Variety</span>
                    @if (!string.IsNullOrWhiteSpace(title.Location))
                    {
                        <span class="coffee-card-title__place">
                            <partial name="_CoffeeGlyph" model='"location"' />
                            <span>[@title.Location]</span>
                        </span>
                    }
                </h3>
            </a>
            <div class="coffee-card-price-row">
                <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = Model.BasePriceUSD, Pen = Model.BasePricePEN, Compact = true, From = true }" />
                @if (!string.IsNullOrWhiteSpace(title.Farmer))
                {
                    <span class="coffee-card-farmer">
                        <partial name="_CoffeeGlyph" model='"farmer"' />
                        <span>@title.Farmer</span>
                    </span>
                }
            </div>
        </div>

        <p class="coffee-card-notes" data-entity-id="@Model.Id" data-entity-type="CoffeeBean" data-editable="FlavorProfile">
            @Model.FlavorProfile
        </p>
        @{
            var lots = ViewData["CoffeeLots"] as Dictionary<int, CoffeeLotStatus>;
            CoffeeLotStatus? lot = null;
            if (lots != null && lots.TryGetValue(Model.Id, out var found))
            {
                lot = found;
            }
        }
        <div class="coffee-card-stock mt-auto">
            @if (lot != null && (lot.HasGreen || lot.RoastedKg >= 0.05m))
            {
                <button type="button" class="lot-sheet-open coffee-card-stock__green" style="color:#16A34A" data-lot="@lot.SheetJson()" data-lot-focus="green">@CoffeeLotStatus.FormatKg(lot.GreenKg) green</button>
                <button type="button" class="lot-sheet-open coffee-card-stock__roast" style="color:#8B5A2B" data-lot="@lot.SheetJson()" data-lot-focus="roast">@CoffeeLotStatus.FormatKg(lot.RoastedKg) roasted</button>
            }
        </div>

        <!-- Quick Add Form -->
        <form method="post" asp-page="/Cart" asp-page-handler="AddToCart" class="w-full">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="productName" value="@Model.Name" />
            <input type="hidden" name="productType" value="Bean" />
            <input type="hidden" name="price" value="@Model.BasePriceUSD" />
            <input type="hidden" name="weight" value="100g" />
            <input type="hidden" name="roastLevel" value="profile" />
            <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
            <input type="hidden" name="description" value="@Model.FlavorProfile" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn-lab w-full py-3 block text-center">
                Add to Cart
            </button>
        </form>
    </div>
</article>
