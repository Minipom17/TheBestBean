@model SyllabusItem

<div class="syllabus-row min-w-0">
@if (!string.IsNullOrWhiteSpace(Model.DetailBody))
{
    <details class="tour-syllabus-details w-full min-w-0 group">
        <summary class="tour-syllabus-details__summary !block">
            <div class="flex flex-col w-full min-w-0">
                <div class="syllabus-meta-line">
                    <div class="syllabus-heading-line">
                        <span class="tour-syllabus-label">@Model.Label:</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Time))
                        {
                            <span class="syllabus-module-title__time">@Model.Time</span>
                        }
                    </div>
                    <span class="syllabus-details-cta">
                        <span class="syllabus-details-cta__label">details</span>
                        <span class="tour-syllabus-details__chevron" aria-hidden="true"></span>
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Title))
                {
                    <div class="syllabus-summary-line">
                        <span class="syllabus-module-title">
                            <span class="syllabus-module-title__name">@Model.Title</span>
                        </span>
                    </div>
                }
            </div>
        </summary>
        <div class="tour-syllabus-details__body text-sm text-v-gray leading-relaxed font-normal pt-2">
            @Html.Raw(Model.DetailBody)
        </div>
    </details>
}
else
{
    <div class="flex flex-col w-full min-w-0 pt-1">
        <div class="syllabus-meta-line">
            <div class="syllabus-heading-line">
                <span class="tour-syllabus-label">@Model.Label:</span>
                @if (!string.IsNullOrWhiteSpace(Model.Time))
                {
                    <span class="syllabus-module-title__time">@Model.Time</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <div class="syllabus-summary-line">
                <span class="syllabus-module-title">
                    <span class="syllabus-module-title__name">@Model.Title</span>
                </span>
            </div>
        }
    </div>
}
@if (Model.Tags.Count > 0)
{
    <ul class="syllabus-tags mt-2">
        @foreach (var tag in Model.Tags)
        {
            <li class="syllabus-tag">@tag</li>
        }
    </ul>
}
</div>
