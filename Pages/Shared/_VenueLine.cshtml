@model TheBestBean.Models.Experience
@{
    var venue = ExperienceVenue.Resolve(Model);
}
@if (venue != null)
{
    <span>
        <span>@ExperienceVenue.InlineLabel(venue)</span>
        @if (!string.IsNullOrWhiteSpace(venue.WalkNote))
        {
            <span class="text-[10px] font-normal normal-case tracking-normal text-v-gray ml-1">@venue.WalkNote</span>
        }
    </span>
}
else
{
    @Model.Location
}
