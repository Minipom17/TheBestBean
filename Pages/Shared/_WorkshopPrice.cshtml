@model DualPriceModel
@{
    var soles = LocalPricing.YapeSoles(Model.Usd, Model.Pen);
    var usdText = Model.Usd == decimal.Truncate(Model.Usd)
        ? Model.Usd.ToString("0")
        : Model.Usd.ToString("0.##");
    var sizeClass = Model.Compact ? "price-pair--compact" : "price-pair--tour";
}
<span class="price-pair @sizeClass">
    <span class="price-pair__main">$@usdText<span class="price-pair__usd">USD</span></span>
    <span class="price-pair__soles">S/@soles.ToString("0")</span>
</span>
