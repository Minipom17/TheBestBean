                            <line x1="138" y1="281" x2="-8" y2="290"/>
                            <line x1="173" y1="232" x2="690" y2="175"/>
                            <line x1="239" y1="313" x2="690" y2="310"/>
                            <line x1="310" y1="488" x2="-8" y2="490"/>
                            <line x1="434" y1="554" x2="690" y2="520"/>
                            <line x1="612" y1="601" x2="690" y2="680"/>
                        </g>
