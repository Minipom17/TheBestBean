    <main class="talk-stage" id="talk-stage" tabindex="0">
        <section class="talk-slide talk-origin" data-on>
            <div class="talk-origin__grid">
                <div class="talk-origin__copy">
                    <p class="talk-kicker">01 <span>//</span> Origin talk · ~10 min</p>
                    <h1 class="talk-origin__peru">Peru</h1>
                    <h2 class="talk-origin__coffees">Coffees</h2>
                    <p class="talk-lede">A topographic reading of the belt, the highlands, and the varieties that actually show up in the cup — with honest caveats.</p>
                    <p class="talk-origin__mark"><b>Purple Bean</b> Cusco · La Convención</p>
                </div>
                <div class="talk-zones__fig">
                    <img class="talk-relief" src="~/brand/peru-zones-relief.png" asp-append-version="true" alt="Relief of Peru with the coffee zones marked." />
                    <svg class="talk-zones__pins" viewBox="-150 0 980 820" preserveAspectRatio="none" aria-hidden="true">
                        <g fill="none" stroke="#1A1917" stroke-width="0.8" opacity="0.7">
