@page "/Tour/{id}"
@model TheBestBean.Pages.TourModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{(Model.Tour?.Title ?? "Experience Dossier")}";
}

@foreach (var block in Model.JsonLdBlocks)
{
    <script type="application/ld+json">
        @Html.Raw(block)
    </script>
}

@if (Model.Tour != null)
{
    <!-- Huge Hero Image — full-bleed on mobile, rounded inset on desktop; swipeable gallery -->
    <div class="tour-media-bleed max-w-[1600px] mx-auto w-full mt-0 md:mt-6 no-print">
        @{
            var heroImage = Model.PageContent.GetValueOrDefault($"Tour_Hero_Image_{Model.Tour.Id}", Model.Tour.ImageUrl);
            var heroPos = Model.PageContent.GetValueOrDefault($"Tour_Hero_Pos_{Model.Tour.Id}", "50% 50%");
            var heroPhotos = new List<string>();
            if (!string.IsNullOrWhiteSpace(heroImage))
            {
                heroPhotos.Add(heroImage);
            }
            if (Model.Tour.GalleryImages != null)
            {
                foreach (var galleryImage in Model.Tour.GalleryImages)
                {
                    if (string.IsNullOrWhiteSpace(galleryImage)) continue;
                    if (heroPhotos.Any(existing => string.Equals(existing, galleryImage, StringComparison.OrdinalIgnoreCase))) continue;
                    heroPhotos.Add(galleryImage);
                }
            }
            var carouselId = $"tour-{Model.Tour.Id}";
            var heroPosParts = heroPos.Split(' ');
            var cssPos = heroPosParts.Length >= 2 ? $"{heroPosParts[0]} {heroPosParts[1]}" : "50% 50%";
            var cssScale = heroPosParts.Length >= 3 ? heroPosParts[2] : "1.0";
        }
        <div class="exp-carousel tour-media-frame w-full aspect-[15/11] md:aspect-[16/9] bg-gray-100 dark:bg-[#1C191F] overflow-hidden relative shadow-sm" data-carousel-id="@carouselId">
            @if (heroPhotos.Any())
            {
                <div class="carousel-container absolute inset-0 w-full h-full flex transition-transform duration-500 ease-in-out" id="carousel-@carouselId" data-current="0">
                    @for (int i = 0; i < heroPhotos.Count; i++)
                    {
                        var img = heroPhotos[i];
                        <div class="exp-carousel__slide">
                            @if (i == 0)
                            {
                                <img src="@img" alt="@Model.Tour.Title" class="img-stark transition-transform" style="object-position: @cssPos; transform: scale(@cssScale);" draggable="false" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="ImageUrl" data-position-key="Tour_Hero_Pos_@Model.Tour.Id" data-saved-pos="@heroPos" />
                            }
                            else
                            {
                                <img src="@img" alt="@Model.Tour.Title" class="img-stark" draggable="false" loading="lazy" decoding="async" />
                            }
                        </div>
                    }
                </div>
                @if (heroPhotos.Count > 1)
                {
                    <button type="button" aria-label="Previous Image" onclick="moveCarousel('@carouselId', -1, event)" class="exp-carousel__btn absolute left-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                        <i class="bi bi-chevron-left text-xl"></i>
                    </button>
                    <button type="button" aria-label="Next Image" onclick="moveCarousel('@carouselId', 1, event)" class="exp-carousel__btn absolute right-4 top-1/2 -translate-y-1/2 bg-black/40 text-white w-10 h-10 rounded-full hover:bg-black/70 transition flex items-center justify-center z-10 border-0 cursor-pointer">
                        <i class="bi bi-chevron-right text-xl"></i>
                    </button>
                }
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center font-mono-jb text-[10px] font-bold uppercase tracking-widest text-v-gray">Photos soon</div>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow max-w-[1600px] mx-auto w-full px-6 md:px-12 relative pb-32 font-sans text-v-black dark:text-[#D6D0C8] bg-v-white dark:bg-[#121014] mt-12 md:mt-24">
        
        <main class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 relative no-print">
            
            <!-- Reservation stays first on phones so guests can actually book -->
            <div class="lg:col-span-4 flex flex-col relative">
                <div class="tour-reserve lg:sticky lg:top-32 bg-white dark:bg-[#121014] rounded-3xl border border-[#ece7df] p-6 md:p-8 shadow-[0_12px_40px_rgba(18,16,20,0.06)]">
                    <div class="mb-2">
                        <p class="text-[10px] font-mono-jb font-bold uppercase tracking-widest text-[#722EA8] m-0 mb-2">Reserve a seat</p>
                        <div class="flex flex-col items-start gap-1">
                            <partial name="_WorkshopPrice" model="new DualPriceModel { Usd = Model.Tour.Price }" />
                            <span class="text-[10px] font-mono font-bold tracking-widest text-[#FF3B1F] uppercase mt-1">@LocalPricing.WorkshopVisaFeeNote</span>
                        </div>
                        <p class="text-xs text-v-gray mt-2 m-0">per participant · Cusco time</p>
                    </div>
                    
                    <div class="flex flex-col gap-3 mt-6 pt-6 border-t border-gray-100">
                        <div class="flex justify-between items-start text-xs gap-4">
                            <span class="text-v-gray font-normal shrink-0">Duration</span>
                            <span class="text-v-black dark:text-[#D6D0C8] font-semibold text-right">@Model.Tour.Duration</span>
                        </div>
                        <div class="flex justify-between items-start text-xs gap-4">
                            <span class="text-v-gray font-normal shrink-0">Location</span>
                            <span class="text-v-black dark:text-[#D6D0C8] font-semibold text-right max-w-[14rem]" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="Location">
                                @if (Model.Venue != null)
                                {
                                    <span class="block">@ExperienceVenue.InlineLabel(Model.Venue)</span>
                                    @if (!string.IsNullOrWhiteSpace(Model.Venue.WalkNote))
                                    {
                                        <span class="block text-[10px] font-normal text-v-gray mt-0.5">@Model.Venue.WalkNote</span>
                                    }
                                }
                                else
                                {
                                    @Model.Tour.Location
                                }
                            </span>
                        </div>
                        <div class="flex justify-between items-start text-xs gap-4">
                            <span class="text-v-gray font-normal shrink-0">Level</span>
                            <span class="text-v-black dark:text-[#D6D0C8] font-semibold text-right" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="Difficulty">@Model.Tour.Difficulty</span>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="AddToCart" class="mt-6 pt-6 border-t border-gray-100" id="booking-form">
                        <input type="hidden" name="tourId" value="@Model.Tour.Id" />
                        <input type="hidden" name="title" value="@Model.Tour.Title" />
                        <input type="hidden" name="price" value="@Model.Tour.Price" />
                        <input type="hidden" name="imageUrl" value="@heroImage" />
                        <input type="hidden" name="slotId" id="slotId" value="" />

                        <div class="booking-cal" data-slots='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpenSlots.Select(s => new {
                            id = s.Id,
                            day = BookingCalendarService.FormatDay(s.StartAt),
                            time = BookingCalendarService.ToLima(s.StartAt).ToString("HH:mm"),
                            remaining = s.Remaining,
                            label = BookingCalendarService.FormatSlot(s.StartAt)
                        })))'>
                            <div class="flex items-center justify-between mb-3">
                                <p class="text-[10px] font-mono-jb font-bold uppercase tracking-widest m-0">Pick a date</p>
                                <div class="flex gap-2">
                                    <button type="button" class="booking-cal__nav" data-cal-nav="-1" aria-label="Previous month">‹</button>
                                    <button type="button" class="booking-cal__nav" data-cal-nav="1" aria-label="Next month">›</button>
                                </div>
                            </div>
                            <p class="booking-cal__month font-mono-jb text-[11px] uppercase tracking-widest text-v-gray mb-3" data-cal-month></p>
                            <div class="booking-cal__weekdays" aria-hidden="true">
                                <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
                            </div>
                            <div class="booking-cal__grid" data-cal-grid></div>
                            <p class="booking-cal__hint">Purple days are open · 12-hour cutoff · Sundays closed</p>
                            <p class="booking-cal__picked" data-cal-picked></p>
                            <div class="booking-cal__times mt-3" data-cal-times>
                                <p class="text-[10px] text-v-gray m-0">Pick a highlighted day, then a time.</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.BookingError))
                        {
                            <p class="text-sm text-red-600 mt-3 mb-0">@Model.BookingError</p>
                        }

                        <label class="block text-[10px] font-mono-jb font-bold uppercase tracking-widest mt-5 mb-2">Guests</label>
                        <select name="participants" id="participants" class="w-full border border-gray-200 rounded-lg p-3 bg-white text-sm" data-max="@CartService.MaxExperienceGuests">
                            @for (var n = 1; n <= CartService.MaxExperienceGuests; n++)
                            {
                                <option value="@n">@n @(n == 1 ? "guest" : "guests")</option>
                            }
                        </select>
                        <p class="text-[10px] text-v-gray mt-2 mb-0">Maximum @CartService.MaxExperienceGuests guests per session.</p>

                        <button type="submit" id="reserve-btn" disabled class="w-full bg-v-black text-v-white rounded-full py-4 font-bold tracking-tight text-lg hover:bg-v-red transition-colors border-0 cursor-pointer mt-5 mb-16 lg:mb-0 disabled:opacity-40 disabled:cursor-not-allowed relative z-[1]" data-entity-id="Tour_ReserveButton" data-entity-type="SiteContent" data-editable="Value">
                            Choose a date to reserve
                        </button>
                        <p class="text-[10px] text-v-gray text-center mt-4 mb-0">Need a private time? <a href="https://wa.me/51993779381" class="text-[#722EA8]">WhatsApp +51 993 779 381</a></p>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-8 flex flex-col gap-16 pt-4">
                
                <!-- Title Block -->
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-v-gray font-mono-jb block mb-2">@Model.Tour.Category &bull; @Model.Tour.Duration</span>
                    @if (Model.Venue != null)
                    {
                        <p class="text-sm font-mono-jb text-v-black dark:text-[#D6D0C8] mb-4 m-0">
                            @ExperienceVenue.InlineLabel(Model.Venue)
                            @if (!string.IsNullOrWhiteSpace(Model.Venue.WalkNote))
                            {
                                <span class="text-[10px] font-normal text-v-gray ml-1">@Model.Venue.WalkNote</span>
                            }
                        </p>
                    }
                    <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-v-black dark:text-[#D6D0C8] leading-[0.9] m-0" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="Title">
                        @Model.Tour.Title
                    </h1>
                </div>

                <!-- Overview -->
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-v-black dark:text-[#D6D0C8] leading-none mb-6">
                        Overview
                    </h2>
                    <p class="text-v-gray text-lg md:text-xl leading-relaxed font-normal max-w-3xl" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="LongDescription">
                        @Model.Tour.LongDescription
                    </p>
                    @if (Model.WorkshopMaterials.Count > 0)
                    {
                        <details class="tour-materials">
                            <summary class="tour-syllabus-details__summary">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-v-gray font-mono-jb">Materials</span>
                                <span class="exp-filter-label m-0" style="width: auto; flex: none;">included</span>
                                <span class="tour-syllabus-details__chevron" aria-hidden="true"></span>
                            </summary>
                            <div class="tour-materials__body">
                                <p class="tour-materials__note">We set the table. You don't bring anything.</p>
                                <ul class="tour-materials__list">
                                    @foreach (var item in Model.WorkshopMaterials)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        </details>
                    }
                </div>

                <!-- What You Get Box -->
                @if (Model.Tour.ProvidedEquipment != null && Model.Tour.ProvidedEquipment.Any())
                {
                    <div class="tour-whatyouget-map mb-8 w-full max-w-5xl font-sans">
                    <div class="tour-whatyouget-map__box relative mt-2 flex-1 min-w-0">
                        <!-- Top Tag -->
                        <div class="absolute -top-3 left-6 bg-[#722EA8] text-white text-xs font-semibold px-2 py-0.5 z-10">
                            what you get
                        </div>
                        
                        <!-- Main Box -->
                        <div class="border border-[#722EA8] relative p-8 pt-10 h-full">
                            <!-- Corner Nodes -->
                            <div class="absolute -top-1 -left-1 w-2 h-2 bg-[#722EA8]"></div>
                            <div class="absolute -top-1 -right-1 w-2 h-2 bg-[#722EA8]"></div>
                            <div class="absolute -bottom-1 -left-1 w-2 h-2 bg-[#722EA8]"></div>
                            <div class="absolute -bottom-1 -right-1 w-2 h-2 bg-[#722EA8]"></div>
                            
                            <!-- List -->
                            <ul class="list-none p-0 m-0 space-y-4 font-mono-jb text-sm text-v-gray">
                                @for (int i = 0; i < Model.Tour.ProvidedEquipment.Count; i++)
                                {
                                    <li class="flex items-start gap-3">
                                        <span class="text-v-black dark:text-[#D6D0C8] font-bold mt-0.5">@(i + 1).</span>
                                        <span class="leading-relaxed">@Model.Tour.ProvidedEquipment[i]</span>
                                    </li>
                                }
                            </ul>

                            <!-- Take Home Section -->
                            @if (!string.Equals(Model.Tour.Category, "Expedition", StringComparison.OrdinalIgnoreCase))
                            {
                            <div class="mt-8 pt-6 border-t border-[#722EA8]/30" data-takehome="by-host">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-[#722EA8] block mb-4">TAKE HOME</span>
                                <ul class="list-none p-0 m-0 space-y-3 font-mono-jb text-sm text-v-black dark:text-[#D6D0C8]">
                                    @if (Model.TakesCoffeeHome)
                                    {
                                        <li class="flex items-start gap-3">
                                            <span class="text-[#722EA8] shrink-0">+</span>
                                            <span class="leading-relaxed">200g coffee</span>
                                        </li>
                                    }
                                    <li class="flex items-start gap-3">
                                        <span class="text-[#722EA8] shrink-0">+</span>
                                        <span class="leading-relaxed">SCA flavor wheel</span>
                                    </li>
                                    @if (Model.TakesCynthiaPavelKit || Model.IsCoffeeLab)
                                    {
                                        <li class="flex items-start gap-3">
                                            <span class="text-[#722EA8] shrink-0">+</span>
                                            <span class="leading-relaxed">Recipe cards</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            }
                        </div>
                    </div>
                    @if (Model.Venue != null)
                    {
                        <div class="tour-venue-map">
                            <div class="tour-venue-map__frame border border-gray-200 dark:border-[#2A262C] rounded-2xl overflow-hidden bg-gray-100 dark:bg-[#1C191F]">
                                <div class="tour-venue-map__chrome">
                                    <span class="tour-venue-map__label">Meeting point</span>
                                    <a class="tour-venue-map__open" href="@ExperienceVenue.MapOpenUrl(Model.Venue)" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
                                </div>
                                <iframe
                                    title="Map — @ExperienceVenue.InlineLabel(Model.Venue)"
                                    class="w-full h-full border-0"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    src="@ExperienceVenue.MapEmbedUrl(Model.Venue)"
                                    allowfullscreen>
                                </iframe>
                            </div>
                            <div class="tour-venue-map__caption">
                                <p>
                                    @ExperienceVenue.InlineLabel(Model.Venue)
                                    @if (!string.IsNullOrWhiteSpace(Model.Venue.WalkNote))
                                    {
                                        <span> · @Model.Venue.WalkNote</span>
                                    }
                                </p>
                            </div>
                        </div>
                    }
                    </div>
                }

                <!-- Syllabus & Timeline -->
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-v-black dark:text-[#D6D0C8] mb-8">Syllabus & Timeline</h2>
                    
                    <div class="flex flex-col relative pl-2">
                        <div class="absolute left-[11px] top-2 bottom-2 w-px bg-gray-200 dark:bg-[#2A262C]"></div>
                        @for (int i = 0; i < Model.Tour.Syllabus.Count; i++)
                        {
                            var syllabusRow = SyllabusParser.Parse(Model.Tour.Syllabus[i], i);

                            <div class="relative pl-8 pb-10 last:pb-0">
                                <div class="absolute -left-0.5 top-1.5 w-2.5 h-2.5 bg-v-black dark:bg-[#D6D0C8] rounded-full shadow-[0_0_0_4px_white] dark:shadow-[0_0_0_4px_#121014]"></div>
                                <partial name="_SyllabusRow" model="syllabusRow" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Equipment & Gear -->
                @if (Model.Tour.RequiredGear != null && Model.Tour.RequiredGear.Any())
                {
                    <div class="grid grid-cols-1 gap-12 mt-12 pt-12 border-t border-v-black/10 dark:border-[#2A262C]">
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-widest text-v-black dark:text-[#D6D0C8] font-mono-jb block mb-6">MANDATORY PROTOCOL</span>
                            <ul class="list-none p-0 m-0 space-y-4 font-mono-jb text-xs text-v-gray">
                                @foreach (var item in Model.Tour.RequiredGear)
                                {
                                    <li class="flex items-start gap-3">
                                        <span class="text-v-black dark:text-[#D6D0C8] shrink-0">+</span>
                                        <span class="leading-relaxed">@item</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </main>

        <!-- Picture Deck -->
        @if (Model.Tour.GalleryImages != null && Model.Tour.GalleryImages.Any())
        {
            <div class="mt-24 mb-12 no-print">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-3xl font-bold tracking-tight text-v-black dark:text-[#D6D0C8] m-0">ARCHIVE DOSSIER</h2>
                    <div class="h-px bg-gray-200 flex-grow"></div>
                </div>
                
                <div class="tour-gallery-bleed flex overflow-x-auto gap-0 md:gap-6 pb-8 snap-x scrollbar-hide" style="scrollbar-width: none;">
                    @for (int i = 0; i < Model.Tour.GalleryImages.Count; i++)
                    {
                        var img = Model.Tour.GalleryImages[i];
                        <div class="tour-media-frame snap-center shrink-0 w-[100vw] md:w-[600px] aspect-[15/11] overflow-hidden relative shadow-sm">
                            <img src="@img" class="img-stark" alt="@Model.Tour.Title photo" loading="lazy" decoding="async" data-entity-id="@Model.Tour.Id" data-entity-type="Experience" data-editable="GalleryImage_@i" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.IsCoffeeLab)
        {
            <partial name="_LabRecipeCards" />
        }

    </div>
}
else
{
    <div class="flex-grow max-w-[1600px] mx-auto w-full px-6 md:px-12 relative pb-32 font-sans text-v-black dark:text-[#D6D0C8] bg-v-white dark:bg-[#121014]">
        <div class="text-left py-32 border-b border-v-black/10 dark:border-[#2A262C] font-sans mt-24">
            <h1 class="text-6xl md:text-8xl font-bold mb-8 tracking-tighter uppercase text-v-black dark:text-[#D6D0C8]">DOSSIER NOT FOUND</h1>
            <p class="text-lg text-v-gray mb-16">The requested protocol does not exist in the current archive.</p>
            <a asp-page="/Experiences" class="group flex items-center gap-4 cursor-pointer border-none bg-transparent p-0 m-0 text-decoration-none">
                <span class="w-12 h-12 bg-v-black rounded-full flex items-center justify-center text-v-white group-hover:bg-v-red transition-colors duration-300">
                    <i class="bi bi-arrow-left text-xl"></i>
                </span>
                <span class="text-xl md:text-2xl font-bold tracking-tight text-v-black dark:text-[#D6D0C8] group-hover:text-v-red transition-colors duration-300">
                    RETURN TO ARCHIVE
                </span>
            </a>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/exp-carousel.js" asp-append-version="true"></script>
    <script src="~/js/booking-calendar.js" asp-append-version="true"></script>
    @if (Model.Tour != null)
    {
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "TouristTrip",
          "name": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Tour.Title))",
          "description": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Tour.Description))",
          "image": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Tour.ImageUrl))",
          "offers": {
            "@@type": "Offer",
            "price": "@Model.Tour.Price",
            "priceCurrency": "USD"
          }
        }
        </script>
    }
}
