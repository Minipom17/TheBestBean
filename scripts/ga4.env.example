# Copy to scripts/ga4.env (gitignored) or set these in your shell / Cursor secrets.
# Property ID is the NUMBER in GA4 Admin → Property settings.
# It is NOT the web tag G-TR8742RMGE.

GA4_PROPERTY_ID=000000000

# Option A — path to a downloaded service-account JSON key:
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json

# Option B — Cursor secret with the full JSON body (preferred for cloud agents):
# GA4_SERVICE_ACCOUNT_JSON={...}
